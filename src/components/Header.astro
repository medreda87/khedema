---
import { t, type Lang, DIRS } from "../lib/i18n";
import { icons } from "../lib/icons";

interface Props {
  lang?: Lang;
  currentPath?: string;
  logoText?: string;
  phone?: string;
}

const {
  lang = "fr",
  currentPath = "/",
  phone = "+2127168854",
} = Astro.props;

const dir = DIRS[lang];
const basePath = `/${lang}`;

/* ============================================================
   NAVIGATION
   ============================================================ */

const navItems = [
  {
    key: "Acceuil",
    href: `/`,
    hasDropdown: false,
  },
  {
    key: "nav.how",
    href: `/comment-ca-marche`,
    hasDropdown: false,
  },
  {
    key: "nav.services",
    href: `/#services`,
    hasDropdown: true,
  },
  {
    key: "A propos",
    href: `/propos`,
    hasDropdown: false,
  },
  {
    key: "Contact",
    href: `/contact`,
    hasDropdown: false,
  },
];

/* ============================================================
   SERVICES
   ============================================================ */

const services = [
  {
    href: `/plombier`,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l3.76 3.76z"/></svg>`,
    label: "Plomberie",
    desc: "Installation & réparation",
  },
  {
    href: `/electricien`,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
    label: "Électricité",
    desc: "Câblage & dépannage",
  },
  {
    href: `/climatisation`,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v6M12 18v4M4.93 4.93l4.24 4.24M14.83 14.83l4.24 4.24M2 12h6M16 12h6M4.93 19.07l4.24-4.24M14.83 9.17l4.24-4.24"/></svg>`,
    label: "Climatisation",
    desc: "Froid & chauffage",
  },
  {
    href: `/carellage`,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>`,
    label: "Carrelage",
    desc: "Sol & mural",
  },
  {
    href: `/peinture`,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.37 2.63 14 7l-1.59-1.59a2 2 0 0 0-2.82 0L8 7l9 9 1.59-1.59a2 2 0 0 0 0-2.82L17 10l4.37-4.37a2.12 2.12 0 1 0-3-3Z"/><path d="M9 8c-2 3-4 3.5-7 4l8 10c2-1 6-5 6-7"/><path d="M14.5 17.5 4.5 15"/></svg>`,
    label: "Peinture",
    desc: "Intérieur & extérieur",
  },
];
---

<header
  class="site-header"
  data-header
  dir={dir}
>
  <div class="header-inner container">

    <!-- ======================================================
         LOGO
    ======================================================= -->

    <a
      href={`/`}
      class="logo-link"
      aria-label="AlloMealem - Accueil"
    >
      <img
        src="/logo.avif"
        class="logo"
        alt="AlloMealem"
      />
    </a>

    <!-- ======================================================
         DESKTOP NAVIGATION
    ======================================================= -->

    <nav
      class="nav-desktop"
      aria-label="Navigation principale"
    >

      {
        navItems.map((item) => (
          <div
            class="nav-item-wrapper"
            data-nav-item={item.key}
          >

            {
              item.hasDropdown ? (
                <>
                  <!-- SERVICES DROPDOWN BUTTON -->

                  <button
                    class="nav-link nav-link-dropdown"
                    data-dropdown-toggle
                    aria-expanded="false"
                    aria-haspopup="true"
                    type="button"
                  >
                    <span>{t(lang, item.key)}</span>

                    <span
                      class="nav-arrow"
                      aria-hidden="true"
                    >
                      ▾
                    </span>
                  </button>

                  <!-- SERVICES DROPDOWN -->

                  <div
                    class="dropdown-container"
                    data-dropdown-container
                  >

                    <div class="dropdown-header-compact">
                      <span class="dropdown-title">
                        Nos services
                      </span>
                    </div>

                    <div class="dropdown-list-compact">

                      {
                        services.map((service) => (
                          <a
                            href={service.href}
                            class="dropdown-option-compact"
                            data-service
                          >
                            <span
                              class="dropdown-option-icon"
                              set:html={service.icon}
                            />

                            <div class="dropdown-option-content">
                              <span class="dropdown-option-label">
                                {service.label}
                              </span>

                              <span class="dropdown-option-desc">
                                {service.desc}
                              </span>
                            </div>

                            <span class="dropdown-option-arrow">
                              →
                            </span>
                          </a>
                        ))
                      }
                    </div>
                  </div>
                </>
              ) : (
                <a
                  href={item.href}
                  class="nav-link"
                >
                  {t(lang, item.key)}
                </a>
              )
            }

          </div>
        ))
      }

    </nav>

    <!-- ======================================================
         HEADER ACTIONS
    ======================================================= -->

    <div class="header-actions">

      <a
        href={`/contact`}
        class="btn btn-primary header-cta"
      >
        {t(lang, "cta.request")}
      </a>

<button
  class="menu-toggle"
  aria-label="Ouvrir le menu"
  aria-expanded="false"
  data-menu-toggle
  type="button"
>
  <span class="icon-menu" aria-hidden="true">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="4" y1="6" x2="20" y2="6"></line>
      <line x1="4" y1="12" x2="20" y2="12"></line>
      <line x1="4" y1="18" x2="20" y2="18"></line>
    </svg>
  </span>

  <span class="icon-close" aria-hidden="true">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </span>
</button>

    </div>

  </div>

  <!-- ========================================================
       DROPDOWN OVERLAY
  ========================================================= -->

  <div
    class="dropdown-overlay"
    data-dropdown-overlay
  />

  <!-- ========================================================
       MOBILE OVERLAY
  ========================================================= -->

  <div
    class="mobile-overlay"
    data-mobile-overlay
  />

  <!-- ========================================================
       MOBILE MENU
  ========================================================= -->

  <div
    class="mobile-menu"
    data-mobile-menu
  >

    <div class="mobile-menu-inner container">

      <nav
        class="mobile-nav"
        aria-label="Navigation mobile"
      >

        {
          navItems.map((item) => (
            <div class="mobile-nav-item">

              {
                item.hasDropdown ? (
                  <div
                    class="mobile-dropdown-wrapper"
                    data-mobile-dropdown
                  >

                    <!-- MOBILE SERVICES BUTTON -->

                    <button
                      class="mobile-nav-link mobile-nav-dropdown-trigger"
                      data-mobile-dropdown-toggle
                      type="button"
                      aria-expanded="false"
                    >
                      <span>
                        {t(lang, item.key)}
                      </span>

                      <span
                        class="mobile-nav-arrow"
                        aria-hidden="true"
                      >
                        ▾
                      </span>
                    </button>

                    <!-- MOBILE SERVICES DROPDOWN -->

                    <div
                      class="mobile-dropdown-content"
                      data-mobile-dropdown-content
                    >

                      <div class="mobile-dropdown-list">

                        {
                          services.map((service) => (
                            <a
                              href={service.href}
                              class="mobile-dropdown-item"
                            >
                              <span
                                class="mobile-dropdown-icon"
                                set:html={service.icon}
                              />

                              <span class="mobile-dropdown-label">
                                {service.label}
                              </span>

                              <span class="mobile-dropdown-arrow">
                                →
                              </span>
                            </a>
                          ))
                        }

                        <a
                          href={`/services`}
                          class="mobile-dropdown-view-all"
                        >
                          Voir tous les services
                          <span>→</span>
                        </a>

                      </div>

                    </div>

                  </div>
                ) : (
                  <a
                    href={item.href}
                    class="mobile-nav-link"
                  >
                    {t(lang, item.key)}
                  </a>
                )
              }

            </div>
          ))
        }

      </nav>

      <div class="mobile-divider" />

      <a
        href={`/#request`}
        class="btn btn-primary mobile-cta"
      >
        {t(lang, "cta.request")}
      </a>

    </div>

  </div>
</header>

<!-- ============================================================
     JAVASCRIPT
============================================================= -->

<script>
  (() => {
    const header =
      document.querySelector<HTMLElement>(
        "[data-header]"
      );

    const toggle =
      document.querySelector<HTMLElement>(
        "[data-menu-toggle]"
      );

    const mobileMenu =
      document.querySelector<HTMLElement>(
        "[data-mobile-menu]"
      );

    const mobileOverlay =
      document.querySelector<HTMLElement>(
        "[data-mobile-overlay]"
      );

    const dropdownToggle =
      document.querySelector<HTMLElement>(
        "[data-dropdown-toggle]"
      );

    const dropdownContainer =
      document.querySelector<HTMLElement>(
        "[data-dropdown-container]"
      );

    const dropdownOverlay =
      document.querySelector<HTMLElement>(
        "[data-dropdown-overlay]"
      );

    const mobileDropdownToggles =
      document.querySelectorAll<HTMLElement>(
        "[data-mobile-dropdown-toggle]"
      );

    /* ========================================================
       SCROLL
    ========================================================= */

    const onScroll = () => {
      if (!header) return;

      header.classList.toggle(
        "scrolled",
        window.scrollY > 20
      );
    };

    window.addEventListener(
      "scroll",
      onScroll,
      { passive: true }
    );

    onScroll();

    /* ========================================================
       MOBILE MENU
    ========================================================= */

    const openMenu = () => {
      toggle?.setAttribute(
        "aria-expanded",
        "true"
      );

      toggle?.classList.add("open");

      mobileMenu?.classList.add("open");

      mobileOverlay?.classList.add("open");

      document.body.style.overflow = "hidden";
    };

    const closeMenu = () => {
      toggle?.setAttribute(
        "aria-expanded",
        "false"
      );

      toggle?.classList.remove("open");

      mobileMenu?.classList.remove("open");

      mobileOverlay?.classList.remove("open");

      document.body.style.overflow = "";

      /* Fermer le dropdown mobile */
      mobileDropdownToggles.forEach((button) => {
        button.setAttribute(
          "aria-expanded",
          "false"
        );

        button.classList.remove("open");

        const wrapper =
          button.closest<HTMLElement>(
            "[data-mobile-dropdown]"
          );

        const content =
          wrapper?.querySelector<HTMLElement>(
            "[data-mobile-dropdown-content]"
          );

        content?.classList.remove("open");
      });
    };

    toggle?.addEventListener(
      "click",
      () => {
        const isOpen =
          toggle.getAttribute(
            "aria-expanded"
          ) === "true";

        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      }
    );

    mobileOverlay?.addEventListener(
      "click",
      closeMenu
    );

    /* ========================================================
       MOBILE LINKS
    ========================================================= */

    mobileMenu
      ?.querySelectorAll("a")
      .forEach((link) => {
        link.addEventListener(
          "click",
          closeMenu
        );
      });

    /* ========================================================
       DESKTOP SERVICES DROPDOWN
    ========================================================= */

    let dropdownOpen = false;

    const openDropdown = () => {
      dropdownOpen = true;

      dropdownToggle?.setAttribute(
        "aria-expanded",
        "true"
      );

      dropdownToggle?.classList.add(
        "open"
      );

      dropdownContainer?.classList.add(
        "open"
      );

      dropdownOverlay?.classList.add(
        "open"
      );
    };

    const closeDropdown = () => {
      dropdownOpen = false;

      dropdownToggle?.setAttribute(
        "aria-expanded",
        "false"
      );

      dropdownToggle?.classList.remove(
        "open"
      );

      dropdownContainer?.classList.remove(
        "open"
      );

      dropdownOverlay?.classList.remove(
        "open"
      );
    };

    dropdownToggle?.addEventListener(
      "click",
      (event) => {
        event.stopPropagation();

        if (dropdownOpen) {
          closeDropdown();
        } else {
          openDropdown();
        }
      }
    );

    dropdownOverlay?.addEventListener(
      "click",
      closeDropdown
    );

    document.addEventListener(
      "click",
      (event) => {
        if (!dropdownOpen) return;

        const target =
          event.target as HTMLElement;

        if (
          !target.closest(
            "[data-dropdown-toggle]"
          ) &&
          !target.closest(
            "[data-dropdown-container]"
          )
        ) {
          closeDropdown();
        }
      }
    );

    /* ========================================================
       ESCAPE
    ========================================================= */

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key !== "Escape") return;

        closeDropdown();
        closeMenu();
      }
    );

    /* ========================================================
       MOBILE SERVICES DROPDOWN
    ========================================================= */

    mobileDropdownToggles.forEach(
      (button) => {
        button.addEventListener(
          "click",
          (event) => {
            event.stopPropagation();

            const wrapper =
              button.closest<HTMLElement>(
                "[data-mobile-dropdown]"
              );

            if (!wrapper) return;

            const content =
              wrapper.querySelector<HTMLElement>(
                "[data-mobile-dropdown-content]"
              );

            if (!content) return;

            const isOpen =
              button.getAttribute(
                "aria-expanded"
              ) === "true";

            /* Fermer les autres dropdowns */
            mobileDropdownToggles.forEach(
              (otherButton) => {
                if (otherButton === button)
                  return;

                otherButton.setAttribute(
                  "aria-expanded",
                  "false"
                );

                otherButton.classList.remove(
                  "open"
                );

                const otherWrapper =
                  otherButton.closest<HTMLElement>(
                    "[data-mobile-dropdown]"
                  );

                const otherContent =
                  otherWrapper?.querySelector<HTMLElement>(
                    "[data-mobile-dropdown-content]"
                  );

                otherContent?.classList.remove(
                  "open"
                );
              }
            );

            /* Toggle actuel */
            button.setAttribute(
              "aria-expanded",
              String(!isOpen)
            );

            button.classList.toggle(
              "open",
              !isOpen
            );

            content.classList.toggle(
              "open",
              !isOpen
            );
          }
        );
      }
    );

    /* ========================================================
       CLOSE DROPDOWN ON SCROLL
    ========================================================= */

    let lastScrollY = window.scrollY;

    window.addEventListener(
      "scroll",
      () => {
        const currentScrollY =
          window.scrollY;

        if (
          dropdownOpen &&
          currentScrollY >
            lastScrollY + 50
        ) {
          closeDropdown();
        }

        lastScrollY = currentScrollY;
      },
      { passive: true }
    );

    /* ========================================================
       RESIZE
    ========================================================= */

    window.addEventListener(
      "resize",
      () => {
        if (window.innerWidth > 1024) {
          closeMenu();
        }

        if (window.innerWidth <= 1024) {
          closeDropdown();
        }
      }
    );
  })();
</script>

<style>
  /* ============================================================
     VARIABLES
  ============================================================ */

  :root {
    --color-primary: #2563EB;
    --color-primary-dark: #1D4ED8;

    --color-primary-light: #EFF6FF;
    --color-primary-lighter: #F0F5FF;

    --color-navy: #0F172A;
    --color-navy-soft: #1E293B;

    --color-slate: #475569;
    --color-slate-light: #94A3B8;

    --color-white: #FFFFFF;

    --color-line: rgba(15, 23, 42, 0.08);

    --header-h: 76px;
    --header-h-scrolled: 68px;

    --shadow-premium:
      0 4px 24px rgba(15, 23, 42, 0.08);

    --shadow-premium-lg:
      0 12px 48px rgba(15, 23, 42, 0.13);

    --transition-smooth:
      0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ============================================================
     HEADER
  ============================================================ */

  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;

    height: var(--header-h);

    background: var(--color-white);

    border-bottom:
      1px solid var(--color-line);

    transition:
      height var(--transition-smooth),
      box-shadow var(--transition-smooth),
      backdrop-filter var(--transition-smooth),
      background var(--transition-smooth);
  }

  .site-header.scrolled {
    height: var(--header-h-scrolled);

    box-shadow: var(--shadow-premium);

    background: rgba(255, 255, 255, 0.92);

    backdrop-filter:
      blur(12px) saturate(180%);

    -webkit-backdrop-filter:
      blur(12px) saturate(180%);
  }

  /* ============================================================
     LOGO
  ============================================================ */

  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo {
    width: 80px;
    height: auto;
    display: block;
    object-fit: contain;
    flex-shrink: 0;
  }

  /* ============================================================
     HEADER INNER
  ============================================================ */

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;

    height: 100%;

    max-width: 1280px;
    margin: 0 auto;

    padding: 0 28px;

    gap: 16px;
  }

  /* ============================================================
     DESKTOP NAVIGATION
  ============================================================ */

  .nav-desktop {
    display: flex;
    align-items: center;

    gap: 2px;

    flex: 1;
    justify-content: center;
  }

  .nav-item-wrapper {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;

    gap: 4px;

    padding: 8px 16px;

    border-radius: 10px;

    font-size: 14.5px;
    font-weight: 500;

    color: var(--color-navy);

    text-decoration: none;

    background: transparent;
    border: none;

    cursor: pointer;

    font-family: inherit;

    transition:
      color 0.2s ease,
      background 0.2s ease;

    position: relative;

    white-space: nowrap;
  }

  /* ============================================================
     NAV UNDERLINE
  ============================================================ */

  .nav-link::after {
    content: "";

    position: absolute;

    left: 50%;
    bottom: 2px;

    transform:
      translateX(-50%)
      scaleX(0);

    transform-origin: center;

    width: 18px;
    height: 2px;

    border-radius: 99px;

    background: var(--color-primary);

    opacity: 0;

    transition:
      transform 0.25s ease,
      opacity 0.2s ease;
  }

  .nav-link:hover {
    color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .nav-link:hover::after {
    transform:
      translateX(-50%)
      scaleX(1);

    opacity: 1;
  }

  /* ============================================================
     SERVICES BUTTON
  ============================================================ */

  .nav-link-dropdown {
    display: inline-flex;
    align-items: center;
    gap: 6px;

    cursor: pointer;
  }

  .nav-link-dropdown {
    padding-right: 10px;
  }

  .nav-arrow {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    font-size: 11px;

    line-height: 1;

    color: var(--color-navy-soft);

    transition:
      transform 0.25s ease,
      color 0.2s ease;
  }

  .nav-link-dropdown.open {
    color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .nav-link-dropdown.open::after {
    transform:
      translateX(-50%)
      scaleX(1);

    opacity: 1;
  }

  .nav-link-dropdown.open .nav-arrow {
    transform: rotate(180deg);
    color: var(--color-primary);
  }

  /* ============================================================
     DROPDOWN OVERLAY
  ============================================================ */

  .dropdown-overlay {
    position: fixed;
    inset: 0;

    background:
      rgba(15, 23, 42, 0.15);

    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);

    opacity: 0;
    visibility: hidden;

    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;

    z-index: 55;
  }

  .dropdown-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  /* ============================================================
     DESKTOP DROPDOWN
  ============================================================ */

  .dropdown-container {
    position: absolute;

    top: calc(100% + 8px);
    left: 0;

    width: 300px;

    background: var(--color-white);

    border-radius: 16px;

    border:
      1px solid var(--color-line);

    box-shadow: var(--shadow-premium-lg);

    opacity: 0;
    visibility: hidden;

    transform:
      translateY(-8px)
      scale(0.96);

    transform-origin: top left;

    transition:
      opacity 0.25s ease,
      transform 0.3s cubic-bezier(
        0.22,
        1,
        0.36,
        1
      ),
      visibility 0.25s ease;

    padding: 8px;

    z-index: 60;
  }

  .dropdown-container.open {
    opacity: 1;
    visibility: visible;

    transform:
      translateY(0)
      scale(1);
  }

  .dropdown-header-compact {
    padding: 8px 12px 12px;

    border-bottom:
      1px solid var(--color-line);

    margin-bottom: 8px;
  }

  .dropdown-title {
    font-size: 11px;
    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: 0.08em;

    color: var(--color-slate-light);
  }

  .dropdown-list-compact {
    display: flex;
    flex-direction: column;

    gap: 2px;

    max-height: 360px;
    overflow-y: auto;
  }

  .dropdown-option-compact {
    display: flex;
    align-items: center;

    gap: 12px;

    padding: 10px 12px;

    border-radius: 10px;

    text-decoration: none;

    color: var(--color-navy);

