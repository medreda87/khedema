---
// Composant Footer — Design repensé et 100% Responsive
import { t, type Lang, LANG_LABELS } from "../lib/i18n";
import { icons } from "../lib/icons";
import { SERVICES } from "../lib/services";

interface Props {
  lang?: Lang;
  logoText?: string;
  phone?: string;
  whatsapp?: string;
  email?: string;
}

const {
  lang = "fr",
  logoText = "AlloMealem",
  phone = "+212 7 16 88 54 41",
  whatsapp = "+212716885441",
  email = "allomealeam@gmail.com",
} = Astro.props;

const langs: Lang[] = ["ar", "fr", "en"];
const topServices = SERVICES.slice(0, 6);

const platform = [
  { label: t(lang, "À propos") || "À propos", href: `/propos` },
  { label: t(lang, "Comment ça marche") || "Comment ça marche", href: '/comment-ca-marche'},
  { label: t(lang, "nav.contact") || "Contact", href: `/contact` },
];

const iconMap = {
  clock: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  arrowRight: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`,
};

const isRTL = lang === "ar";
---

<footer class="footer" dir={isRTL ? "rtl" : "ltr"}>
  <div class="footer__container">
    
    <!-- Haut du footer : grille principale -->
    <div class="footer__grid">
      
      <!-- Colonne Brand -->
      <div class="footer__brand">
        <a href='/' class="footer__logo">
          <img src='logo.png' alt='logo' class='logo'/>
        </a>
        <p class="footer__tagline">{t(lang, "footer.tagline") || "Votre partenaire de confiance pour tous vos travaux à Tanger."}</p>
        
        <div class="footer__socials">
          <a href={`https://wa.me/${whatsapp.replace(/[^\d]/g, "")}`} target="_blank" rel="noopener" aria-label="WhatsApp">
            <span set:html={icons.whatsapp || "WA"}></span>
          </a>
          <a href={`tel:${phone}`} aria-label="Phone">
            <span set:html={icons.phone || "📞"}></span>
          </a>
        </div>
        
        <div class="footer__info">
          <span class="footer__info-item">
            <span set:html={iconMap.location}></span>
            Tanger, Maroc
          </span>
          <span class="footer__info-item">
            <span set:html={iconMap.clock}></span>
            Lun–Sam · 8h–20h
          </span>
        </div>
      </div>

      <!-- Colonne Services -->
      <div class="footer__col">
        <h4 class="footer__col-title">{t(lang, "footer.services") || "Services"}</h4>
        <ul class="footer__col-list">
          {topServices.map((s) => (
            <li><a href='#services'>{s.name[lang]}</a></li>
          ))}
        </ul>
      </div>

      <!-- Colonne Plateforme -->
      <div class="footer__col">
        <h4 class="footer__col-title">{t(lang, "footer.platform") || "Plateforme"}</h4>
        <ul class="footer__col-list">
          {platform.map((p) => (
            <li><a href={p.href}>{p.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Colonne Contact & Newsletter -->
      <div class="footer__col footer__col--contact">
        <div>
          <h4 class="footer__col-title">{t(lang, "footer.contact") || "Contact"}</h4>
          <ul class="footer__contact-list">
            <li>
              <a href={`https://wa.me/${whatsapp.replace(/[^\d]/g, "")}`} target="_blank" rel="noopener">
                WhatsApp · {whatsapp}
              </a>
            </li>
            <li><a href={`tel:${phone}`}>{phone}</a></li>
            <li><a href={`mailto:${email}`}>{email}</a></li>
          </ul>
        </div>
        
        <div class="footer__newsletter">
          <span class="footer__newsletter-label">{t(lang, "footer.newsletter") || "Restez informé"}</span>
          <form class="footer__newsletter-form" action="#" method="POST" aria-label="Newsletter">
            <input type="email" placeholder="votre@email.com" required aria-label="Adresse email" />
            <button type="submit" aria-label="S'abonner">
              <span set:html={iconMap.arrowRight}></span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* ============================================================
     VARIABLES & RESET
     ============================================================ */
  .footer {
    --color-primary: #2563eb;
    --color-primary-dark: #1d4ed8;
    
    background: #0b1220;
    color: #cbd5e1;
    padding: 64px 0 28px;
    margin-top: 40px;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    line-height: 1.5;
  }

  .footer__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 28px;
  }

  /* ============================================================
     GRILLE PRINCIPALE
     ============================================================ */
  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* ============================================================
     BRAND
     ============================================================ */
  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    margin-bottom: 16px;
  }
  .logo{
    width:100px;
    height:auto;
  }
  .footer__logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    color: #fff;
    font-weight: 800;
    font-size: 18px;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.3);
  }
  
  .footer__logo-text {
    font-size: 20px;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.02em;
  }

  .footer__tagline {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #94a3b8;
    max-width: 300px;
    margin: 0 0 24px;
  }

  .footer__socials {
    display: flex;
    gap: 10px;
    margin-bottom: 24px;
  }
  
  .footer__socials a {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    display: grid;
    place-items: center;
    color: #94a3b8;
    transition: all 0.25s ease;
  }
  
  .footer__socials a:hover, .footer__socials a:focus-visible {
    background: var(--color-primary);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.3);
    outline: none;
  }
  
  .footer__socials :global(svg) {
    width: 18px;
    height: 18px;
    stroke-width: 1.8;
  }

  .footer__info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  
  .footer__info-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: #64748b;
  }
  
  .footer__info-item :global(svg) {
    width: 16px;
    height: 16px;
    stroke-width: 1.8;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  /* ============================================================
     COLONNES
     ============================================================ */
  .footer__col-title {
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    margin: 0 0 18px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .footer__col-list, .footer__contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  
  .footer__col-list a, .footer__contact-list a {
    color: #94a3b8;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 0;
  }
  
  .footer__col-list a:hover, .footer__contact-list a:hover,
  .footer__col-list a:focus-visible, .footer__contact-list a:focus-visible {
    color: #fff;
    outline: none;
  }

  /* ============================================================
     NEWSLETTER
     ============================================================ */
  .footer__newsletter-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    color: #94a3b8;
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .footer__newsletter-form {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 60px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  
  .footer__newsletter-form:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }
  
  .footer__newsletter-form input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 12px 16px;
    color: #fff;
    font-size: 0.9rem;
    outline: none;
    font-family: inherit;
    min-width: 0;
  }
  
  .footer__newsletter-form input::placeholder {
    color: #64748b;
  }
  
  .footer__newsletter-form button {
    background: var(--color-primary);
    border: none;
    color: #fff;
    width: 44px;
    height: 44px;
    margin: 3px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background 0.25s ease, transform 0.2s ease;
    flex-shrink: 0;
  }
  
  .footer__newsletter-form button:hover, .footer__newsletter-form button:focus-visible {
    background: var(--color-primary-dark);
    transform: scale(1.05);
    outline: none;
  }
  
  .footer__newsletter-form :global(svg) {
    width: 18px;
    height: 18px;
    stroke-width: 2;
  }

  /* ============================================================
     BAS DU FOOTER
     ============================================================ */
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 32px;
    gap: 20px;
    flex-wrap: wrap;
  }

  .footer__legal {
    display: flex;
    gap: 24px;
    font-size: 0.82rem;
    color: #64748b;
    flex-wrap: wrap;
  }
  
  .footer__legal a {
    color: #64748b;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  
  .footer__legal a:hover, .footer__legal a:focus-visible {
    color: #cbd5e1;
    outline: none;
    text-decoration: underline;
  }

  .footer__langs {
    display: flex;
    gap: 4px;
    background: rgba(255, 255, 255, 0.04);
    padding: 4px;
    border-radius: 40px;
  }
  
  .footer__lang {
    padding: 6px 14px;
    border-radius: 40px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #94a3b8;
    text-decoration: none;
    transition: all 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  
  .footer__lang--active {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
  
  .footer__lang:hover:not(.footer__lang--active),
  .footer__lang:focus-visible:not(.footer__lang--active) {
    color: #fff;
    outline: none;
  }

  /* ============================================================
     SUPPORT RTL (Arabe)
     ============================================================ */
  [dir="rtl"] .footer__col-list a:hover,
  [dir="rtl"] .footer__contact-list a:hover {
    transform: translateX(-4px);
  }
  
  [dir="rtl"] .footer__info-item {
    flex-direction: row-reverse;
  }
  
  [dir="rtl"] .footer__newsletter-form button {
    border-radius: 50%;
  }
  
  [dir="rtl"] .footer__newsletter-form :global(svg) {
    transform: rotate(180deg);
  }

  /* ============================================================
     RESPONSIVE : TABLETTE (<= 1024px)
     ============================================================ */
  @media (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
    
    .footer__brand {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      align-items: start;
    }
    
    .footer__brand > .footer__info {
      grid-column: 1 / -1;
      flex-direction: row;
      gap: 24px;
      margin-top: 8px;
    }

    .footer__col--contact {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }

  /* ============================================================
     RESPONSIVE : MOBILE (<= 768px)
     ============================================================ */
  @media (max-width: 768px) {
    .footer {
      padding: 48px 0 24px;
      margin-top: 24px;
    }
    
    .footer__container {
      padding: 0 20px;
    }
    
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 36px;
      padding-bottom: 36px;
    }
    
    .footer__brand {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    
    .footer__brand > .footer__info {
      flex-direction: column;
      gap: 8px;
    }

    .footer__col--contact {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    
    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    
    .footer__legal {
      flex-direction: column;
      gap: 12px;
    }
    
    .footer__tagline {
      max-width: 100%;
    }
  }

  /* ============================================================
     RESPONSIVE : PETIT MOBILE (<= 480px)
     ============================================================ */
  @media (max-width: 480px) {
    .footer__container {
      padding: 0 16px;
    }

    .footer__logo-text {
      font-size: 18px;
    }

    /* Newsletter empilée pour un meilleur toucher sur petit écran */
    .footer__newsletter-form {
      flex-direction: column;
      background: transparent;
      border: none;
      gap: 12px;
      align-items: stretch;
    }
    
    .footer__newsletter-form:focus-within {
      box-shadow: none;
    }
    
    .footer__newsletter-form input {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      height: 48px; /* Zone de toucher optimale */
      padding: 0 16px;
      font-size: 16px; /* Empêche le zoom auto sur iOS */
    }
    
    .footer__newsletter-form input:focus {
      border-color: var(--color-primary);
    }
    
    .footer__newsletter-form button {
      width: 100%;
      height: 48px;
      border-radius: 12px;
      margin: 0;
      font-size: 0.9rem;
      font-weight: 600;
      gap: 8px;
    }
    
    .footer__newsletter-form button::after {
      content: "S'abonner";
    }
    
    .footer__newsletter-form :global(svg) {
      display: none; /* On cache la flèche sur mobile car on a le texte */
    }
    
    [dir="rtl"] .footer__newsletter-form button::after {
      content: "اشتراك";
    }

    .footer__langs {
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
    }
    
    .footer__lang {
      flex: 1;
      text-align: center;
      min-width: 60px;
    }
  }
</style>