---
// Composant Footer — Design repensé
import { t, type Lang, LANG_LABELS } from "../lib/i18n";
import { icons } from "../lib/icons";
import { SERVICES } from "../lib/services";

interface Props {
  lang?: Lang;
  logoText?: string;
  phone?: string;
  whatsapp?: string;
  email?: string;
}

const {
  lang = "fr",
  logoText = "Servio",
  phone = "+212 6 00 00 00 00",
  whatsapp = "+212600000000",
  email = "contact@servio.ma",
} = Astro.props;

const langs: Lang[] = ["ar", "fr", "en"];
const topServices = SERVICES.slice(0, 6);

const platform = [
  { label: t(lang, "nav.about"), href: `/${lang}/#about` },
  { label: t(lang, "nav.how"), href: `/${lang}/#how` },
  { label: t(lang, "nav.technicians"), href: `/${lang}/#technicians` },
  { label: t(lang, "nav.faq"), href: `/${lang}/#faq` },
  { label: t(lang, "nav.contact"), href: `/${lang}/#contact` },
];

// Icons supplémentaires pour le nouveau design
const iconMap = {
  location: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`,
  clock: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  arrowRight: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`,
};
---

<footer class="footer">
  <div class="footer__container">
    <!-- Haut du footer : grille principale -->
    <div class="footer__grid">
      <!-- Colonne Brand -->
      <div class="footer__brand">
        <a href={`/${lang}/`} class="footer__logo">
          <span class="footer__logo-mark">S</span>
          <span class="footer__logo-text">{logoText}</span>
        </a>
        <p class="footer__tagline">{t(lang, "footer.tagline")}</p>
        <div class="footer__socials">
          <a href={`https://wa.me/${whatsapp.replace(/[^\d]/g, "")}`} target="_blank" rel="noopener" aria-label="WhatsApp">
            <span set:html={icons.whatsapp}></span>
          </a>
          <a href={`tel:${phone}`} aria-label="Phone">
            <span set:html={icons.phone}></span>
          </a>
          <a href={`mailto:${email}`} aria-label="Email">
            <span set:html={icons.email || `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`}></span>
          </a>
        </div>
        <div class="footer__info">
          <span class="footer__info-item">
            <span set:html={iconMap.location}></span>
            Tanger, Maroc
          </span>
          <span class="footer__info-item">
            <span set:html={iconMap.clock}></span>
            Lun–Sam · 8h–20h
          </span>
        </div>
      </div>

      <!-- Colonne Services -->
      <div class="footer__col">
        <h4 class="footer__col-title">{t(lang, "footer.services")}</h4>
        <ul class="footer__col-list">
          {topServices.map((s) => (
            <li><a href={`/${lang}/services/${s.slug}`}>{s.name[lang]}</a></li>
          ))}
        </ul>
      </div>

      <!-- Colonne Plateforme -->
      <div class="footer__col">
        <h4 class="footer__col-title">{t(lang, "footer.platform")}</h4>
        <ul class="footer__col-list">
          {platform.map((p) => (
            <li><a href={p.href}>{p.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Colonne Contact & Newsletter -->
      <div class="footer__col footer__col--contact">
        <h4 class="footer__col-title">{t(lang, "footer.contact")}</h4>
        <ul class="footer__contact-list">
          <li><a href={`https://wa.me/${whatsapp.replace(/[^\d]/g, "")}`} target="_blank" rel="noopener">WhatsApp · {whatsapp}</a></li>
          <li><a href={`tel:${phone}`}>{phone}</a></li>
          <li><a href={`mailto:${email}`}>{email}</a></li>
        </ul>
        <div class="footer__newsletter">
          <span class="footer__newsletter-label">Restez informé</span>
          <form class="footer__newsletter-form" action="#" method="POST">
            <input type="email" placeholder="Votre email" required />
            <button type="submit" aria-label="S'abonner">
              <span set:html={iconMap.arrowRight}></span>
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Bas du footer -->
    <div class="footer__bottom">
      <div class="footer__legal">
        <span>© 2026 {logoText} — {t(lang, "footer.rights")}</span>
        <a href={`/${lang}/privacy`}>{t(lang, "footer.privacy")}</a>
        <a href={`/${lang}/terms`}>{t(lang, "footer.terms")}</a>
      </div>
      <div class="footer__langs">
        {langs.map((l) => (
          <a href={`/${l}/`} class:list={["footer__lang", { "footer__lang--active": l === lang }]}>
            {LANG_LABELS[l]}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  /* ============================================================
     FOOTER — Design repensé
     ============================================================ */
  .footer {
    background: #0b1220;
    color: #cbd5e1;
    padding: 64px 0 28px;
    margin-top: 40px;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  .footer__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 28px;
  }

  /* ---- Grille principale ---- */
  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* --- Brand --- */
  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    margin-bottom: 16px;
  }
  .footer__logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: linear-gradient(135deg, var(--color-primary), #1d4ed8);
    color: #fff;
    font-weight: 800;
    font-size: 18px;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.3);
  }
  .footer__logo-text {
    font-size: 20px;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.02em;
  }

  .footer__tagline {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #94a3b8;
    max-width: 300px;
    margin: 0 0 20px;
  }

  .footer__socials {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
  }
  .footer__socials a {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    display: grid;
    place-items: center;
    color: #94a3b8;
    transition: all 0.25s ease;
  }
  .footer__socials a:hover {
    background: var(--color-primary);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.3);
  }
  .footer__socials :global(svg) {
    width: 18px;
    height: 18px;
    stroke-width: 1.8;
  }

  .footer__info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .footer__info-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: #64748b;
  }
  .footer__info-item :global(svg) {
    width: 16px;
    height: 16px;
    stroke-width: 1.8;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  /* --- Colonnes --- */
  .footer__col-title {
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    margin: 0 0 18px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    font-size: 0.75rem;
    opacity: 0.6;
  }

  .footer__col-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer__col-list a {
    color: #94a3b8;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .footer__col-list a:hover {
    color: #fff;
    transform: translateX(4px);
  }

  /* --- Contact & Newsletter --- */
  .footer__contact-list {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer__contact-list a {
    color: #94a3b8;
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .footer__contact-list a:hover {
    color: #fff;
  }

  .footer__newsletter-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: #94a3b8;
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .footer__newsletter-form {
    display: flex;
    align-items: center;
    gap: 0;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 60px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
    transition: border-color 0.25s ease;
  }
  .footer__newsletter-form:focus-within {
    border-color: var(--color-primary);
  }
  .footer__newsletter-form input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 10px 16px;
    color: #fff;
    font-size: 0.85rem;
    outline: none;
    font-family: inherit;
    min-width: 0;
  }
  .footer__newsletter-form input::placeholder {
    color: #64748b;
  }
  .footer__newsletter-form button {
    background: var(--color-primary);
    border: none;
    color: #fff;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background 0.25s ease;
    flex-shrink: 0;
  }
  .footer__newsletter-form button:hover {
    background: var(--color-primary-dark);
  }
  .footer__newsletter-form :global(svg) {
    width: 18px;
    height: 18px;
    stroke-width: 2;
  }

  /* ---- Bas du footer ---- */
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 28px;
    gap: 20px;
    flex-wrap: wrap;
  }

  .footer__legal {
    display: flex;
    gap: 24px;
    font-size: 0.82rem;
    color: #64748b;
    flex-wrap: wrap;
  }
  .footer__legal a {
    color: #64748b;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .footer__legal a:hover {
    color: #cbd5e1;
  }

  .footer__langs {
    display: flex;
    gap: 2px;
    background: rgba(255, 255, 255, 0.04);
    padding: 4px;
    border-radius: 40px;
  }
  .footer__lang {
    padding: 6px 14px;
    border-radius: 40px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #94a3b8;
    text-decoration: none;
    transition: all 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .footer__lang--active {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  .footer__lang:hover:not(.footer__lang--active) {
    color: #fff;
  }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
    .footer__col--contact {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
    .footer__contact-list {
      margin-bottom: 0;
    }
  }

  @media (max-width: 768px) {
    .footer {
      padding: 48px 0 20px;
    }
    .footer__container {
      padding: 0 20px;
    }
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-bottom: 32px;
    }
    .footer__col--contact {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .footer__legal {
      gap: 16px;
    }
    .footer__tagline {
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {
    .footer__legal {
      flex-direction: column;
      gap: 8px;
    }
    .footer__newsletter-form input {
      padding: 8px 12px;
      font-size: 0.8rem;
    }
    .footer__newsletter-form button {
      width: 38px;
      height: 38px;
    }
    .footer__langs {
      flex-wrap: wrap;
    }
  }
</style>