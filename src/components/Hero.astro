---
import { t, type Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
  primaryHref?: string;
  secondaryHref?: string;
}

const {
  lang = "fr",
  primaryHref = `/${lang}/#request`,
  secondaryHref = `/${lang}/#services`,
} = Astro.props;

const trustItems = [
  { fr: "Techniciens locaux", ar: "فنيون محليون", en: "Local technicians" },
  { fr: "Intervention à Tanger", ar: "خدمة في طنجة", en: "Service in Tangier" },
  { fr: "Service rapide", ar: "خدمة سريعة", en: "Fast service" },
  { fr: "Professionnels vérifiés", ar: "محترفون معتمدون", en: "Verified professionals" },
];
---

<section class="hero" aria-labelledby="hero-title">
  <!-- Subtle decorative background -->
  <div class="hero-bg" aria-hidden="true">
    <div class="bg-gradient"></div>
    <div class="bg-shape shape-1"></div>
    <div class="bg-shape shape-2"></div>
    <div class="bg-shape shape-3"></div>
    <div class="bg-dots"></div>
  </div>

  <div class="hero-inner container">
    <!-- LEFT : Copy -->
    <div class="hero-copy">
      <!-- Location badge -->
      <div class="location-badge">
        <span class="location-pin" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </span>
        <span class="location-text">
          {lang === "ar" ? "متاح في طنجة" : lang === "en" ? "Available in Tangier" : "Disponible à Tanger"}
        </span>
        <span class="location-dot" aria-hidden="true"></span>
      </div>

      <!-- Headline -->
      <h1 id="hero-title" class="hero-title">
        <span class="title-line">
          {lang === "ar"
            ? "منزلك في"
            : lang === "en"
              ? "Your home in"
              : "Votre maison à"}
          <span class="title-accent">
            {lang === "ar" ? "طنجة،" : lang === "en" ? "Tangier," : "Tanger,"}
          </span>
        </span>
        <span class="title-line">
          {lang === "ar"
            ? "بين أيدي أمينة."
            : lang === "en"
              ? "in good hands."
              : "entre de bonnes mains."}
        </span>
      </h1>

      <!-- Subtitle -->
      <p class="hero-subtitle">
        {lang === "ar"
          ? "هل تحتاج إلى سباك، كهربائي، فني تكييف أو أي محترف آخر؟ MyHandy يوصلك بفنيين موثوقين في طنجة."
          : lang === "en"
            ? "Need a plumber, electrician, AC technician or another professional? MyHandy connects you with trusted technicians in Tangier."
            : "Besoin d'un plombier, électricien, climatiseur ou autre professionnel ? MyHandy vous met en relation avec des techniciens de confiance à Tanger."}
      </p>

      <!-- CTAs -->
      <div class="hero-cta">
        <a href={primaryHref} class="btn btn-primary">
          <span class="btn-label">
            {lang === "ar" ? "طلب خدمة" : lang === "en" ? "Request a service" : "Demander un service"}
          </span>
          <span class="btn-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </span>
        </a>
        <a href={secondaryHref} class="btn btn-secondary">
          <span class="btn-label">
            {lang === "ar" ? "عرض خدماتنا" : lang === "en" ? "View our services" : "Voir nos services"}
          </span>
        </a>
      </div>

      <!-- Trust indicators -->
      <ul class="hero-trust" aria-label={lang === "ar" ? "ضمانات" : lang === "en" ? "Guarantees" : "Garanties"}>
        {trustItems.map((item) => (
          <li class="trust-item">
            <span class="trust-check" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </span>
            <span class="trust-text">{item[lang]}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- RIGHT : Visual -->
    <div class="hero-visual">
      <div class="visual-frame">
        <!-- Decorative soft blob -->
        <div class="visual-blob" aria-hidden="true"></div>

        <!-- Hero Image -->
        <div class="illustration">
          <img 
            src="/image1.png" 
            alt="Technicien professionnel MyHandy à Tanger" 
            class="hero-image"
            width="520"
            height="520"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  :root {
    --c-primary: #2563EB;
    --c-primary-dark: #1D4ED8;
    --c-primary-light: #EFF6FF;
    --c-accent: #F59E0B;
    --c-dark: #0F172A;
    --c-white: #FFFFFF;
    --c-line: rgba(15, 23, 42, 0.08);
    --header-h: 80px;
  }

  .hero {
    padding: calc(var(--header-h, 80px) + 64px) 0 96px;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background-color: var(--c-white);
    min-height: 90vh;
    display: flex;
    align-items: center;
  }

  /* ===== Background ===== */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .bg-gradient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 10%, rgba(37, 99, 235, 0.08), transparent 55%),
      radial-gradient(ellipse at 90% 80%, rgba(245, 158, 11, 0.05), transparent 50%),
      linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
  }
  .bg-shape {
    position: absolute;
    opacity: 0.5;
    animation: drift 22s ease-in-out infinite;
  }
  .shape-1 {
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.12), transparent 70%);
    top: -80px;
    left: -80px;
  }
  .shape-2 {
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.1), transparent 70%);
    bottom: -60px;
    right: 10%;
    animation-delay: -8s;
  }
  .shape-3 {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.08), transparent 70%);
    top: 40%;
    right: 40%;
    animation-delay: -14s;
  }
  .bg-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(37, 99, 235, 0.12) 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.35;
    mask-image: radial-gradient(ellipse at 50% 50%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, #000 30%, transparent 75%);
  }
  @keyframes drift {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(30px, -20px); }
  }

  /* ===== Layout ===== */
  .hero-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;  /* plus de place pour le texte, mais l'image reste large */
    gap: 48px;
    align-items: center;
    position: relative;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 28px;
  }
  .hero-copy {
    max-width: 720px;  /* texte plus large */
  }

  /* ===== Location badge ===== */
  .location-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px 8px 14px;
    background: var(--c-primary-light);
    border: 1px solid rgba(37, 99, 235, 0.15);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--c-primary);
    margin-bottom: 32px;
    animation: fadeUp 0.8s ease-out both;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.06);
  }
  .location-pin {
    width: 18px;
    height: 18px;
    display: grid;
    place-items: center;
    color: var(--c-primary);
  }
  .location-pin svg { width: 100%; height: 100%; }
  .location-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c-accent);
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.25);
    animation: pulse 2.2s ease-out infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.4); }
    100% { box-shadow: 0 0 0 10px rgba(245, 158, 11, 0); }
  }

  /* ===== Title ===== */
  .hero-title {
    font-size: clamp(2.8rem, 5.6vw, 4.2rem);  /* légèrement plus grand */
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 800;
    margin: 0 0 24px;
    color: var(--c-dark);
    animation: fadeUp 0.9s 0.1s ease-out both;
  }
  .title-line { display: block; }
  .title-accent {
    color: var(--c-primary);
    position: relative;
    white-space: nowrap;
  }
  .title-accent::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 8px;
    background: rgba(37, 99, 235, 0.15);
    border-radius: 4px;
    z-index: -1;
  }

  /* ===== Subtitle ===== */
  .hero-subtitle {
    font-size: 1.25rem;  /* plus grand */
    color: #475569;
    line-height: 1.7;
    margin: 0 0 40px;
    max-width: 600px;
    animation: fadeUp 1s 0.2s ease-out both;
  }

  /* ===== CTAs ===== */
  .hero-cta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 44px;
    animation: fadeUp 1s 0.3s ease-out both;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 32px;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 40px;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease, color 0.25s ease;
    cursor: pointer;
    white-space: nowrap;
  }
  .btn-primary {
    background: var(--c-primary);
    color: var(--c-white);
    box-shadow: 0 12px 28px -8px rgba(37, 99, 235, 0.45);
  }
  .btn-primary:hover {
    background: var(--c-primary-dark);
    transform: translateY(-3px);
    box-shadow: 0 18px 36px -8px rgba(37, 99, 235, 0.6);
  }
  .btn-arrow {
    width: 18px;
    height: 18px;
    display: grid;
    place-items: center;
    transition: transform 0.25s ease;
  }
  .btn-arrow svg { width: 100%; height: 100%; }
  .btn-primary:hover .btn-arrow { transform: translateX(4px); }
  html[dir="rtl"] .btn-primary:hover .btn-arrow { transform: translateX(-4px) rotate(180deg); }
  html[dir="rtl"] .btn-arrow svg { transform: rotate(180deg); }

  .btn-secondary {
    background: transparent;
    color: var(--c-dark);
    border: 2px solid var(--c-line);
  }
  .btn-secondary:hover {
    color: var(--c-primary);
    border-color: var(--c-primary);
    background: var(--c-primary-light);
    transform: translateY(-2px);
  }

  /* ===== Trust ===== */
  .hero-trust {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 14px 32px;
    animation: fadeUp 1s 0.4s ease-out both;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.95rem;
    font-weight: 500;
    color: #334155;
  }
  .trust-check {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--c-primary-light);
    color: var(--c-primary);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .trust-check svg { width: 13px; height: 13px; }

  /* ===== Visual ===== */
  .hero-visual {
    position: relative;
    aspect-ratio: 1 / 1;
    max-height: 600px;  /* plus grand */
    display: flex;
    align-items: center;
    justify-content: flex-end;  /* aligné à droite */
    animation: fadeIn 1.1s 0.3s ease-out both;
    justify-self: end;  /* pousse l'élément vers la droite */
  }
  .visual-frame {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .visual-blob {
    position: absolute;
    inset: 5% 0%;
    background: radial-gradient(circle at 50% 50%, rgba(37, 99, 235, 0.18), transparent 65%);
    border-radius: 50%;
    filter: blur(40px);
    animation: blob 14s ease-in-out infinite;
    z-index: 1;
  }
  @keyframes blob {
    0%, 100% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(1.08) rotate(180deg); }
  }
  .illustration {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    animation: floatY 6s ease-in-out infinite;
    z-index: 2;
  }
  
  /* ===== Hero Image Styling ===== */
  .hero-image {
    width: 100%;
    height: auto;
    max-width: 600px;   /* plus grand */
    max-height: 520px;
    object-fit: contain;
    border-radius: 28px;
    filter: drop-shadow(0 30px 60px rgba(37, 99, 235, 0.15));
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.4s ease;
    border: 1px solid rgba(37, 99, 235, 0.06);
  }
  .hero-image:hover {
    transform: scale(1.03) rotate(1deg);
    box-shadow: 0 40px 80px rgba(37, 99, 235, 0.2);
  }

  /* ===== Keyframes ===== */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes floatY {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  /* ===== Reduced motion ===== */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
    }
    .btn-primary:hover, .btn-secondary:hover, .hero-image:hover { transform: none !important; }
  }

  /* ===== Responsive ===== */
  @media (max-width: 1024px) {
    .hero-inner { gap: 40px; padding: 0 24px; }
    .hero-visual { max-height: 500px; }
  }

  @media (max-width: 900px) {
    .hero { padding-bottom: 72px; min-height: auto; }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .hero-copy { max-width: 100%; }
    .hero-visual {
      order: -1;
      max-height: 420px;
      margin: 0 auto;
      width: 100%;
      justify-self: center;  /* centre sur mobile */
      justify-content: center;
    }
    .hero-image { max-width: 380px; max-height: 380px; }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: calc(var(--header-h, 72px) + 32px);
      padding-bottom: 56px;
    }
    .hero-title { font-size: clamp(2rem, 8vw, 2.6rem); }
    .hero-subtitle { font-size: 1rem; }
    .hero-cta { flex-direction: column; align-items: stretch; }
    .btn { width: 100%; justify-content: center; padding: 14px 24px; }
    .hero-trust { grid-template-columns: 1fr; gap: 12px; }
    .hero-visual { max-height: 320px; }
    .hero-image { max-width: 300px; max-height: 300px; }
    .hero-inner { padding: 0 16px; }
  }

  @media (max-width: 390px) {
    .hero-title { font-size: 1.8rem; }
    .location-badge { font-size: 0.8rem; padding: 6px 12px; }
    .btn { padding: 12px 18px; font-size: 0.95rem; }
  }

  /* ===== Dark mode ===== */
  @media (prefers-color-scheme: dark) {
    :root {
      --c-dark: #F1F5F9;
      --c-white: #0B1220;
      --c-line: rgba(241, 245, 249, 0.1);
    }
    .hero {
      background-color: #0B1220;
    }
    .bg-gradient {
      background:
        radial-gradient(ellipse at 20% 10%, rgba(37, 99, 235, 0.18), transparent 55%),
        radial-gradient(ellipse at 90% 80%, rgba(245, 158, 11, 0.08), transparent 50%),
        linear-gradient(180deg, #0B1220 0%, #0F172A 100%);
    }
    .bg-dots {
      background-image: radial-gradient(rgba(148, 163, 184, 0.15) 1px, transparent 1px);
    }
    .hero-subtitle { color: #CBD5E1; }
    .trust-item { color: #CBD5E1; }
    .location-badge {
      background: rgba(37, 99, 235, 0.15);
      border-color: rgba(37, 99, 235, 0.3);
    }
    .btn-secondary {
      color: #F1F5F9;
      border-color: rgba(241, 245, 249, 0.2);
    }
    .btn-secondary:hover {
      background: rgba(37, 99, 235, 0.15);
      border-color: var(--c-primary);
      color: #93C5FD;
    }
    .hero-image {
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
    }
    .hero-image:hover {
      box-shadow: 0 40px 80px rgba(0, 0, 0, 0.6);
    }
  }
</style>