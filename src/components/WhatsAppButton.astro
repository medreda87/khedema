---
import { t, type Lang } from "../lib/i18n";
import { icons } from "../lib/icons";

interface Props {
  lang?: Lang;
  phone?: string;
  service?: string;
  message?: string;
  variant?: "inline" | "floating";
  label?: string;
}

const {
  lang = "fr",
  phone = "+212600000000",
  service,
  message,
  variant = "inline",
  label,
} = Astro.props;

const phoneDigits = phone.replace(/[^\d]/g, "");
const finalMessage =
  message ??
  (service
    ? `${t(lang, "whatsapp.prefix")} ${service}.`
    : t(lang, "whatsapp.prefix") + ".");
const href = `https://wa.me/${phoneDigits}?text=${encodeURIComponent(finalMessage)}`;
const displayLabel = label ?? t(lang, "cta.whatsapp");
---

{variant === "floating" ? (
  <a href={href} class="wa-float" target="_blank" rel="noopener" aria-label="WhatsApp">
    <span class="wa-float-icon" set:html={icons.whatsapp}></span>
    <span class="wa-float-ping"></span>
  </a>
) : (
  <a href={href} class="wa-btn" target="_blank" rel="noopener">
    <span class="wa-icon" set:html={icons.whatsapp}></span>
    <span class="wa-label">{displayLabel}</span>
  </a>
)}

<style>
  .wa-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 24px;
    background: #25D366;
    color: #fff;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 15px;
    box-shadow: 0 8px 20px -8px rgba(37, 211, 102, 0.55);
    transition: transform .2s, box-shadow .2s, background .2s;
  }
  .wa-btn:hover {
    background: #1ebe5d;
    transform: translateY(-2px);
    box-shadow: 0 12px 26px -10px rgba(37, 211, 102, 0.7);
  }
  .wa-icon { width: 22px; height: 22px; display: inline-flex; }
  .wa-icon :global(svg) { width: 100%; height: 100%; }

  .wa-float {
    position: fixed;
    inset-block-end: 24px;
    inset-inline-end: 24px;
    z-index: 40;
    width: 60px; height: 60px;
    border-radius: 50%;
    background: #25D366;
    color: #fff;
    display: grid; place-items: center;
    box-shadow: 0 12px 30px -8px rgba(37, 211, 102, 0.6);
    transition: transform .25s ease;
  }
  .wa-float:hover { transform: scale(1.08); }
  .wa-float-icon { width: 30px; height: 30px; display: grid; place-items: center; }
  .wa-float-icon :global(svg) { width: 100%; height: 100%; }
  .wa-float-ping {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #25D366;
    opacity: 0.4;
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ping {
    0% { transform: scale(1); opacity: 0.4; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  @media (max-width: 768px) {
    .wa-float {
      inset-block-end: 88px;
      width: 54px; height: 54px;
    }
  }
</style>