---
import { t, type Lang } from "../lib/i18n";
import { SERVICES } from "../lib/services";
import WhatsAppButton from "./WhatsAppButton.astro";

interface Props {
  lang?: Lang;
  phone?: string;
  title?: string;
  subtitle?: string;
}

const {
  lang = "fr",
  phone = "+2127168854",
  title,
  subtitle,
} = Astro.props;

// ⚠️ Remplace TON_FORM_ID par ton vrai Formspree ID
const formAction = "https://formspree.io/f/mgaeepyr";
---

<section id="request" class="section request">
  <!-- Background decoration -->
  <div class="request-bg" aria-hidden="true">
    <div class="bg-shape shape-1"></div>
    <div class="bg-shape shape-2"></div>
  </div>

  <div class="container">
    <div class="request-wrap">

      <!-- ================= LEFT ================= -->
      <div class="request-info">

        <span class="eyebrow">
          {t(lang, "cta.request")}
        </span>

        <h2 class="request-title">
          {title ?? t(lang, "cta.request")}
        </h2>

        <p class="request-subtitle">
          {subtitle ??
            (lang === "ar"
              ? "أخبرنا باحتياجك، سنتواصل معك خلال دقائق."
              : lang === "en"
                ? "Tell us what you need — we'll get back to you within minutes."
                : "Décrivez votre besoin — nous revenons vers vous en quelques minutes.")}
        </p>

        <!-- Features -->
        <div class="request-features">

          <div class="feat">
            <span class="feat-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>

            <div>
              <strong>
                {lang === "ar"
                  ? "سريع"
                  : lang === "en"
                    ? "Fast"
                    : "Rapide"}
              </strong>

              <p>
                {lang === "ar"
                  ? "رد خلال 15 دقيقة"
                  : lang === "en"
                    ? "Reply within 15 min"
                    : "Réponse sous 15 min"}
              </p>
            </div>
          </div>

          <div class="feat">
            <span class="feat-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>

            <div>
              <strong>
                {lang === "ar"
                  ? "موثوق"
                  : lang === "en"
                    ? "Trusted"
                    : "Fiable"}
              </strong>

              <p>
                {lang === "ar"
                  ? "تقنيون موثقون"
                  : lang === "en"
                    ? "Verified technicians"
                    : "Techniciens vérifiés"}
              </p>
            </div>
          </div>

          <div class="feat">
            <span class="feat-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>

            <div>
              <strong>
                {lang === "ar"
                  ? "مجاني"
                  : lang === "en"
                    ? "Free"
                    : "Gratuit"}
              </strong>

              <p>
                {lang === "ar"
                  ? "الطلب والتقدير مجانيان"
                  : lang === "en"
                    ? "Request & quote free"
                    : "Demande et devis gratuits"}
              </p>
            </div>
          </div>

        </div>

        <!-- WhatsApp -->
        <div class="request-alt">
          <p>
            {lang === "ar"
              ? "أو تواصل مباشرة عبر واتساب"
              : lang === "en"
                ? "Or contact directly via WhatsApp"
                : "Ou contactez directement via WhatsApp"}
          </p>

          <WhatsAppButton
            lang={lang}
            phone={phone}
          />
        </div>

      </div>

      <!-- ================= FORM ================= -->
      <form
        class="request-form"
        method="POST"
        action={formAction}
        data-request-form
      >

        <!-- Name -->
        <div class="field">
          <label for="name">
            {t(lang, "form.name")}
          </label>

          <input
            id="name"
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder={
              lang === "ar"
                ? "الاسم الكامل"
                : lang === "en"
                  ? "Full name"
                  : "Nom complet"
            }
          />
        </div>

        <!-- Phone -->
        <div class="field">
          <label for="phone">
            {t(lang, "form.phone")}
          </label>

          <input
            id="phone"
            name="phone"
            type="tel"
            required
            autocomplete="tel"
            placeholder="+212 6XX XXX XXX"
          />
        </div>

        <!-- Service -->
        <div class="field">
          <label for="service">
            {t(lang, "form.service")}
          </label>

          <select
            id="service"
            name="service"
            required
          >
            <option value="" disabled selected>
              {t(lang, "form.selectService")}
            </option>

            {SERVICES.map((s) => (
              <option value={s.slug}>
                {s.name[lang]}
              </option>
            ))}
          </select>
        </div>

        <!-- City -->
        <div class="field">
          <label for="city">
            {t(lang, "form.city")}
          </label>

          <input
            id="city"
            name="city"
            type="text"
            required
            autocomplete="address-level2"
            placeholder={
              lang === "ar"
                ? "طنجة"
                : lang === "en"
                  ? "Tangier"
                  : "Tanger"
            }
            value={
              lang === "ar"
                ? "طنجة"
                : lang === "en"
                  ? "Tangier"
                  : "Tanger"
            }
          />
        </div>

        <!-- Date -->
        <div class="field">
          <label for="date">
            {t(lang, "form.date")}
          </label>

          <input
            id="date"
            name="date"
            type="date"
          />
        </div>

        <!-- Description -->
        <div class="field field-full">
          <label for="description">
            {t(lang, "form.description")}
          </label>

          <textarea
            id="description"
            name="description"
            rows="4"
            placeholder={
              lang === "ar"
                ? "اشرح مشكلتك باختصار..."
                : lang === "en"
                  ? "Briefly describe your issue..."
                  : "Décrivez brièvement votre besoin..."
            }
          ></textarea>
        </div>

        <!-- Formspree subject -->
        <input
          type="hidden"
          name="_subject"
          value="Nouvelle demande de technicien"
        />

        <!-- Submit -->
        <button
          type="submit"
          class="btn btn-primary submit-btn"
        >
          <span class="btn-icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </span>

          <span class="submit-text">
            {t(lang, "cta.send")}
          </span>
        </button>

      </form>

    </div>
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLFormElement>("[data-request-form]")
    .forEach((form) => {

      form.addEventListener("submit", () => {
        const btn =
          form.querySelector<HTMLButtonElement>(
            "button[type=submit]"
          );

        if (!btn) return;

        btn.disabled = true;

        btn.style.opacity = "0.7";

        const text =
          btn.querySelector(".submit-text");

        if (text) {
          text.textContent = "Envoi...";
        }
      });

    });
</script>

<style>
  :root {
    --c-primary: #2563EB;
    --c-primary-dark: #1D4ED8;
    --c-primary-light: #EFF6FF;
    --c-accent: #F59E0B;
    --c-dark: #0F172A;
    --c-white: #FFFFFF;
    --c-line: rgba(15, 23, 42, 0.08);
    --c-ink-soft: #475569;
  }

  .request {
    position: relative;
    padding: 100px 0;
    background: linear-gradient(
      180deg,
      #FFFFFF 0%,
      #F8FAFC 100%
    );
    overflow: hidden;
  }

  .request-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .bg-shape {
    position: absolute;
    border-radius: 50%;
    opacity: 0.4;
  }

  .shape-1 {
    width: 400px;
    height: 400px;
    background: radial-gradient(
      circle,
      rgba(37, 99, 235, 0.08),
      transparent 70%
    );
    top: -100px;
    right: -100px;
  }

  .shape-2 {
    width: 300px;
    height: 300px;
    background: radial-gradient(
      circle,
      rgba(245, 158, 11, 0.06),
      transparent 70%
    );
    bottom: -50px;
    left: -50px;
  }

  .container {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .request-wrap {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 64px;
    align-items: start;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--c-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }

  .request-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--c-dark);
    margin: 0 0 16px;
    line-height: 1.1;
  }

  .request-subtitle {
    font-size: 1.1rem;
    color: var(--c-ink-soft);
    margin: 0 0 40px;
    line-height: 1.6;
    max-width: 480px;
  }

  .request-features {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 40px;
  }

  .feat {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .feat-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--c-primary-light);
    color: var(--c-primary);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .feat-icon svg {
    width: 18px;
    height: 18px;
  }

  .feat strong {
    display: block;
    font-weight: 700;
    color: var(--c-dark);
    margin-bottom: 4px;
    font-size: 1rem;
  }

  .feat p {
    margin: 0;
    font-size: 0.925rem;
    color: var(--c-ink-soft);
    line-height: 1.5;
  }

  .request-alt {
    padding: 24px;
    background: var(--c-primary-light);
    border: 1px solid rgba(37, 99, 235, 0.15);
    border-radius: 16px;
  }

  .request-alt p {
    margin: 0 0 16px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--c-dark);
  }

  .request-form {
    background: var(--c-white);
    border-radius: 20px;
    padding: 40px;
    border: 1px solid var(--c-line);
    box-shadow:
      0 20px 40px -12px rgba(37, 99, 235, 0.08),
      0 8px 16px -8px rgba(15, 23, 42, 0.04);

    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field-full {
    grid-column: 1 / -1;
  }

  .field label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--c-dark);
  }

  .field input,
  .field select,
  .field textarea {
    padding: 14px 16px;
    border: 1.5px solid var(--c-line);
    border-radius: 12px;
    font-family: inherit;
    font-size: 0.95rem;
    background: #FAFBFC;
    color: var(--c-dark);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
    min-height: 48px;
    box-sizing: border-box;
  }

  .field textarea {
    resize: vertical;
    min-height: 110px;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: #94A3B8;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--c-primary);
    background: var(--c-white);
    box-shadow:
      0 0 0 4px rgba(37, 99, 235, 0.12);
  }

  .submit-btn {
    grid-column: 1 / -1;
    padding: 16px 28px;
    font-size: 1rem;
    font-weight: 600;
    margin-top: 8px;
    background: var(--c-primary);
    color: var(--c-white);
    border: none;
    border-radius: 12px;
    cursor: pointer;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;

    box-shadow:
      0 10px 24px -8px rgba(37, 99, 235, 0.5);

    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      background 0.25s ease;
  }

  .submit-btn:hover {
    background: var(--c-primary-dark);
    transform: translateY(-2px);
    box-shadow:
      0 14px 30px -8px rgba(37, 99, 235, 0.6);
  }

  .submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  .btn-icon svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 960px) {
    .request-wrap {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .request-subtitle {
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .request {
      padding: 60px 0;
    }

    .request-form {
      grid-template-columns: 1fr;
      padding: 24px;
      gap: 16px;
    }

    .field-full,
    .submit-btn {
      grid-column: auto;
    }

    .request-title {
      font-size: 1.85rem;
    }
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --c-dark: #F1F5F9;
      --c-white: #0B1220;
      --c-line: rgba(241, 245, 249, 0.1);
      --c-ink-soft: #CBD5E1;
    }

    .request {
      background: linear-gradient(
        180deg,
        #0B1220 0%,
        #0F172A 100%
      );
    }

    .shape-1 {
      background: radial-gradient(
        circle,
        rgba(37, 99, 235, 0.15),
        transparent 70%
      );
    }

    .shape-2 {
      background: radial-gradient(
        circle,
        rgba(245, 158, 11, 0.1),
        transparent 70%
      );
    }

    .request-alt {
      background: rgba(37, 99, 235, 0.1);
      border-color: rgba(37, 99, 235, 0.25);
    }

    .request-form {
      background: #111827;
      border-color: rgba(255, 255, 255, 0.08);
      box-shadow:
        0 20px 40px -12px rgba(0, 0, 0, 0.4);
    }

    .field input,
    .field select,
    .field textarea {
      background: #0B1220;
      color: var(--c-dark);
      border-color: rgba(255, 255, 255, 0.1);
    }

    .field input:focus,
    .field select:focus,
    .field textarea:focus {
      background: #0F172A;
      border-color: var(--c-primary);
      box-shadow:
        0 0 0 4px rgba(37, 99, 235, 0.2);
    }

    .feat strong {
      color: var(--c-dark);
    }
  }
</style>