---
import { t, type Lang } from "../lib/i18n";
import { SERVICES } from "../lib/services";
import WhatsAppButton from "./WhatsAppButton.astro";

interface Props {
  lang?: Lang;
  phone?: string;
  title?: string;
  subtitle?: string;
}

const {
  lang = "fr",
  phone = "+2127168854",
  title,
  subtitle,
} = Astro.props;

// Formspree
const formAction = "https://formspree.io/f/mgaeepyr";
---

<section id="request" class="section request">

  <!-- Background decoration -->
  <div class="request-bg" aria-hidden="true">
    <div class="bg-shape shape-1"></div>
    <div class="bg-shape shape-2"></div>
  </div>

  <div class="container">

    <div class="request-wrap">

      <!-- =====================================================
           LEFT
      ====================================================== -->
      <div class="request-info">

        <span class="eyebrow">
          {t(lang, "cta.request")}
        </span>

        <h2 class="request-title">
          {title ?? t(lang, "cta.request")}
        </h2>

        <p class="request-subtitle">
          {subtitle ??
            (lang === "ar"
              ? "أخبرنا باحتياجك، سنتواصل معك خلال دقائق."
              : lang === "en"
                ? "Tell us what you need — we'll get back to you within minutes."
                : "Décrivez votre besoin — nous revenons vers vous en quelques minutes.")}
        </p>

        <!-- =====================================================
             FEATURES
        ====================================================== -->
        <div class="request-features">

          <!-- Feature 1 -->
          <div class="feat">

            <span class="feat-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>

            <div>
              <strong>
                {lang === "ar"
                  ? "سريع"
                  : lang === "en"
                    ? "Fast"
                    : "Rapide"}
              </strong>

              <p>
                {lang === "ar"
                  ? "رد خلال 15 دقيقة"
                  : lang === "en"
                    ? "Reply within 15 min"
                    : "Réponse sous 15 min"}
              </p>
            </div>

          </div>

          <!-- Feature 2 -->
          <div class="feat">

            <span class="feat-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>

            <div>
              <strong>
                {lang === "ar"
                  ? "موثوق"
                  : lang === "en"
                    ? "Trusted"
                    : "Fiable"}
              </strong>

              <p>
                {lang === "ar"
                  ? "تقنيون موثقون"
                  : lang === "en"
                    ? "Verified technicians"
                    : "Techniciens vérifiés"}
              </p>
            </div>

          </div>

          <!-- Feature 3 -->
          <div class="feat">

            <span class="feat-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>

            <div>
              <strong>
                {lang === "ar"
                  ? "مجاني"
                  : lang === "en"
                    ? "Free"
                    : "Gratuit"}
              </strong>

              <p>
                {lang === "ar"
                  ? "الطلب والتقدير مجانيان"
                  : lang === "en"
                    ? "Request & quote free"
                    : "Demande et devis gratuits"}
              </p>
            </div>

          </div>

        </div>

        <!-- =====================================================
             WHATSAPP
        ====================================================== -->
        <div class="request-alt">

          <p>
            {lang === "ar"
              ? "أو تواصل مباشرة عبر واتساب"
              : lang === "en"
                ? "Or contact directly via WhatsApp"
                : "Ou contactez directement via WhatsApp"}
          </p>

          <WhatsAppButton
            lang={lang}
            phone={phone}
          />

        </div>

      </div>


      <!-- =====================================================
           FORM
      ====================================================== -->
      <div class="form-container">

        <!-- SUCCESS MESSAGE -->
        <div
          class="success-message"
          data-success-message
          role="alert"
          aria-live="polite"
        >

          <div class="success-icon">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>

          </div>

          <div class="success-content">

            <strong>
              {lang === "ar"
                ? "تمت إضافة طلبك بنجاح"
                : lang === "en"
                  ? "Request added successfully"
                  : "Demande ajoutée avec succès"}
            </strong>

            <p>
              {lang === "ar"
                ? "سنتواصل معك في أقرب وقت ممكن."
                : lang === "en"
                  ? "We'll contact you as soon as possible."
                  : "Nous vous contacterons dans les plus brefs délais."}
            </p>

          </div>

          <button
            type="button"
            class="success-close"
            data-success-close
            aria-label="Fermer"
          >
            ×
          </button>

        </div>


        <form
          class="request-form"
          method="POST"
          action={formAction}
          data-request-form
        >

          <!-- =================================================
               NAME
          ================================================== -->
          <div class="field">

            <label for="name">
              {t(lang, "form.name")}
            </label>

            <input
              id="name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder={
                lang === "ar"
                  ? "الاسم الكامل"
                  : lang === "en"
                    ? "Full name"
                    : "Nom complet"
              }
            />

          </div>


          <!-- =================================================
               PHONE
          ================================================== -->
          <div class="field">

            <label for="phone">
              {t(lang, "form.phone")}
            </label>

            <input
              id="phone"
              name="phone"
              type="tel"
              required
              autocomplete="tel"
              placeholder="+212 6XX XXX XXX"
            />

          </div>


          <!-- =================================================
               SERVICE
          ================================================== -->
          <div class="field">

            <label for="service">
              {t(lang, "form.service")}
            </label>

            <select
              id="service"
              name="service"
              required
            >

              <option value="" disabled selected>
                {t(lang, "form.selectService")}
              </option>

              {SERVICES.map((s) => (
                <option value={s.slug}>
                  {s.name[lang]}
                </option>
              ))}

            </select>

          </div>


          <!-- =================================================
               CITY
          ================================================== -->
          <div class="field">

            <label for="city">
              {t(lang, "form.city")}
            </label>

            <input
              id="city"
              name="city"
              type="text"
              required
              autocomplete="address-level2"
              placeholder={
                lang === "ar"
                  ? "طنجة"
                  : lang === "en"
                    ? "Tangier"
                    : "Tanger"
              }
              value={
                lang === "ar"
                  ? "طنجة"
                  : lang === "en"
                    ? "Tangier"
                    : "Tanger"
              }
            />

          </div>


          <!-- =================================================
               DATE
          ================================================== -->
          <div class="field">

            <label for="date">
              {t(lang, "form.date")}
            </label>

            <input
              id="date"
              name="date"
              type="date"
            />

          </div>


          <!-- =================================================
               DESCRIPTION
          ================================================== -->
          <div class="field field-full">

            <label for="description">
              {t(lang, "form.description")}
            </label>

            <textarea
              id="description"
              name="description"
              rows="4"
              placeholder={
                lang === "ar"
                  ? "اشرح مشكلتك باختصار..."
                  : lang === "en"
                    ? "Briefly describe your issue..."
                    : "Décrivez brièvement votre besoin..."
              }
            ></textarea>

          </div>


          <!-- =================================================
               FORMSPREE SUBJECT
          ================================================== -->
          <input
            type="hidden"
            name="_subject"
            value="Nouvelle demande de technicien"
          />


          <!-- =================================================
               SUBMIT
          ================================================== -->
          <button
            type="submit"
            class="btn btn-primary submit-btn"
          >

            <span class="btn-icon">

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line
                  x1="22"
                  y1="2"
                  x2="11"
                  y2="13"
                ></line>

                <polygon
                  points="22 2 15 22 11 13 2 9 22 2"
                ></polygon>
              </svg>

            </span>

            <span class="submit-text">
              {t(lang, "cta.send")}
            </span>

          </button>

        </form>

      </div>

    </div>

  </div>

</section>


<!-- ============================================================
     JAVASCRIPT
============================================================= -->

<script>
  document
    .querySelectorAll<HTMLFormElement>("[data-request-form]")
    .forEach((form) => {

      const successMessage =
        form.parentElement?.querySelector<HTMLElement>(
          "[data-success-message]"
        );

      const closeButton =
        successMessage?.querySelector<HTMLButtonElement>(
          "[data-success-close]"
        );

      /*
       * Fermer le message
       */
      closeButton?.addEventListener("click", () => {
        successMessage?.classList.remove("show");
      });


      /*
       * Submit du formulaire
       */
      form.addEventListener("submit", async (event) => {

        event.preventDefault();

        const button =
          form.querySelector<HTMLButtonElement>(
            "button[type=submit]"
          );

        if (!button) return;

        const text =
          button.querySelector<HTMLElement>(
            ".submit-text"
          );

        const originalText =
          text?.textContent || "Envoyer";


        /*
         * Désactiver le bouton
         */
        button.disabled = true;

        button.classList.add("loading");

        if (text) {
          text.textContent =
            "Envoi...";
        }


        try {

          /*
           * Récupération des données
           */
          const formData =
            new FormData(form);


          /*
           * Envoi AJAX vers Formspree
           */
          const response =
            await fetch(
              form.action,
              {
                method: "POST",
                body: formData,
                headers: {
                  Accept: "application/json",
                },
              }
            );


          /*
           * Vérification réponse
           */
          if (!response.ok) {

            throw new Error(
              "Erreur lors de l'envoi"
            );

          }


          /*
           * SUCCÈS
           */

          form.reset();

          /*
           * Remettre Tanger par défaut
           */
          const city =
            form.querySelector<HTMLInputElement>(
              "#city"
            );

          if (city) {

            const pageLang =
              document.documentElement.lang ||
              "fr";

            if (pageLang === "ar") {
              city.value = "طنجة";
            } else if (pageLang === "en") {
              city.value = "Tangier";
            } else {
              city.value = "Tanger";
            }
          }


          /*
           * Afficher le message
           */
          successMessage?.classList.add(
            "show"
          );


          /*
           * Scroll vers le message
           */
          successMessage?.scrollIntoView({
            behavior: "smooth",
            block: "center",
          });


          /*
           * Restaurer bouton
           */
          button.disabled = false;

          button.classList.remove(
            "loading"
          );

          if (text) {
            text.textContent =
              originalText;
          }


          /*
           * Cacher automatiquement après 7 secondes
           */
          setTimeout(() => {

            successMessage?.classList.remove(
              "show"
            );

          }, 7000);


        } catch (error) {

          console.error(
            "Erreur formulaire :",
            error
          );


          /*
           * Message erreur
           */
          if (successMessage) {

            const strong =
              successMessage.querySelector(
                "strong"
              );

            const paragraph =
              successMessage.querySelector(
                "p"
              );

            if (strong) {

              strong.textContent =
                lang === "ar"
                  ? "حدث خطأ"
                  : lang === "en"
                    ? "An error occurred"
                    : "Une erreur est survenue";
            }

            if (paragraph) {

              paragraph.textContent =
                lang === "ar"
                  ? "يرجى المحاولة مرة أخرى."
                  : lang === "en"
                    ? "Please try again."
                    : "Veuillez réessayer.";
            }

            successMessage.classList.add(
              "error"
            );

            successMessage.classList.add(
              "show"
            );
          }


          /*
           * Restaurer bouton
           */
          button.disabled = false;

          button.classList.remove(
            "loading"
          );

          if (text) {
            text.textContent =
              originalText;
          }

        }

      });

    });
</script>


<style>

  /* ============================================================
     VARIABLES
  ============================================================= */

  :root {

    --c-primary: #2563EB;
    --c-primary-dark: #1D4ED8;
    --c-primary-light: #EFF6FF;

    --c-accent: #F59E0B;

    --c-dark: #0F172A;
    --c-white: #FFFFFF;

    --c-line: rgba(15, 23, 42, 0.08);

    --c-ink-soft: #475569;

  }


  /* ============================================================
     SECTION
  ============================================================= */

  .request {

    position: relative;

    padding: 100px 0;

    background:
      linear-gradient(
        180deg,
        #FFFFFF 0%,
        #F8FAFC 100%
      );

    overflow: hidden;

  }


  /* ============================================================
     BACKGROUND
  ============================================================= */

  .request-bg {

    position: absolute;

    inset: 0;

    z-index: 0;

    pointer-events: none;

  }


  .bg-shape {

    position: absolute;

    border-radius: 50%;

    opacity: 0.4;

  }


  .shape-1 {

    width: 400px;
    height: 400px;

    background:
      radial-gradient(
        circle,
        rgba(37, 99, 235, 0.08),
        transparent 70%
      );

    top: -100px;
    right: -100px;

  }


  .shape-2 {

    width: 300px;
    height: 300px;

    background:
      radial-gradient(
        circle,
        rgba(245, 158, 11, 0.06),
        transparent 70%
      );

    bottom: -50px;
    left: -50px;

  }


  /* ============================================================
     CONTAINER
  ============================================================= */

  .container {

    position: relative;

    z-index: 1;

    max-width: 1200px;

    margin: 0 auto;

    padding: 0 24px;

  }


  /* ============================================================
     LAYOUT
  ============================================================= */

  .request-wrap {

    display: grid;

    grid-template-columns:
      1fr 1.1fr;

    gap: 64px;

    align-items: start;

  }


  /* ============================================================
     LEFT
  ============================================================= */

  .eyebrow {

    display: inline-block;

    font-size: 0.875rem;

    font-weight: 700;

    color:
      var(--c-primary);

    text-transform:
      uppercase;

    letter-spacing:
      0.05em;

    margin-bottom: 12px;

  }


  .request-title {

    font-size:
      clamp(
        2rem,
        4vw,
        2.75rem
      );

    font-weight: 800;

    letter-spacing:
      -0.025em;

    color:
      var(--c-dark);

    margin:
      0 0 16px;

    line-height: 1.1;

  }


  .request-subtitle {

    font-size: 1.1rem;

    color:
      var(--c-ink-soft);

    margin:
      0 0 40px;

    line-height: 1.6;

    max-width: 480px;

  }


  /* ============================================================
     FEATURES
  ============================================================= */

  .request-features {

    display: flex;

    flex-direction: column;

    gap: 20px;

    margin-bottom: 40px;

  }


  .feat {

    display: flex;

    gap: 16px;

    align-items: flex-start;

  }


  .feat-icon {

    width: 36px;
    height: 36px;

    border-radius: 10px;

    background:
      var(--c-primary-light);

    color:
      var(--c-primary);

    display: grid;

    place-items: center;

    flex-shrink: 0;

  }


  .feat-icon svg {

    width: 18px;
    height: 18px;

  }


  .feat strong {

    display: block;

    font-weight: 700;

    color:
      var(--c-dark);

    margin-bottom: 4px;

    font-size: 1rem;

  }


  .feat p {

    margin: 0;

    font-size: 0.925rem;

    color:
      var(--c-ink-soft);

    line-height: 1.5;

  }


  /* ============================================================
     WHATSAPP
  ============================================================= */

  .request-alt {

    padding: 24px;

    background:
      var(--c-primary-light);

    border:
      1px solid
      rgba(
        37,
        99,
        235,
        0.15
      );

    border-radius: 16px;

  }


  .request-alt p {

    margin:
      0 0 16px;

    font-size: 0.95rem;

    font-weight: 600;

    color:
      var(--c-dark);

  }


  /* ============================================================
     FORM CONTAINER
  ============================================================= */

  .form-container {

    position: relative;

  }


  /* ============================================================
     SUCCESS MESSAGE
  ============================================================= */

  .success-message {

    display: flex;

    align-items: center;

    gap: 14px;

    width: 100%;

    box-sizing: border-box;

    padding: 16px 18px;

    margin-bottom: 18px;

    border-radius: 14px;

    background:
      #ECFDF5;

    border:
      1px solid
      #A7F3D0;

    color:
      #065F46;

    opacity: 0;

    visibility: hidden;

    transform:
      translateY(-10px);

    max-height: 0;

    overflow: hidden;

    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      max-height 0.35s ease,
      visibility 0.3s ease,
      margin 0.35s ease;

  }


  .success-message.show {

    opacity: 1;

    visibility: visible;

    transform:
      translateY(0);

    max-height: 150px;

  }


  .success-message.error {

    background:
      #FEF2F2;

    border-color:
      #FECACA;

    color:
      #991B1B;

  }


  .success-icon {

    width: 40px;
    height: 40px;

    flex-shrink: 0;

    border-radius: 50%;

    background:
      #D1FAE5;

    display: grid;

    place-items: center;

  }


  .success-message.error
    .success-icon {

    background:
      #FEE2E2;

  }


  .success-icon svg {

    width: 21px;
    height: 21px;

  }


  .success-content {

    flex: 1;

    min-width: 0;

  }


  .success-content strong {

    display: block;

    font-size: 0.95rem;

    font-weight: 700;

    margin-bottom: 3px;

  }


  .success-content p {

    margin: 0;

    font-size: 0.85rem;

    line-height: 1.4;

    opacity: 0.85;

  }


  .success-close {

    width: 30px;
    height: 30px;

    border: none;

    background: transparent;

    color: currentColor;

    font-size: 24px;

    line-height: 1;

    cursor: pointer;

    opacity: 0.6;

    display: grid;

    place-items: center;

    flex-shrink: 0;

  }


  .success-close:hover {

    opacity: 1;

  }


  /* ============================================================
     FORM
  ============================================================= */

  .request-form {

    background:
      var(--c-white);

    border-radius: 20px;

    padding: 40px;

    border:
      1px solid
      var(--c-line);

    box-shadow:
      0 20px 40px -12px
      rgba(
        37,
        99,
        235,
        0.08
      ),
      0 8px 16px -8px
      rgba(
        15,
        23,
        42,
        0.04
      );

    display: grid;

    grid-template-columns:
      1fr 1fr;

    gap: 20px;

  }


  /* ============================================================
     FIELD
  ============================================================= */

  .field {

    display: flex;

    flex-direction: column;

    gap: 8px;

  }


  .field-full {

    grid-column:
      1 / -1;

  }


  .field label {

    font-size:
      0.875rem;

    font-weight: 600;

    color:
      var(--c-dark);

  }


  .field input,
  .field select,
  .field textarea {

    padding:
      14px 16px;

    border:
      1.5px solid
      var(--c-line);

    border-radius:
      12px;

    font-family:
      inherit;

    font-size:
      0.95rem;

    background:
      #FAFBFC;

    color:
      var(--c-dark);

    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;

    min-height:
      48px;

    box-sizing:
      border-box;

  }


  .field textarea {

    resize: vertical;

    min-height:
      110px;

  }


  .field input::placeholder,
  .field textarea::placeholder {

    color:
      #94A3B8;

  }


  .field input:focus,
  .field select:focus,
  .field textarea:focus {

    outline: none;

    border-color:
      var(--c-primary);

    background:
      var(--c-white);

    box-shadow:
      0 0 0 4px
      rgba(
        37,
        99,
        235,
        0.12
      );

  }


  /* ============================================================
     SUBMIT
  ============================================================= */

  .submit-btn {

    grid-column:
      1 / -1;

    padding:
      16px 28px;

    font-size:
      1rem;

    font-weight:
      600;

    margin-top:
      8px;

    background:
      var(--c-primary);

    color:
      var(--c-white);

    border:
      none;

    border-radius:
      12px;

    cursor:
      pointer;

    display:
      inline-flex;

    align-items:
      center;

    justify-content:
      center;

    gap:
      10px;

    box-shadow:
      0 10px 24px -8px
      rgba(
        37,
        99,
        235,
        0.5
      );

    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      background 0.25s ease;

  }


  .submit-btn:hover {

    background:
      var(--c-primary-dark);

    transform:
      translateY(-2px);

    box-shadow:
      0 14px 30px -8px
      rgba(
        37,
        99,
        235,
        0.6
      );

  }


  .submit-btn:disabled {

    opacity:
      0.7;

    cursor:
      not-allowed;

    transform:
      none;

  }


  .submit-btn.loading {

    cursor:
      wait;

  }


  .btn-icon svg {

    width: 18px;
    height: 18px;

  }


  /* ============================================================
     RESPONSIVE TABLET
  ============================================================= */

  @media (max-width: 960px) {

    .request-wrap {

      grid-template-columns:
        1fr;

      gap:
        48px;

    }


    .request-subtitle {

      max-width:
        100%;

    }

  }


  /* ============================================================
     RESPONSIVE MOBILE
  ============================================================= */

