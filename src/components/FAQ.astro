---
import { t, type Lang } from "../lib/i18n";
import { icons } from "../lib/icons";

interface Props {
  lang?: Lang;
  title?: string;
  subtitle?: string;
}

const { lang = "fr", title, subtitle } = Astro.props;

const FAQS = {
  fr: [
    { q: "Comment demander un technicien ?", a: "Remplissez le formulaire ou contactez-nous via WhatsApp en décrivant votre besoin. Nous vous mettons en relation avec un technicien vérifié sous 15 minutes." },
    { q: "Combien coûte l'intervention ?", a: "Le diagnostic et la mise en relation sont gratuits. Le prix de l'intervention est communiqué par le technicien après évaluation, avant toute action." },
    { q: "Dans quelles villes intervenez-vous ?", a: "Nous couvrons la majorité des grandes villes du Maroc : Tanger, Tétouan, Casablanca, Rabat, Marrakech, Fès, Agadir et bien d'autres." },
    { q: "Comment fonctionne la demande via WhatsApp ?", a: "Envoyez-nous un message avec le service souhaité, votre ville et une brève description. Un conseiller vous répond rapidement avec un devis et un technicien disponible." },
    { q: "Les techniciens sont-ils vérifiés ?", a: "Oui. Chaque technicien est vérifié (identité, compétences, références) avant d'être ajouté à la plateforme." },
    { q: "Quels types de services proposez-vous ?", a: "Plus de 19 services : plomberie, électricité, climatisation, carrelage, peinture, menuiserie, serrurerie, nettoyage, rénovation et bien plus." },
  ],
  ar: [
    { q: "كيف أطلب تقنيا؟", a: "املأ النموذج أو تواصل معنا عبر واتساب مع وصف احتياجك. نربطك بتقني موثق خلال 15 دقيقة." },
    { q: "كم تكلفة التدخل؟", a: "التشخيص والربط مجانيان. يتم إعلامك بسعر التدخل من طرف التقني بعد التقييم، قبل أي عمل." },
    { q: "في أي مدن تتدخلون؟", a: "نغطي معظم المدن الكبرى في المغرب: طنجة، تطوان، الدار البيضاء، الرباط، مراكش، فاس، أكادير وغيرها." },
    { q: "كيف يعمل الطلب عبر واتساب؟", a: "أرسل لنا رسالة بالخدمة المطلوبة، مدينتك ووصفا مختصرا. يرد عليك مستشار بسرعة مع عرض سعر وتقني متاح." },
    { q: "هل التقنيون موثقون؟", a: "نعم. يتم التحقق من كل تقني (الهوية، الكفاءة، المراجع) قبل إضافته إلى المنصة." },
    { q: "ما أنواع الخدمات التي تقدمونها؟", a: "أكثر من 19 خدمة: السباكة، الكهرباء، التكييف، البلاط، الدهان، النجارة، الإقفال، التنظيف، التجديد وغيرها." },
  ],
  en: [
    { q: "How do I request a technician?", a: "Fill out the form or contact us via WhatsApp describing your need. We connect you with a verified technician within 15 minutes." },
    { q: "How much does the intervention cost?", a: "Diagnosis and connection are free. The price is communicated by the technician after assessment, before any work." },
    { q: "In which cities do you operate?", a: "We cover most major Moroccan cities: Tangier, Tetouan, Casablanca, Rabat, Marrakech, Fes, Agadir and more." },
    { q: "How does the WhatsApp request work?", a: "Send us a message with the service, your city and a short description. An advisor quickly replies with a quote and an available technician." },
    { q: "Are the technicians verified?", a: "Yes. Every technician is verified (ID, skills, references) before being added to the platform." },
    { q: "What types of services do you offer?", a: "Over 19 services: plumbing, electricity, AC, tiling, painting, carpentry, locksmith, cleaning, renovation and more." },
  ],
};

const items = FAQS[lang];
---

<section id="faq" class="section faq">
  <div class="container">
    <header class="section-head">
      <span class="eyebrow">{t(lang, "nav.faq")}</span>
      <h2 class="section-title">{title ?? t(lang, "faq.title")}</h2>
      <p class="section-subtitle">{subtitle ?? t(lang, "faq.subtitle")}</p>
    </header>

    <div class="faq-list">
      {items.map((item, i) => (
        <details class="faq-item" data-faq>
          <summary class="faq-q">
            <span>{item.q}</span>
            <span class="faq-icon" set:html={icons.chevron}></span>
          </summary>
          <div class="faq-a"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  // Accordéon léger : un seul ouvert à la fois (optionnel, UX premium)
  document.querySelectorAll<HTMLDetailsElement>("[data-faq]").forEach((el) => {
    el.addEventListener("toggle", () => {
      if (el.open) {
        document.querySelectorAll<HTMLDetailsElement>("[data-faq]").forEach((other) => {
          if (other !== el && other.open) other.open = false;
        });
      }
    });
  });
</script>

<style>
  .faq { background: var(--color-surface); }
  .faq-list {
    max-width: 780px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .faq-item {
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color .2s, box-shadow .2s;
  }
  .faq-item[open] {
    border-color: rgba(11, 94, 107, 0.3);
    box-shadow: var(--shadow-sm);
  }
  .faq-q {
    list-style: none;
    cursor: pointer;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-ink);
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-icon {
    width: 20px; height: 20px;
    color: var(--color-primary);
    transition: transform .25s ease;
    flex-shrink: 0;
  }
  .faq-item[open] .faq-icon { transform: rotate(180deg); }
  .faq-a {
    padding: 0 24px 22px;
    color: var(--color-ink-soft);
    line-height: 1.65;
    animation: fade .25s ease;
  }
  .faq-a p { margin: 0; }
  @keyframes fade {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (max-width: 560px) {
    .faq-q { padding: 16px 18px; font-size: 0.95rem; }
    .faq-a { padding: 0 18px 18px; }
  }
</style>