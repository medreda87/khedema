---
// src/pages/[lang]/contact.astro

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  lang?: "fr" | "ar" | "en";
  currentPath?: string;
}

const formspreeEndpoint = "https://formspree.io/f/mgaeepyr";

const { lang = "fr", currentPath = "/contact" } = Astro.props;

// ============================================================
// ICON SYSTEM
// ============================================================

function icon(
  name: string,
  size: number = 24,
  className: string = ""
): string {
  const icons: Record<string, string> = {
    phone: `
      <svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="${className}">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67 A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81 a2 2 0 0 1-.45 2.11L8.09 9.91 a16 16 0 0 0 6 6l1.27-1.27 a2 2 0 0 1 2.11-.45 c.907.339 1.85.573 2.81.7 A2 2 0 0 1 22 16.92z" />
      </svg>
    `,
    mail: `
      <svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="${className}">
        <rect x="2" y="4" width="20" height="16" rx="2"/>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
      </svg>
    `,
    "map-pin": `
      <svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="${className}">
        <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/>
        <circle cx="12" cy="10" r="3"/>
      </svg>
    `,
    "check-circle": `
      <svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="${className}">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
    `,
    "arrow-right": `
      <svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
        <line x1="5" y1="12" x2="19" y2="12"/>
        <polyline points="12 5 19 12 12 19"/>
      </svg>
    `,
    clock: `
      <svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="${className}">
        <circle cx="12" cy="12" r="9"/>
        <polyline points="12 7 12 12 15 14"/>
      </svg>
    `,
    send: `
      <svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="${className}">
        <path d="m22 2-7 20-4-9-9-4Z"/>
        <path d="M22 2 11 13"/>
      </svg>
    `
  };

  return icons[name] || "";
}

// ============================================================
// MULTILINGUAL CONTENT
// ============================================================

const contactContent = {
  fr: {
    badge: "Contact",
    title: "Parlons de votre projet",
    desc: "Une question ou besoin d'un professionnel ? Notre équipe à Tanger est là pour vous accompagner.",
    formTitle: "Envoyez-nous votre demande",
    formSubtitle: "Décrivez-nous votre besoin et nous vous recontacterons rapidement.",
    name: "Nom complet",
    namePlaceholder: "Votre nom complet",
    phone: "Téléphone",
    phonePlaceholder: "06 00 00 00 00",
    email: "Adresse email",
    emailPlaceholder: "vous@exemple.com",
    service: "Service souhaité",
    servicePlaceholder: "Sélectionnez un service",
    serviceOptions: ["Plomberie", "Électricité", "Peinture", "Carrelage", "Climatisation", "Menuiserie", "Autre"],
    message: "Votre message",
    messagePlaceholder: "Décrivez votre besoin, la surface, l'urgence...",
    submit: "Envoyer ma demande",
    success: "Demande envoyée avec succès !",
    successDesc: "Nous reviendrons vers vous dans les plus brefs délais.",
    error: "Une erreur est survenue. Veuillez réessayer.",
    infoTitle: "Nos coordonnées",
    infoDesc: "Notre équipe est disponible pour répondre à vos questions et vous accompagner.",
    phoneLabel: "Téléphone",
    emailLabel: "Email",
    locationLabel: "Zone d'intervention",
    location: "Tanger et périphérie, Maroc",
    availability: "Lundi – Samedi",
    availabilityTime: "09:00 – 18:00",
    trust: "Réponse garantie sous 24h",
    privacy: "Vos informations restent confidentielles."
  },
  ar: {
    badge: "اتصل بنا",
    title: "لنتحدث عن مشروعك",
    desc: "لديك سؤال أو تحتاج إلى حرفي؟ فريقنا في طنجة موجود لمساعدتك.",
    formTitle: "أرسل طلبك إلينا",
    formSubtitle: "اشرح لنا احتياجاتك وسنعاود الاتصال بك في أقرب وقت.",
    name: "الاسم الكامل",
    namePlaceholder: "أدخل اسمك الكامل",
    phone: "رقم الهاتف",
    phonePlaceholder: "06 00 00 00 00",
    email: "البريد الإلكتروني",
    emailPlaceholder: "name@example.com",
    service: "الخدمة المطلوبة",
    servicePlaceholder: "اختر الخدمة",
    serviceOptions: ["السباكة", "الكهرباء", "الدهان", "التبليط", "التكييف", "النجارة", "أخرى"],
    message: "رسالتك",
    messagePlaceholder: "اشرح احتياجاتك، المساحة، أو مدى الاستعجال...",
    submit: "إرسال طلبي",
    success: "تم إرسال الطلب بنجاح!",
    successDesc: "سنتواصل معك في أقرب وقت ممكن.",
    error: "حدث خطأ. يرجى المحاولة مرة أخرى.",
    infoTitle: "معلومات الاتصال",
    infoDesc: "فريقنا متاح للإجابة على أسئلتك ومساعدتك.",
    phoneLabel: "الهاتف",
    emailLabel: "البريد الإلكتروني",
    locationLabel: "منطقة التدخل",
    location: "طنجة وضواحيها، المغرب",
    availability: "الإثنين – السبت",
    availabilityTime: "09:00 – 18:00",
    trust: "رد مضمون في غضون 24 ساعة",
    privacy: "معلوماتك الشخصية تبقى سرية."
  },
  en: {
    badge: "Contact",
    title: "Let's talk about your project",
    desc: "Have a question or need a professional? Our Tangier team is here to help.",
    formTitle: "Send us your request",
    formSubtitle: "Tell us what you need and we'll get back to you shortly.",
    name: "Full name",
    namePlaceholder: "Your full name",
    phone: "Phone number",
    phonePlaceholder: "06 00 00 00 00",
    email: "Email address",
    emailPlaceholder: "you@example.com",
    service: "Service needed",
    servicePlaceholder: "Select a service",
    serviceOptions: ["Plumbing", "Electricity", "Painting", "Tiling", "Air conditioning", "Carpentry", "Other"],
    message: "Your message",
    messagePlaceholder: "Describe your needs, surface area, urgency...",
    submit: "Send my request",
    success: "Request sent successfully!",
    successDesc: "We'll get back to you as soon as possible.",
    error: "An error occurred. Please try again.",
    infoTitle: "Contact information",
    infoDesc: "Our team is available to answer your questions and assist you.",
    phoneLabel: "Phone",
    emailLabel: "Email",
    locationLabel: "Service area",
    location: "Tangier and surroundings, Morocco",
    availability: "Monday – Saturday",
    availabilityTime: "09:00 – 18:00",
    trust: "Guaranteed response within 24h",
    privacy: "Your information remains confidential."
  }
};

const content = contactContent[lang] || contactContent.fr;
const isRTL = lang === "ar";
---

<Layout lang={lang} currentPath={currentPath}>
  <Header lang={lang} />

  <main class="contact-page" dir={isRTL ? "rtl" : "ltr"}>

    <!-- ========================================================
         BACKGROUND
    ========================================================= -->
    <div class="background-decoration">
      <div class="orb orb-one"></div>
      <div class="orb orb-two"></div>
      <div class="grid-pattern"></div>
    </div>

    <div class="container">

      <!-- ======================================================
           HERO
      ====================================================== -->
      <section class="page-header">
        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          {content.badge}
        </div>
        <h1 class="page-title">{content.title}</h1>
        <p class="page-desc">{content.desc}</p>
      </section>

      <!-- ======================================================
           CONTACT GRID
      ====================================================== -->
      <section class="contact-grid">

        <!-- ====================================================
             CONTACT INFORMATION
        ==================================================== -->
        <aside class="contact-info">
          <div class="info-top">
            <span class="info-kicker">{content.infoTitle}</span>
            <h2 class="info-title">{content.infoDesc}</h2>
          </div>

          <!-- PHONE -->
          <a href="tel:+212716885441" class="contact-item">
            <span class="contact-icon" set:html={icon("phone", 21)}></span>
            <span class="contact-item-content">
              <span class="contact-label">{content.phoneLabel}</span>
              <span class="contact-value">+212 7 16 88 54 41</span>
            </span>
            <span class="item-arrow">{isRTL ? "←" : "→"}</span>
          </a>

          <!-- EMAIL -->
          <a href="mailto:allomealem@gmail.com" class="contact-item">
            <span class="contact-icon" set:html={icon("mail", 21)}></span>
            <span class="contact-item-content">
              <span class="contact-label">{content.emailLabel}</span>
              <span class="contact-value">allomealem@gmail.com</span>
            </span>
            <span class="item-arrow">{isRTL ? "←" : "→"}</span>
          </a>

          <!-- LOCATION -->
          <div class="contact-item">
            <span class="contact-icon" set:html={icon("map-pin", 21)}></span>
            <span class="contact-item-content">
              <span class="contact-label">{content.locationLabel}</span>
              <span class="contact-value">{content.location}</span>
            </span>
          </div>

          <!-- AVAILABILITY -->
          <div class="availability-box">
            <span class="availability-icon" set:html={icon("clock", 19)}></span>
            <div>
              <span class="availability-label">{content.availability}</span>
              <strong>{content.availabilityTime}</strong>
            </div>
          </div>

          <!-- TRUST -->
          <div class="trust-box">
            <span class="trust-icon" set:html={icon("check-circle", 20)}></span>
            <div>
              <strong>{content.trust}</strong>
              <span>{content.privacy}</span>
            </div>
          </div>
        </aside>

        <!-- ====================================================
             FORM
        ==================================================== -->
        <div class="form-wrapper">
          <div class="form-header">
            <div class="form-icon">
              <span set:html={icon("send", 20)}></span>
            </div>
            <div>
              <h2 class="form-title">{content.formTitle}</h2>
              <p class="form-subtitle">{content.formSubtitle}</p>
            </div>
          </div>

          <!-- ==================================================
               CONTACT FORM
          ================================================== -->
          <form id="contactForm" class="contact-form" method="POST" action={formspreeEndpoint}>

            <!-- NAME + PHONE -->
            <div class="form-row">
              <div class="form-group">
                <label for="name">{content.name}</label>
                <input type="text" id="name" name="name" placeholder={content.namePlaceholder} autocomplete="name" required minlength="2" maxlength="100" />
              </div>

              <div class="form-group">
                <label for="phone">{content.phone}</label>
                <input type="tel" id="phone" name="phone" placeholder={content.phonePlaceholder} autocomplete="tel" inputmode="tel" maxlength="20" required />
              </div>
            </div>

            <!-- EMAIL -->
            <div class="form-group">
              <label for="email">{content.email}</label>
              <input type="email" id="email" name="email" placeholder={content.emailPlaceholder} autocomplete="email" maxlength="150" required />
            </div>

            <!-- SERVICE -->
            <div class="form-group">
              <label for="service">{content.service}</label>
              <div class="select-wrapper">
                <select id="service" name="service" required>
                  <option value="" disabled selected>{content.servicePlaceholder}</option>
                  {content.serviceOptions.map((option: string) => (
                    <option value={option}>{option}</option>
                  ))}
                </select>
                <span class="select-arrow">↓</span>
              </div>
            </div>

            <!-- MESSAGE -->
            <div class="form-group">
              <label for="message">{content.message}</label>
              <textarea id="message" name="message" rows="5" maxlength="1000" placeholder={content.messagePlaceholder} required></textarea>
              <span class="textarea-counter">
                <span id="messageCount">0</span> / 1000
              </span>
            </div>

            <!-- HIDDEN SUBJECT -->
            <input type="hidden" name="_subject" value="Nouvelle demande de contact - AlloMealem" />

            <!-- SUBMIT -->
            <button type="submit" class="submit-button">
              <span class="submit-text">{content.submit}</span>
              <span class="submit-loading" aria-hidden="true">
                <svg class="spinner" viewBox="0 0 24 24" width="19" height="19">
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" fill="none" stroke-dasharray="42" stroke-linecap="round" />
                </svg>
              </span>
              <span class="submit-icon" set:html={icon("arrow-right", 18)}></span>
            </button>

            <!-- SUCCESS -->
            <div class="form-state form-success" id="successState" role="status" aria-live="polite">
              <span class="state-icon" set:html={icon("check-circle", 27)}></span>
              <div>
                <strong>{content.success}</strong>
                <p>{content.successDesc}</p>
              </div>
            </div>

            <!-- ERROR -->
            <div class="form-state form-error" id="errorState" role="alert" aria-live="assertive">
              <strong>⚠️ {content.error}</strong>
            </div>

          </form>
        </div>

      </section>
    </div>
  </main>

  <Footer lang={lang} />

  <!-- ==========================================================
       FORM JAVASCRIPT
  =========================================================== -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById("contactForm") as HTMLFormElement | null;
      if (!form) return;

      const submitBtn = form.querySelector(".submit-button") as HTMLButtonElement | null;
      const submitText = form.querySelector(".submit-text") as HTMLElement | null;
      const submitLoading = form.querySelector(".submit-loading") as HTMLElement | null;
      const submitIcon = form.querySelector(".submit-icon") as HTMLElement | null;
      const successState = form.querySelector(".form-success") as HTMLElement | null;
      const errorState = form.querySelector(".form-error") as HTMLElement | null;
      const message = document.getElementById("message") as HTMLTextAreaElement | null;
      const messageCount = document.getElementById("messageCount") as HTMLElement | null;
      const phone = document.getElementById("phone") as HTMLInputElement | null;

      if (message && messageCount) {
        message.addEventListener("input", () => {
          messageCount.textContent = String(message.value.length);
        });
      }

      if (phone) {
        phone.addEventListener("input", () => {
          phone.value = phone.value.replace(/[^\d+ ]/g, "").slice(0, 20);
        });
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (successState) {
          successState.style.display = "none";
          successState.classList.remove("visible");
        }
        if (errorState) {
          errorState.style.display = "none";
          errorState.classList.remove("visible");
        }

        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        if (phone) {
          const cleanPhone = phone.value.replace(/\D/g, "");
          if (cleanPhone.length < 9 || cleanPhone.length > 15) {
            phone.setCustomValidity("Veuillez entrer un numéro de téléphone valide.");
            form.reportValidity();
            phone.setCustomValidity("");
            return;
          }
          phone.setCustomValidity("");
        }

        if (submitBtn) submitBtn.disabled = true;
        if (submitText) submitText.style.display = "none";
        if (submitLoading) submitLoading.style.display = "flex";
        if (submitIcon) submitIcon.style.display = "none";

        try {
          const formData = new FormData(form);
          const response = await fetch(form.action, {
            method: "POST",
            body: formData,
            headers: { Accept: "application/json" }
          });

          if (!response.ok) {
            let errorMessage = "Formspree request failed";
            try {
              const data = await response.json();
              if (data && Array.isArray(data.errors) && data.errors.length > 0) {
                errorMessage = data.errors.map((error: { message?: string }) => error.message || "").join(", ");
              }
            } catch { /* Ignore JSON parsing errors */ }
            throw new Error(errorMessage);
          }

          if (successState) {
            successState.style.display = "flex";
            requestAnimationFrame(() => successState.classList.add("visible"));
          }

          form.reset();
          if (messageCount) messageCount.textContent = "0";

          if (successState) {
            successState.scrollIntoView({ behavior: "smooth", block: "nearest" });
          }

        } catch (error) {
          console.error("Formspree error:", error);
          if (errorState) {
            errorState.style.display = "flex";
            requestAnimationFrame(() => errorState.classList.add("visible"));
            errorState.scrollIntoView({ behavior: "smooth", block: "nearest" });
          }
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (submitText) submitText.style.display = "inline";
          if (submitLoading) submitLoading.style.display = "none";
          if (submitIcon) submitIcon.style.display = "flex";
        }
      });
    });
  </script>
</Layout>

<style>
/* ============================================================
   DESIGN TOKENS
============================================================ */
:root {
  --primary: #2563eb;
  --primary-dark: #1d4ed8;
  --primary-soft: #eff6ff;
  --navy: #0b1220;
  --navy-light: #111b2e;
  --text: #172033;
  --text-soft: #64748b;
  --text-muted: #94a3b8;
  --bg: #f8fafc;
  --white: #ffffff;
  --border: #e5e7eb;
  --success: #059669;
  --danger: #dc2626;
  --radius-xl: 28px;
  --radius-lg: 20px;
  --radius-md: 14px;
  --shadow-card: 0 20px 60px rgba(15, 23, 42, 0.08);
  --transition: 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  font-family: "Inter", "Plus Jakarta Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

/* ============================================================
   PAGE
============================================================ */
.contact-page {
  position: relative;
  min-height: 100vh;
  padding-top: calc(var(--header-h, 76px) + 70px);
  padding-bottom: 100px;
  background: linear-gradient(180deg, #ffffff 0%, #f8fafc 55%, #f8fafc 100%);
  overflow-x: hidden;
}

/* ============================================================
   BACKGROUND
============================================================ */
.background-decoration {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.orb {
  position: absolute;
  width: 420px;
  height: 420px;
  border-radius: 50%;
  filter: blur(90px);
  opacity: 0.22;
}

.orb-one { top: 80px; left: -220px; background: #dbeafe; }
.orb-two { right: -220px; top: 450px; background: #e0e7ff; }

.grid-pattern {
  position: absolute;
  inset: 0;
  opacity: 0.28;
  background-image:
    linear-gradient(rgba(15, 23, 42, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(15, 23, 42, 0.035) 1px, transparent 1px);
  background-size: 45px 45px;
  mask-image: linear-gradient(to bottom, black, transparent 75%);
}

/* ============================================================
   CONTAINER
============================================================ */
.container {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ============================================================
   HERO
============================================================ */
.page-header {
  max-width: 720px;
  margin: 0 auto 58px;
  text-align: center;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 7px 14px;
  margin-bottom: 18px;
  border: 1px solid #dbeafe;
  border-radius: 999px;
  background: rgba(239, 246, 255, 0.9);
  color: var(--primary);
  font-size: 12px;
  font-weight: 750;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.eyebrow-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--primary);
  box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
}

.page-title {
  margin: 0;
  color: var(--navy);
  font-size: clamp(38px, 5vw, 58px);
  line-height: 1.05;
  letter-spacing: -0.045em;
  font-weight: 800;
}

.page-desc {
  max-width: 620px;
  margin: 20px auto 0;
  color: var(--text-soft);
  font-size: 17px;
  line-height: 1.7;
}

/* ============================================================
   MAIN GRID
============================================================ */
.contact-grid {
  display: grid;
  grid-template-columns: minmax(300px, 0.85fr) minmax(0, 1.4fr);
  gap: 32px;
  align-items: stretch;
}

/* ============================================================
   CONTACT INFO
============================================================ */
.contact-info {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 650px;
  padding: 36px 30px;
  border-radius: var(--radius-xl);
  background: linear-gradient(145deg, #0b1220 0%, #111b2e 100%);
  color: white;
  overflow: hidden;
  box-shadow: 0 25px 70px rgba(15, 23, 42, 0.16);
}

.contact-info::before {
  content: "";
  position: absolute;
  width: 300px;
  height: 300px;
  right: -140px;
  top: -140px;
  border-radius: 50%;
  background: rgba(37, 99, 235, 0.18);
  filter: blur(10px);
}

.contact-info::after {
  content: "";
  position: absolute;
  width: 220px;
  height: 220px;
  left: -140px;
  bottom: -100px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.info-top { position: relative; z-index: 1; margin-bottom: 30px; }

.info-kicker {
  display: block;
  margin-bottom: 12px;
  color: rgba(255,255,255,0.5);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.info-title {
  max-width: 330px;
  margin: 0;
  color: white;
  font-size: 23px;
  line-height: 1.4;
  letter-spacing: -0.02em;
  font-weight: 650;
}

/* ============================================================
   CONTACT ITEMS
============================================================ */
.contact-item {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 14px;
  min-height: 76px;
