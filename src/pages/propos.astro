---
// src/pages/[lang]/about.astro
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { Lang } from "../../lib/i18n";

export interface Props {
  lang?: Lang;
}

const { lang = "fr" } = Astro.props;

// ============================================================
//  TRADUCTIONS
// ============================================================
const t = {
  hero: {
    badge: { fr: "À PROPOS DE AlloMealem", ar: "حول مايهاندي", en: "ABOUT AlloMealem" },
    title: { fr: "Des professionnels de confiance, près de chez vous.", ar: "محترفون موثوقون، بالقرب منك.", en: "Trusted professionals, close to you." },
    desc: { fr: "AlloMealem simplifie la recherche de professionnels qualifiés pour vos travaux et besoins à domicile à Tanger et ses environs.", ar: "AlloMealem يبسط البحث عن محترفين مؤهلين لأعمالك واحتياجاتك المنزلية في طنجة والمناطق المحيطة بها.", en: "AlloMealem simplifies the search for qualified professionals for your home projects and needs in Tangier and surrounding areas." },
    ctaPrimary: { fr: "Trouver un professionnel", ar: "ابحث عن محترف", en: "Find a professional" },
    ctaSecondary: { fr: "Découvrir nos services", ar: "اكتشف خدماتنا", en: "Discover our services" },
  },
  mission: {
    badge: { fr: "NOTRE MISSION", ar: "مهمتنا", en: "OUR MISSION" },
    title: { fr: "Faciliter l'accès à des professionnels fiables", ar: "تسهيل الوصول إلى محترفين موثوقين", en: "Making access to reliable professionals easier" },
    p1: { fr: "Trouver un bon professionnel ne devrait pas être compliqué. AlloMealem a été pensé pour faciliter cette recherche et permettre aux particuliers de trouver plus simplement les compétences dont ils ont besoin, au bon endroit.", ar: "العثور على محترف جيد لا ينبغي أن يكون معقداً. تم تصميم AlloMealem لتسهيل هذا البحث وتمكين الأفراد من العثور ببساطة أكبر على المهارات التي يحتاجونها، في المكان المناسب.", en: "Finding a good professional shouldn't be complicated. AlloMealem was designed to make this search easier and to allow individuals to find the skills they need, in the right place, more simply." },
    p2: { fr: "Notre objectif est de créer une expérience simple, transparente et rassurante, aussi bien pour les clients que pour les professionnels.", ar: "هدفنا هو خلق تجربة بسيطة وشفافة ومطمئنة، سواء للعملاء أو للمحترفين.", en: "Our goal is to create a simple, transparent and reassuring experience, both for clients and professionals." },
    cards: {
      verified: { fr: "Professionnels vérifiés", ar: "محترفون معتمدون", en: "Verified professionals" },
      local: { fr: "Services locaux", ar: "خدمات محلية", en: "Local services" },
      rapid: { fr: "Réponse rapide", ar: "استجابة سريعة", en: "Rapid response" },
    },
  },
  why: {
    title: { fr: "Pourquoi choisir AlloMealem ?", ar: "لماذا تختار AlloMealem؟", en: "Why choose AlloMealem?" },
    items: [
      { title: { fr: "Des professionnels locaux", ar: "محترفون محليون", en: "Local professionals" }, desc: { fr: "Des artisans et professionnels disponibles à Tanger et ses environs.", ar: "حرفيون ومحترفون متوفرون في طنجة والمناطق المحيطة بها.", en: "Artisans and professionals available in Tangier and surrounding areas." } },
      { title: { fr: "Une recherche simple", ar: "بحث بسيط", en: "Simple search" }, desc: { fr: "Trouvez rapidement le service adapté à votre besoin.", ar: "ابحث بسرعة عن الخدمة المناسبة لاحتياجك.", en: "Quickly find the service that fits your need." } },
      { title: { fr: "Un accompagnement humain", ar: "مرافقة إنسانية", en: "Human support" }, desc: { fr: "Une équipe disponible pour vous aider lorsque vous en avez besoin.", ar: "فريق متاح لمساعدتك عندما تحتاج ذلك.", en: "A team available to help you when you need it." } },
      { title: { fr: "Une approche basée sur la confiance", ar: "نهج قائم على الثقة", en: "Trust-based approach" }, desc: { fr: "Nous voulons construire une relation durable entre particuliers et professionnels.", ar: "نريد بناء علاقة دائمة بين الأفراد والمحترفين.", en: "We want to build a lasting relationship between individuals and professionals." } },
    ],
  },
  steps: {
    title: { fr: "Simple, rapide, efficace", ar: "بسيط، سريع، فعّال", en: "Simple, fast, effective" },
    items: [
      { label: "01", title: { fr: "Décrivez votre besoin", ar: "صِف احتياجك", en: "Describe your need" }, desc: { fr: "Expliquez-nous le service dont vous avez besoin.", ar: "اشرح لنا الخدمة التي تحتاجها.", en: "Tell us what service you need." } },
      { label: "02", title: { fr: "Trouvez le bon professionnel", ar: "ابحث عن المحترف المناسب", en: "Find the right professional" }, desc: { fr: "Découvrez les professionnels correspondant à votre demande.", ar: "اكتشف المحترفين المطابقين لطلبك.", en: "Discover professionals matching your request." } },
      { label: "03", title: { fr: "Échangez et choisissez", ar: "تواصل واختر", en: "Exchange and choose" }, desc: { fr: "Prenez contact et choisissez la solution qui vous convient.", ar: "تواصل واختر الحل المناسب لك.", en: "Get in touch and choose the solution that suits you." } },
      { label: "04", title: { fr: "Réalisez votre projet", ar: "نفّذ مشروعك", en: "Complete your project" }, desc: { fr: "Votre professionnel intervient pour réaliser votre projet.", ar: "يتدخل المحترف الخاص بك لتنفيذ مشروعك.", en: "Your professional comes to carry out your project." } },
    ],
  },
  services: {
    title: { fr: "Nos domaines d'intervention", ar: "مجالات تدخلنا", en: "Our areas of expertise" },
    items: [
      { name: { fr: "Plomberie", ar: "السباكة", en: "Plumbing" }, desc: { fr: "Installation, réparation et entretien.", ar: "تركيب، إصلاح وصيانة.", en: "Installation, repair and maintenance." } },
      { name: { fr: "Électricité", ar: "الكهرباء", en: "Electricity" }, desc: { fr: "Câblage, dépannage et mise aux normes.", ar: "الأسلاك، الإصلاح والتحديث.", en: "Wiring, troubleshooting and upgrading." } },
      { name: { fr: "Peinture", ar: "الدهان", en: "Painting" }, desc: { fr: "Peinture intérieure et extérieure, finitions.", ar: "دهان داخلي وخارجي، تشطيبات.", en: "Interior and exterior painting, finishing." } },
      { name: { fr: "Carrelage", ar: "البلاط", en: "Tiling" }, desc: { fr: "Pose de carrelage, faïence et rénovation.", ar: "تركيب البلاط والسيراميك والتجديد.", en: "Tile laying, ceramic and renovation." } },
      { name: { fr: "Climatisation", ar: "التكييف", en: "Air conditioning" }, desc: { fr: "Installation, entretien et réparation.", ar: "تركيب، صيانة وإصلاح.", en: "Installation, maintenance and repair." } },
      { name: { fr: "Menuiserie", ar: "النجارة", en: "Carpentry" }, desc: { fr: "Meubles, agencements et menuiserie sur mesure.", ar: "أثاث، تجهيزات ونجارة حسب الطلب.", en: "Furniture, custom joinery and fittings." } },
    ],
  },
  local: {
    badge: { fr: "LOCAL & PROCHE DE VOUS", ar: "محلي وقريب منك", en: "LOCAL & CLOSE TO YOU" },
    title: { fr: "Une plateforme pensée pour Tanger", ar: "منصة مصممة لطنجة", en: "A platform designed for Tangier" },
    desc: { fr: "AlloMealem commence à Tanger avec une ambition simple : rapprocher les particuliers des professionnels locaux et faciliter l'accès à des services de qualité.", ar: "يبدأ AlloMealem في طنجة بطموح بسيط: تقريب الأفراد من المحترفين المحليين وتسهيل الوصول إلى خدمات عالية الجودة.", en: "AlloMealem starts in Tangier with a simple ambition: to bring individuals closer to local professionals and make it easier to access quality services." },
    stats: {
      city: { fr: "Tanger", ar: "طنجة", en: "Tangier" },
      cityLabel: { fr: "Zone principale", ar: "المنطقة الرئيسية", en: "Main area" },
      categories: { fr: "6+", ar: "٦+", en: "6+" },
      categoriesLabel: { fr: "Catégories de services", ar: "فئات الخدمات", en: "Service categories" },
      response: { fr: "24h", ar: "٢٤ ساعة", en: "24h" },
      responseLabel: { fr: "Délai de réponse", ar: "وقت الاستجابة", en: "Response time" },
    },
  },
  values: {
    title: { fr: "Nos valeurs", ar: "قيمنا", en: "Our values" },
    items: [
      { name: { fr: "Confiance", ar: "الثقة", en: "Trust" }, desc: { fr: "Construire des relations fiables entre clients et professionnels.", ar: "بناء علاقات موثوقة بين العملاء والمحترفين.", en: "Building reliable relationships between clients and professionals." }, icon: "shield" },
      { name: { fr: "Simplicité", ar: "البساطة", en: "Simplicity" }, desc: { fr: "Rendre la recherche et la prise de contact aussi simples que possible.", ar: "جعل البحث والتواصل بأبسط شكل ممكن.", en: "Making search and contact as simple as possible." }, icon: "zap" },
      { name: { fr: "Proximité", ar: "القرب", en: "Proximity" }, desc: { fr: "Valoriser les professionnels locaux et rester proche des besoins de notre communauté.", ar: "تقدير المحترفين المحليين والبقاء قريبين من احتياجات مجتمعنا.", en: "Valuing local professionals and staying close to the needs of our community." }, icon: "map-pin" },
    ],
  },
  cta: {
    title: { fr: "Vous avez un projet ?", ar: "هل لديك مشروع؟", en: "Have a project?" },
    desc: { fr: "Trouvez le professionnel dont vous avez besoin à Tanger et commencez votre projet en toute simplicité.", ar: "ابحث عن المحترف الذي تحتاجه في طنجة وابدأ مشروعك بكل بساطة.", en: "Find the professional you need in Tangier and start your project with ease." },
    primary: { fr: "Trouver un professionnel →", ar: "ابحث عن محترف ←", en: "Find a professional →" },
    secondary: { fr: "Nous contacter", ar: "اتصل بنا", en: "Contact us" },
  },
};

const isRTL = lang === "ar";
const dir = isRTL ? "rtl" : "ltr";
---

<Layout lang={lang} title="À propos - AlloMealem" dir={dir}>
  <main class={`about-page ${isRTL ? 'rtl' : ''}`}>
    <Header lang={lang} />

    <!-- ============================================================ -->
    <!-- 1. HERO (Image agrandie et mise en valeur) -->
    <!-- ============================================================ -->
    <section class="about-hero">
      <div class="about-hero-bg" aria-hidden="true">
        <div class="bg-gradient"></div>
        <div class="bg-shape shape-1"></div>
        <div class="bg-shape shape-2"></div>
      </div>

      <div class="about-hero-inner container">
        <div class="about-hero-copy">
          <div class="badge">
            <span class="badge-dot"></span>
            {t.hero.badge[lang]}
          </div>
          <h1 class="about-hero-title">{t.hero.title[lang]}</h1>
          <p class="about-hero-desc">{t.hero.desc[lang]}</p>
          <div class="about-hero-cta">
            <a href='/contact' class="btn btn-primary">
              {t.hero.ctaPrimary[lang]}
              <span class="btn-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </a>
            <a href='/contact' class="btn btn-secondary">{t.hero.ctaSecondary[lang]}</a>
          </div>
        </div>

        <div class="about-hero-visual">
          <div class="visual-frame">
            <div class="visual-blob" aria-hidden="true"></div>
            <div class="illustration-placeholder">
              <img src="/props1.png" alt="Artisan professionnel AlloMealem" width="620" height="465" loading="eager" />
            </div>
            
            <!-- Icônes flottantes agrandies et élégantes -->
            <div class="floating-icon icon-plumbing" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 12h16M12 4v16M4 4l16 16"/></svg></div>
            <div class="floating-icon icon-electric" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></div>
            <div class="floating-icon icon-paint" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H5.78a1.65 1.65 0 0 0-1.51 1 1.65 1.65 0 0 0 .33 1.82L12 22z"/><path d="M4 10h16"/></svg></div>
            <div class="floating-icon icon-tile" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 2. NOTRE MISSION (Grande image avec cartes en superposition) -->
    <!-- ============================================================ -->
    <section class="mission-section">
      <div class="container mission-grid">
        <div class="mission-text">
          <div class="badge">{t.mission.badge[lang]}</div>
          <h2 class="section-title">{t.mission.title[lang]}</h2>
          <p class="mission-p">{t.mission.p1[lang]}</p>
          <p class="mission-p">{t.mission.p2[lang]}</p>
        </div>
        
        <div class="mission-visual">
          <div class="mission-img-large">
            <img src="/image1.png" alt="Équipe AlloMealem" width="600" height="450" loading="lazy" />
            
            <!-- Cartes flottantes style "Glassmorphism" -->
            <div class="float-card card-1">
              <span class="float-check">✓</span>
              <span class="float-label">{t.mission.cards.verified[lang]}</span>
            </div>
            <div class="float-card card-2">
              <span class="float-check">✓</span>
              <span class="float-label">{t.mission.cards.local[lang]}</span>
            </div>
            <div class="float-card card-3">
              <span class="float-check">✓</span>
              <span class="float-label">{t.mission.cards.rapid[lang]}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 3. POURQUOI AlloMealem -->
    <!-- ============================================================ -->
    <section class="why-section">
      <div class="container">
        <h2 class="section-title text-center">{t.why.title[lang]}</h2>
        <div class="why-grid">
          {t.why.items.map((item, i) => (
            <div class="why-card" key={i}>
              <div class="why-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {i === 0 && <><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></>}
                  {i === 1 && <><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></>}
                  {i === 2 && <><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></>}
                  {i === 3 && <><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></>}
                </svg>
              </div>
              <h3 class="why-title">{item.title[lang]}</h3>
              <p class="why-desc">{item.desc[lang]}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 4. COMMENT ÇA FONCTIONNE -->
    <!-- ============================================================ -->
    <section class="steps-section">
      <div class="container">
        <h2 class="section-title text-center">{t.steps.title[lang]}</h2>
        <div class="steps-timeline">
          {t.steps.items.map((step, i) => (
            <div class="step-item" key={i}>
              <div class="step-number">{step.label}</div>
              <div class="step-content">
                <h4 class="step-title">{step.title[lang]}</h4>
                <p class="step-desc">{step.desc[lang]}</p>
              </div>
              {i < t.steps.items.length - 1 && (
                <div class="step-connector" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 5. NOS DOMAINES D'INTERVENTION -->
    <!-- ============================================================ -->
    <section class="services-section">
      <div class="container">
        <h2 class="section-title text-center">{t.services.title[lang]}</h2>
        <div class="services-grid">
          {t.services.items.map((service, i) => (
            <div class="service-card" key={i}>
              <div class="service-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  {i === 0 && <><path d="M4 12h16M12 4v16M4 4l16 16"/></>}
                  {i === 1 && <><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></>}
                  {i === 2 && <><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H5.78a1.65 1.65 0 0 0-1.51 1 1.65 1.65 0 0 0 .33 1.82L12 22z"/><path d="M4 10h16"/></>}
                  {i === 3 && <><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></>}
                  {i === 4 && <><path d="M12 2v4M12 22v-4M4 12H2M22 12h-2"/><circle cx="12" cy="12" r="3"/></>}
                  {i === 5 && <><path d="M4 4h16v4H4zM4 12h10v4H4zM4 20h16v-4H4z"/></>}
                </svg>
              </div>
              <h4 class="service-name">{service.name[lang]}</h4>
              <p class="service-desc">{service.desc[lang]}</p>
              <a href="#service" class="service-link">
                {lang === "fr" ? "Découvrir" : lang === "ar" ? "اكتشف" : "Discover"}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 6. PLATEFORME PENSÉE POUR TANGER (Visuel agrandi) -->
    <!-- ============================================================ -->
    <section class="local-section">
      <div class="container local-grid">
        <div class="local-text">
          <div class="badge light">{t.local.badge[lang]}</div>
          <h2 class="section-title light">{t.local.title[lang]}</h2>
          <p class="local-desc">{t.local.desc[lang]}</p>
          <div class="local-stats">
            <div class="stat-item">
              <span class="stat-value">{t.local.stats.city[lang]}</span>
              <span class="stat-label">{t.local.stats.cityLabel[lang]}</span>
            </div>
            <div class="stat-item">
              <span class="stat-value">{t.local.stats.categories[lang]}</span>
              <span class="stat-label">{t.local.stats.categoriesLabel[lang]}</span>
            </div>
            <div class="stat-item">
              <span class="stat-value">{t.local.stats.response[lang]}</span>
              <span class="stat-label">{t.local.stats.responseLabel[lang]}</span>
            </div>
          </div>
        </div>
        <div class="local-visual">
          <div class="map-placeholder-large">
            <svg viewBox="0 0 400 400" fill="none" class="map-svg">
              <path d="M80 200 Q150 80 220 140 T350 200 Q280 350 200 280 T80 200Z" stroke="rgba(255,255,255,0.15)" stroke-width="2" fill="rgba(255,255,255,0.03)" />
              <circle cx="200" cy="180" r="6" fill="#2563EB" />
              <circle cx="160" cy="150" r="3" fill="rgba(255,255,255,0.5)" />
              <circle cx="260" cy="130" r="3" fill="rgba(255,255,255,0.5)" />
              <circle cx="280" cy="220" r="3" fill="rgba(255,255,255,0.5)" />
              <circle cx="140" cy="240" r="3" fill="rgba(255,255,255,0.5)" />
            </svg>
            <div class="map-dot dot-1"></div>
            <div class="map-dot dot-2"></div>
            <div class="map-dot dot-3"></div>
            <div class="map-dot dot-4"></div>
            <div class="map-dot dot-5"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 7. NOS VALEURS -->
    <!-- ============================================================ -->
    <section class="values-section">
      <div class="container">
        <h2 class="section-title text-center">{t.values.title[lang]}</h2>
        <div class="values-grid">
          {t.values.items.map((value, i) => (
            <div class="value-card" key={i}>
              <div class="value-icon">
                {value.icon === "shield" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>}
                {value.icon === "zap" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>}
                {value.icon === "map-pin" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>}
              </div>
              <h3 class="value-name">{value.name[lang]}</h3>
              <p class="value-desc">{value.desc[lang]}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 8. CTA FINAL -->
    <!-- ============================================================ -->
    <section class="cta-section">
      <div class="container cta-box">
        <h2 class="cta-title">{t.cta.title[lang]}</h2>
        <p class="cta-desc">{t.cta.desc[lang]}</p>
        <div class="cta-actions">
          <a href='#services' class="btn btn-primary">{t.cta.primary[lang]}</a>
          <a href='/contact' class="btn btn-secondary">{t.cta.secondary[lang]}</a>
        </div>
      </div>
    </section>

    <Footer lang={lang} />
  </main>
</Layout>

