        desc: {
          fr: "Découvrez les professionnels correspondant à votre demande.",
          ar: "اكتشف المحترفين المطابقين لطلبك.",
          en: "Discover professionals matching your request.",
        },
      },
      {
        label: "03",
        title: {
          fr: "Échangez et choisissez",
          ar: "تواصل واختر",
