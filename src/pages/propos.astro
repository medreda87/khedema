  },
};

// ============================================================
// HELPERS
// ============================================================

const contactUrl = `/contact`;
const homeUrl = `/${lang}/`;
const servicesUrl = `/#service`;
---

<Layout
  lang={lang}
  title={lang === "ar"
    ? "حول AlloMealem"
    : lang === "en"
      ? "About AlloMealem"
      : "À propos - AlloMealem"}
  dir={dir}
>
  <main class:list={["about-page", { rtl: isRTL }]}>
    <Header lang={lang} />

    <!-- ============================================================
         HERO
    ============================================================= -->
    <section class="about-hero">
      <div class="hero-background" aria-hidden="true">
        <div class="hero-gradient"></div>
        <div class="hero-orb hero-orb-1"></div>
        <div class="hero-orb hero-orb-2"></div>
      </div>

      <div class="container hero-container">
        <div class="hero-content">
          <div class="badge">
            <span class="badge-dot"></span>
            {t.hero.badge[lang]}
          </div>

          <h1 class="hero-title">
            {t.hero.title[lang]}
          </h1>

          <p class="hero-description">
            {t.hero.desc[lang]}
          </p>

          <div class="hero-buttons">
            <a href={contactUrl} class="btn btn-primary">
              <span>{t.hero.ctaPrimary[lang]}</span>

              <svg
                class="btn-arrow"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>

            <a href={servicesUrl} class="btn btn-secondary">
              {t.hero.ctaSecondary[lang]}
            </a>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-image-wrapper">
            <div class="hero-image-glow"></div>

            <img
              src="/props1.avif"
              alt="Artisan professionnel AlloMealem"
              width="620"
              height="465"
              loading="eager"
            />

            <div class="floating-icon floating-1" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <path d="M4 12h16M12 4v16M4 4l16 16"></path>
              </svg>
            </div>

            <div class="floating-icon floating-2" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
              </svg>
            </div>

            <div class="floating-icon floating-3" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <circle cx="12" cy="12" r="3"></circle>
                <path
                  d="M19.4 15a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H5.78a1.65 1.65 0 0 0-1.51 1 1.65 1.65 0 0 0 .33 1.82L12 22z"
                ></path>
                <path d="M4 10h16"></path>
              </svg>
            </div>

            <div class="floating-icon floating-4" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         MISSION
    ============================================================= -->
    <section class="mission-section">
      <div class="container mission-grid">
        <div class="mission-content">
          <div class="badge">
            {t.mission.badge[lang]}
          </div>

          <h2 class="section-title">
            {t.mission.title[lang]}
          </h2>

          <p class="mission-text">
            {t.mission.p1[lang]}
          </p>

          <p class="mission-text">
            {t.mission.p2[lang]}
          </p>
        </div>

        <div class="mission-visual">
          <div class="mission-image">
            <img
              src="/image1.avif"
              alt="Équipe AlloMealem"
              width="600"
              height="450"
              loading="lazy"
            />

            <div class="mission-card mission-card-1">
              <span class="check">✓</span>
              <span>{t.mission.cards.verified[lang]}</span>
            </div>

            <div class="mission-card mission-card-2">
              <span class="check">✓</span>
              <span>{t.mission.cards.local[lang]}</span>
            </div>

            <div class="mission-card mission-card-3">
              <span class="check">✓</span>
              <span>{t.mission.cards.rapid[lang]}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         WHY
    ============================================================= -->
    <section class="why-section">
      <div class="container">
        <div class="section-heading centered">
          <h2 class="section-title">
            {t.why.title[lang]}
          </h2>
        </div>

        <div class="why-grid">
          {
            t.why.items.map((item, i) => (
              <article class="why-card">
                <div class="why-icon">
                  {i === 0 && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z" />
                      <circle cx="12" cy="10" r="3" />
                    </svg>
                  )}

                  {i === 1 && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <circle cx="11" cy="11" r="8" />
                      <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                  )}

                  {i === 2 && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                      <circle cx="12" cy="7" r="4" />
                    </svg>
                  )}

                  {i === 3 && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                      <polyline points="9 12 11 14 15 10" />
                    </svg>
                  )}
                </div>

                <h3>{item.title[lang]}</h3>
                <p>{item.desc[lang]}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============================================================
         STEPS
    ============================================================= -->
    <section class="steps-section">
      <div class="container">
        <div class="section-heading centered">
          <h2 class="section-title">
            {t.steps.title[lang]}
          </h2>
        </div>

        <div class="steps-grid">
          {
            t.steps.items.map((step, i) => (
              <article class="step-item">
                <div class="step-number">{step.label}</div>

                <div class="step-content">
                  <h3>{step.title[lang]}</h3>
                  <p>{step.desc[lang]}</p>
                </div>

                {i < t.steps.items.length - 1 && (
                  <div class="step-arrow" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <line x1="5" y1="12" x2="19" y2="12" />
                      <polyline points="12 5 19 12 12 19" />
                    </svg>
                  </div>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============================================================
         SERVICES
    ============================================================= -->
    <section class="services-section" id="service">
      <div class="container">
        <div class="section-heading centered">
          <h2 class="section-title">
            {t.services.title[lang]}
          </h2>
        </div>

        <div class="services-grid">
          {
            t.services.items.map((service, i) => (
              <article class="service-card">
                <div class="service-icon">
                  {i === 0 && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                    >
                      <path d="M4 12h16M12 4v16M4 4l16 16" />
                    </svg>
                  )}

                  {i === 1 && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                    >
                      <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                    </svg>
                  )}

                  {i === 2 && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                    >
                      <circle cx="12" cy="12" r="3" />
                      <path d="M19.4 15a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H5.78a1.65 1.65 0 0 0-1.51 1 1.65 1.65 0 0 0 .33 1.82L12 22z" />
                      <path d="M4 10h16" />
                    </svg>
                  )}

                  {i === 3 && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                    >
                      <rect x="3" y="3" width="7" height="7" />
                      <rect x="14" y="3" width="7" height="7" />
                      <rect x="3" y="14" width="7" height="7" />
                      <rect x="14" y="14" width="7" height="7" />
                    </svg>
                  )}

                  {i === 4 && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                    >
                      <path d="M12 2v4" />
                      <path d="M12 22v-4" />
                      <path d="M4 12H2" />
                      <path d="M22 12h-2" />
                      <circle cx="12" cy="12" r="3" />
                    </svg>
                  )}

                  {i === 5 && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                    >
                      <path d="M4 4h16v4H4z" />
                      <path d="M4 12h10v4H4z" />
                      <path d="M4 20h16v-4H4z" />
                    </svg>
                  )}
                </div>

                <h3>{service.name[lang]}</h3>
                <p>{service.desc[lang]}</p>

                <a href={servicesUrl} class="service-link">
                  {lang === "fr"
                    ? "Découvrir"
                    : lang === "ar"
                      ? "اكتشف"
                      : "Discover"}

                  <span>→</span>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============================================================
         LOCAL
    ============================================================= -->
    <section class="local-section">
      <div class="container local-grid">
        <div class="local-content">
          <div class="badge badge-dark">
            <span class="badge-dot"></span>
            {t.local.badge[lang]}
          </div>

          <h2 class="section-title section-title-light">
            {t.local.title[lang]}
          </h2>

          <p class="local-description">
            {t.local.desc[lang]}
          </p>

          <div class="local-stats">
            <div class="stat">
              <strong>{t.local.stats.city[lang]}</strong>
              <span>{t.local.stats.cityLabel[lang]}</span>
            </div>

            <div class="stat">
              <strong>{t.local.stats.categories[lang]}</strong>
              <span>{t.local.stats.categoriesLabel[lang]}</span>
            </div>

            <div class="stat">
              <strong>{t.local.stats.response[lang]}</strong>
              <span>{t.local.stats.responseLabel[lang]}</span>
            </div>
          </div>
        </div>

        <div class="local-visual">
          <div class="map-card">
            <div class="map-grid"></div>

            <svg
              class="map-svg"
              viewBox="0 0 400 400"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M80 200 Q150 80 220 140 T350 200 Q280 350 200 280 T80 200Z"
                stroke="rgba(255,255,255,0.18)"
                stroke-width="2"
                fill="rgba(255,255,255,0.03)"></path>

              <circle cx="200" cy="180" r="7" fill="#2563EB"></circle>
              <circle cx="160" cy="150" r="4" fill="rgba(255,255,255,0.5)"
              ></circle>
              <circle cx="260" cy="130" r="4" fill="rgba(255,255,255,0.5)"
              ></circle>
              <circle cx="280" cy="220" r="4" fill="rgba(255,255,255,0.5)"
              ></circle>
              <circle cx="140" cy="240" r="4" fill="rgba(255,255,255,0.5)"
              ></circle>
            </svg>

            <span class="map-pin pin-1"></span>
            <span class="map-pin pin-2"></span>
            <span class="map-pin pin-3"></span>
            <span class="map-pin pin-4"></span>
            <span class="map-pin pin-5"></span>

            <div class="map-label">
              <span class="map-label-dot"></span>
              {t.local.stats.city[lang]}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         VALUES
    ============================================================= -->
    <section class="values-section">
      <div class="container">
        <div class="section-heading centered">
          <h2 class="section-title">
            {t.values.title[lang]}
          </h2>
        </div>

        <div class="values-grid">
          {
            t.values.items.map((value) => (
              <article class="value-card">
                <div class="value-icon">
                  {value.icon === "shield" && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                    >
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                      <polyline points="9 12 11 14 15 10" />
                    </svg>
                  )}

                  {value.icon === "zap" && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                    >
                      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                    </svg>
                  )}

                  {value.icon === "map-pin" && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                    >
                      <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z" />
                      <circle cx="12" cy="10" r="3" />
                    </svg>
                  )}
                </div>

                <h3>{value.name[lang]}</h3>
                <p>{value.desc[lang]}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============================================================
         CTA
    ============================================================= -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-box">
          <div class="cta-decoration"></div>

          <div class="cta-content">
            <h2>{t.cta.title[lang]}</h2>

            <p>
              {t.cta.desc[lang]}
            </p>

            <div class="cta-buttons">
              <a href={servicesUrl} class="btn btn-primary">
                {t.cta.primary[lang]}
              </a>

              <a href={contactUrl} class="btn btn-secondary">
                {t.cta.secondary[lang]}
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Footer lang={lang} />
  </main>
</Layout>

<style>
  /* ================================================================
     VARIABLES
  ================================================================ */

  :root {
    --primary: #2563eb;
    --primary-dark: #1d4ed8;
    --primary-light: #eff6ff;

    --dark: #0f172a;
    --dark-2: #0b1220;

    --text: #0f172a;
    --text-muted: #475569;

    --white: #ffffff;
    --gray-50: #f8fafc;
    --gray-100: #f1f5f9;
    --gray-200: #e2e8f0;
    --gray-300: #cbd5e1;

    --radius: 24px;
    --header-height: 80px;
  }

  /* ================================================================
     RESET / BASE
  ================================================================ */

  .about-page {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
    background: var(--gray-50);
    color: var(--text);
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Arial,
      sans-serif;
  }

  .about-page *,
  .about-page *::before,
  .about-page *::after {
    box-sizing: border-box;
  }

  .container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding-left: 28px;
    padding-right: 28px;
  }

  img {
    max-width: 100%;
  }

  /* ================================================================
     BADGE
  ================================================================ */

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;

    padding: 8px 16px;

    background: var(--primary-light);
    border: 1px solid rgba(37, 99, 235, 0.14);

    border-radius: 999px;

    color: var(--primary);

    font-size: 0.78rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;

    margin-bottom: 22px;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    min-width: 7px;
    border-radius: 50%;
    background: var(--primary);
  }

  .badge-dark {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.12);
    color: #93c5fd;
  }

  .badge-dark .badge-dot {
    background: #60a5fa;
  }

  /* ================================================================
     TITLES
  ================================================================ */

  .section-heading {
    width: 100%;
  }

  .section-heading.centered {
    text-align: center;
  }

  .section-title {
    margin: 0 0 18px;

    color: var(--text);

    font-size: clamp(2rem, 3.5vw, 2.8rem);
    line-height: 1.12;
    font-weight: 800;

    letter-spacing: -0.03em;
  }

  .section-title-light {
    color: #f8fafc;
  }

  /* ================================================================
     BUTTONS
  ================================================================ */

  .btn {
    min-height: 52px;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;

    padding: 14px 26px;

    border-radius: 999px;

    font-size: 0.98rem;
    font-weight: 700;

    text-decoration: none;

    cursor: pointer;

    transition:
      transform 0.25s ease,
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .btn-primary {
    color: #fff;
    background: var(--primary);

    border: 1px solid var(--primary);

    box-shadow: 0 12px 28px rgba(37, 99, 235, 0.24);
  }

  .btn-primary:hover {
    background: var(--primary-dark);
    border-color: var(--primary-dark);

    transform: translateY(-3px);

    box-shadow: 0 18px 35px rgba(37, 99, 235, 0.3);
  }

  .btn-secondary {
    color: var(--text);
    background: #fff;

    border: 1px solid var(--gray-200);
  }

  .btn-secondary:hover {
    color: var(--primary);
    border-color: var(--primary);
    background: var(--primary-light);

    transform: translateY(-2px);
  }

  .btn-arrow {
    width: 18px;
    height: 18px;
    flex-shrink: 0;

    transition: transform 0.25s ease;
  }

  .btn-primary:hover .btn-arrow {
    transform: translateX(4px);
  }

  /* ================================================================
     HERO
  ================================================================ */

  .about-hero {
    position: relative;
    isolation: isolate;

    min-height: calc(100vh - var(--header-height));

    display: flex;
    align-items: center;

    padding: 80px 0 100px;

    overflow: hidden;

    background:
      radial-gradient(
        circle at 10% 20%,
        rgba(37, 99, 235, 0.08),
        transparent 35%
      ),
      linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  }

  .hero-background {
    position: absolute;
    inset: 0;

    overflow: hidden;

    pointer-events: none;

    z-index: -1;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;

    background: radial-gradient(
      circle at 80% 15%,
      rgba(245, 158, 11, 0.06),
      transparent 25%
    );
  }

  .hero-orb {
    position: absolute;

    border-radius: 50%;

    filter: blur(2px);

    animation: heroFloat 12s ease-in-out infinite;
  }

  .hero-orb-1 {
    width: 420px;
    height: 420px;

    top: -220px;
    left: -180px;

    background: radial-gradient(
      circle,
      rgba(37, 99, 235, 0.1),
      transparent 70%
    );
  }

  .hero-orb-2 {
    width: 360px;
    height: 360px;

    right: -180px;
    bottom: -200px;

    background: radial-gradient(
      circle,
      rgba(245, 158, 11, 0.07),
      transparent 70%
    );

    animation-delay: -5s;
  }

  @keyframes heroFloat {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }

    50% {
      transform: translate3d(0, -18px, 0);
    }
  }

  .hero-container {
    display: grid;

    grid-template-columns:
      minmax(0, 0.9fr)
      minmax(0, 1.1fr);

    gap: clamp(40px, 6vw, 90px);

    align-items: center;
  }

  .hero-content {
    min-width: 0;
    max-width: 600px;
  }

  .hero-title {
    margin: 0 0 22px;

    color: var(--dark);

    font-size: clamp(2.5rem, 5vw, 4.2rem);
    line-height: 1.04;

    font-weight: 850;

    letter-spacing: -0.045em;
  }

  .hero-description {
    max-width: 590px;

    margin: 0 0 34px;

    color: var(--text-muted);

    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.75;
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hero-visual {
    min-width: 0;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-image-wrapper {
    position: relative;

    width: 100%;
    max-width: 650px;

    padding: 20px;
  }

  .hero-image-wrapper img {
    position: relative;
    z-index: 2;

    display: block;

    width: 100%;
    height: auto;

    aspect-ratio: 4 / 3;

    object-fit: cover;

    border-radius: 32px;

    border: 1px solid rgba(255, 255, 255, 0.8);

    box-shadow: 0 40px 90px rgba(15, 23, 42, 0.14);

    transition: transform 0.5s ease;
  }

  .hero-image-wrapper:hover img {
    transform: scale(1.015);
  }

  .hero-image-glow {
    position: absolute;
    inset: 5%;

    background: radial-gradient(
      circle,
      rgba(37, 99, 235, 0.2),
      transparent 65%
    );

    filter: blur(40px);

    z-index: 0;
  }

  /* Floating icons */

  .floating-icon {
    position: absolute;

    z-index: 5;

    width: 58px;
    height: 58px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: var(--primary);

    background: rgba(255, 255, 255, 0.92);

    border: 1px solid rgba(255, 255, 255, 0.8);

    border-radius: 17px;

    box-shadow: 0 14px 35px rgba(15, 23, 42, 0.12);

    backdrop-filter: blur(12px);

    animation: floatingIcon 6s ease-in-out infinite;
  }

  .floating-icon svg {
    width: 27px;
    height: 27px;
  }

  .floating-1 {
    top: 4%;
    left: 0;

    animation-delay: 0s;
  }

  .floating-2 {
    top: 2%;
    right: 8%;

    animation-delay: -1.5s;
  }

  .floating-3 {
    bottom: 12%;
    left: 0;

    animation-delay: -3s;
  }

  .floating-4 {
    right: 0;
    bottom: 5%;

    animation-delay: -4.5s;
  }

  @keyframes floatingIcon {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-13px);
    }
  }

  /* ================================================================
     MISSION
  ================================================================ */

  .mission-section {
    padding: 110px 0;

    background: #fff;
  }

  .mission-grid {
    display: grid;

    grid-template-columns:
      minmax(0, 0.9fr)
      minmax(0, 1.1fr);

    gap: clamp(45px, 7vw, 100px);

    align-items: center;
  }

  .mission-content {
    min-width: 0;
  }

  .mission-text {
    margin: 0 0 18px;

    color: var(--text-muted);

    font-size: 1.05rem;
    line-height: 1.8;
  }

  .mission-visual {
    min-width: 0;
  }

  .mission-image {
    position: relative;

    width: 100%;

    border-radius: 30px;
  }

  .mission-image img {
    display: block;

    width: 100%;
    height: auto;

    aspect-ratio: 4 / 3;

    object-fit: cover;

    border-radius: 30px;

    box-shadow: 0 35px 70px rgba(15, 23, 42, 0.14);
  }

  .mission-card {
    position: absolute;

    display: flex;
    align-items: center;
    gap: 10px;

    max-width: calc(100% - 30px);

    padding: 12px 17px;

    color: var(--dark);

    background: rgba(255, 255, 255, 0.94);

    border: 1px solid rgba(255, 255, 255, 0.8);

    border-radius: 15px;

    font-size: 0.88rem;
    font-weight: 700;

    box-shadow: 0 15px 35px rgba(15, 23, 42, 0.12);

    backdrop-filter: blur(12px);

    z-index: 3;

    white-space: nowrap;

    animation: floatingIcon 7s ease-in-out infinite;
  }

  .mission-card .check {
    width: 24px;
    height: 24px;
    min-width: 24px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    color: var(--primary);

    background: var(--primary-light);

    font-size: 0.75rem;
  }

  .mission-card-1 {
    top: 22px;
    left: 22px;
  }

  .mission-card-2 {
    right: 22px;
    bottom: 22px;

    animation-delay: -2s;
  }

  .mission-card-3 {
    right: 22px;
    top: 50%;

    transform: translateY(-50%);

    animation-delay: -4s;
  }

  /* ================================================================
     WHY
  ================================================================ */

  .why-section {
    padding: 110px 0;

    background: var(--gray-100);
  }

  .why-grid {
    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 24px;

    margin-top: 48px;
  }

  .why-card {
    min-width: 0;

    padding: 34px 24px;

    text-align: center;

    background: #fff;

    border: 1px solid var(--gray-200);

    border-radius: var(--radius);

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .why-card:hover {
    transform: translateY(-7px);

    box-shadow: 0 20px 45px rgba(15, 23, 42, 0.08);
  }

  .why-icon {
    width: 64px;
    height: 64px;

    margin: 0 auto 20px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: var(--primary);

    background: var(--primary-light);

    border-radius: 50%;
  }

  .why-icon svg {
    width: 29px;
    height: 29px;
  }

  .why-card h3 {
    margin: 0 0 10px;

    color: var(--dark);

    font-size: 1.12rem;
    line-height: 1.35;
    font-weight: 750;
  }

  .why-card p {
    margin: 0;

    color: var(--text-muted);

    font-size: 0.94rem;
    line-height: 1.65;
  }

  /* ================================================================
     STEPS
  ================================================================ */

  .steps-section {
    padding: 110px 0;

    background: #fff;
  }

  .steps-grid {
    position: relative;

    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 25px;

    margin-top: 55px;
  }

  .steps-grid::before {
    content: "";

    position: absolute;

    top: 26px;
    left: 10%;
    right: 10%;

    height: 2px;

    background: var(--gray-200);

    z-index: 0;
  }

  .step-item {
    position: relative;
    z-index: 1;

    min-width: 0;

    text-align: center;
  }

  .step-number {
    width: 52px;
    height: 52px;

    margin: 0 auto 20px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #fff;

    background: var(--primary);

    border-radius: 50%;

    font-size: 0.95rem;
    font-weight: 800;

    box-shadow: 0 8px 25px rgba(37, 99, 235, 0.28);

    border: 5px solid #fff;
  }

  .step-content h3 {
    margin: 0 0 8px;

    color: var(--dark);

    font-size: 1.05rem;
    font-weight: 750;
  }

  .step-content p {
    max-width: 220px;

    margin: 0 auto;

    color: var(--text-muted);

    font-size: 0.9rem;
    line-height: 1.55;
  }

  .step-arrow {
    position: absolute;

    top: 16px;
    right: -14px;

    width: 28px;
    height: 28px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: var(--gray-300);

    background: #fff;
  }

  .step-arrow svg {
    width: 20px;
    height: 20px;
  }

  /* ================================================================
     SERVICES
  ================================================================ */

  .services-section {
    padding: 110px 0;

    background: var(--gray-100);
  }

  .services-grid {
    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 24px;

    margin-top: 48px;
  }

  .service-card {
    min-width: 0;

    padding: 34px 25px;

    text-align: center;

    background: #fff;

    border: 1px solid var(--gray-200);

    border-radius: var(--radius);

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .service-card:hover {
    transform: translateY(-6px);

    box-shadow: 0 20px 45px rgba(15, 23, 42, 0.08);
  }

  .service-icon {
    width: 64px;
    height: 64px;

    margin: 0 auto 20px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: var(--primary);

    background: var(--primary-light);

    border-radius: 50%;
  }

  .service-icon svg {
    width: 30px;
    height: 30px;
  }

  .service-card h3 {
    margin: 0 0 9px;

    color: var(--dark);

    font-size: 1.15rem;
    font-weight: 750;
  }

  .service-card p {
    min-height: 48px;

    margin: 0 0 17px;

    color: var(--text-muted);

    font-size: 0.94rem;
    line-height: 1.55;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    color: var(--primary);

    font-size: 0.93rem;
    font-weight: 700;

    text-decoration: none;

    transition: gap 0.2s ease;
  }

  .service-link:hover {
    gap: 12px;
  }

  .service-link span {
    transition: transform 0.2s ease;
  }

  /* ================================================================
     LOCAL
  ================================================================ */

  .local-section {
    padding: 110px 0;

    color: #f8fafc;

    background:
      radial-gradient(
        circle at 20% 20%,
        rgba(37, 99, 235, 0.15),
        transparent 35%
      ),
      #0b1220;
  }

  .local-grid {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: clamp(45px, 7vw, 100px);

    align-items: center;
  }

  .local-content {
    min-width: 0;
  }

  .local-description {
    max-width: 600px;

    margin: 0 0 40px;

    color: #cbd5e1;

    font-size: 1.05rem;
    line-height: 1.75;
  }

  .local-stats {
    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 24px;
  }

