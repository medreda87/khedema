```astro
---
// src/pages/[lang]/services/climatisation.astro
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  lang?: "fr" | "ar" | "en";
  currentPath?: string;
}

const { lang = "fr", currentPath = "/services/climatisation" } = Astro.props;


// ============================================================
// ICON SYSTEM — clean inline SVG
// ============================================================
function icon(name: string, size: number = 24, className: string = ""): string {
  const icons: Record<string, string> = {
    snowflake: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <line x1="12" y1="2" x2="12" y2="22"/>
      <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
      <line x1="19.07" y1="4.93" x2="4.93" y2="19.07"/>
      <line x1="5" y1="12" x2="19" y2="12"/>
      <polyline points="8 4 12 8 16 4"/>
      <polyline points="8 20 12 16 16 20"/>
      <polyline points="4 8 8 12 4 16"/>
      <polyline points="20 8 16 12 20 16"/>
    </svg>`,

    fan: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <circle cx="12" cy="12" r="2"/>
      <path d="M12 2c2.5 0 4 2.2 3 4.4-.8 1.8-2.8 2.5-4.3 1.5C9 6.9 9.8 3.3 12 2z"/>
      <path d="M22 12c0 2.5-2.2 4-4.4 3-1.8-.8-2.5-2.8-1.5-4.3 1-1.7 4.6-.9 5.9 1.3z"/>
      <path d="M12 22c-2.5 0-4-2.2-3-4.4.8-1.8 2.8-2.5 4.3-1.5 1.7 1 0.9 4.6-1.3 5.9z"/>
      <path d="M2 12c0-2.5 2.2-4 4.4-3 1.8.8 2.5 2.8 1.5 4.3-1 1.7-4.6.9-5.9-1.3z"/>
    </svg>`,

    wrench: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
    </svg>`,

    wind: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <path d="M9.5 9H19a3 3 0 1 0-3-3"/>
      <path d="M4 12h13a3 3 0 1 1-3 3"/>
      <path d="M2 6h5"/>
      <path d="M2 18h5"/>
    </svg>`,

    "map-pin": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/>
      <circle cx="12" cy="10" r="3"/>
    </svg>`,

    "check-circle": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
      <polyline points="22 4 12 14.01 9 11.01"/>
    </svg>`,

    "arrow-right": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <line x1="5" y1="12" x2="19" y2="12"/>
      <polyline points="12 5 19 12 12 19"/>
    </svg>`,

    "arrow-down": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <line x1="12" y1="5" x2="12" y2="19"/>
      <polyline points="19 12 12 19 5 12"/>
    </svg>`,

    settings: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
      <circle cx="12" cy="12" r="3"/>
    </svg>`,

    "file-text": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
      <polyline points="14 2 14 8 20 8"/>
      <line x1="16" y1="13" x2="8" y2="13"/>
      <line x1="16" y1="17" x2="8" y2="17"/>
      <polyline points="10 9 9 9 8 9"/>
    </svg>`,

    clock: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <circle cx="12" cy="12" r="10"/>
      <polyline points="12 6 12 12 16 14"/>
    </svg>`
  };

  return icons[name] || "";
}

// ============================================================
// MULTILINGUAL CONTENT
// ============================================================
const heroContent: Record<string, any> = {
  fr: {
    badge: "Climatisation à Tanger",
    title: "Votre confort à Tanger,<br/>entre de <span class=\"highlight\">bonnes mains</span>.",
    subtitle: "Besoin d'installer, entretenir ou réparer votre climatisation ? AlloMealem vous met en relation avec des techniciens de confiance à Tanger.",
    primaryCta: "Trouver un professionnel",
    secondaryCta: "Voir les services",
    trust: [
      "Techniciens locaux",
      "Intervention à Tanger",
      "Intervention rapide",
      "Professionnels vérifiés"
    ],
    imgAlt: "Technicien professionnel en climatisation à Tanger"
  },

  ar: {
    badge: "تكييف الهواء في طنجة",
    title: "راحتك في طنجة،<br/>بين <span class=\"highlight\">أيدٍ أمينة</span>.",
    subtitle: "هل تحتاج إلى تركيب أو صيانة أو إصلاح مكيف الهواء؟ يوصلك AlloMealem بتقنيين موثوقين في طنجة.",
    primaryCta: "ابحث عن حرفي",
    secondaryCta: "عرض الخدمات",
    trust: [
      "تقنيون محليون",
      "تدخل في طنجة",
      "تدخل سريع",
      "محترفون موثوقون"
    ],
    imgAlt: "تقني محترف في مجال تكييف الهواء في طنجة"
  },

  en: {
    badge: "Air Conditioning in Tangier",
    title: "Your comfort in Tangier,<br/>in <span class=\"highlight\">good hands</span>.",
    subtitle: "Need air conditioning installation, maintenance or repair? AlloMealem connects you with trusted technicians in Tangier.",
    primaryCta: "Find a professional",
    secondaryCta: "View services",
    trust: [
      "Local technicians",
      "Service in Tangier",
      "Fast service",
      "Verified professionals"
    ],
    imgAlt: "Professional air conditioning technician in Tangier"
  }
};

const content = heroContent[lang] || heroContent.fr;
---

<Layout lang={lang} currentPath={currentPath}>
  <Header lang={lang} />

  <!-- ============================================================
  HERO
  ============================================================ -->
  <section class="climate-hero" id="hero">
    <div class="container">
      <div class="hero-grid">

        <!-- LEFT -->
        <div class="hero-content">

          <span class="hero-badge">
            <span set:html={icon("map-pin", 16, "badge-icon")}></span>
            {content.badge}
          </span>

          <h1 class="hero-title" set:html={content.title}></h1>

          <p class="hero-desc">
            {content.subtitle}
          </p>

          <div class="hero-actions">
            <a href=`/contact` class="btn btn-primary">
              {content.primaryCta}
              <span set:html={icon("arrow-right", 18)}></span>
            </a>

            <a href="#services" class="btn btn-secondary">
              {content.secondaryCta}
            </a>
          </div>

          <div class="trust-indicators">
            {content.trust.map((item: string) => (
              <span class="trust-item">
                <span set:html={icon("check-circle", 18, "trust-icon")}></span>
                {item}
              </span>
            ))}
          </div>

        </div>

        <!-- RIGHT -->
        <div class="hero-visuals">

          <div class="visual-main">
            <img
              src="/climatisation1.png"
              alt={content.imgAlt}
              loading="eager"
              decoding="async"
            />
          </div>

          <div class="visual-support support-1">
            <img
              src="/climatisation.png"
              alt="Technicien réparant une climatisation"
              loading="lazy"
              decoding="async"
            />
            <span class="support-label">Réparation</span>
          </div>

          <div class="visual-support support-2">
            <img
              src="/climatisation3.png"
              alt="Technicien installant une climatisation"
              loading="lazy"
              decoding="async"
            />
            <span class="support-label">Installation</span>
          </div>

          <div class="floating-card">
            <span class="float-icon" set:html={icon("check-circle", 20)}></span>

            <div>
              <span class="float-title">Intervention rapide</span>
              <span class="float-sub">À Tanger</span>
            </div>
          </div>

          <div class="service-tags">
            <span class="tag">Installation</span>
            <span class="tag">Entretien</span>
            <span class="tag">Réparation</span>
            <span class="tag">Dépannage</span>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
  SERVICES
  ============================================================ -->
  <section class="services-section" id="services">
    <div class="container">

      <div class="section-header">
        <span class="eyebrow">Nos services</span>

        <h2 class="section-title">
          Des solutions pour tous vos besoins en climatisation
        </h2>

        <p class="section-desc">
          Installation, entretien ou dépannage : trouvez le service adapté à votre besoin.
        </p>
      </div>

      <div class="services-grid">

        <div class="service-card">
          <div class="service-icon" set:html={icon("snowflake", 28)}></div>
          <h3 class="service-title">Installation de climatisation</h3>
          <p class="service-desc">
            Installation de climatiseurs adaptée à votre logement ou votre local professionnel.
          </p>
          <a href="/contact" class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)}></span>
          </a>
        </div>

        <div class="service-card">
          <div class="service-icon" set:html={icon("settings", 28)}></div>
          <h3 class="service-title">Entretien climatisation</h3>
          <p class="service-desc">
            Nettoyage et entretien régulier pour maintenir les performances de votre climatiseur.
          </p>
          <a href="/contact" class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)}></span>
          </a>
        </div>

        <div class="service-card">
          <div class="service-icon" set:html={icon("wrench", 28)}></div>
          <h3 class="service-title">Réparation climatisation</h3>
          <p class="service-desc">
            Diagnostic et réparation des pannes pour retrouver rapidement votre confort.
          </p>
          <a href="/contact" class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)}></span>
          </a>
        </div>

        <div class="service-card">
          <div class="service-icon" set:html={icon("wind", 28)}></div>
          <h3 class="service-title">Dépannage</h3>
          <p class="service-desc">
            Intervention rapide en cas de climatisation qui ne fonctionne plus correctement.
          </p>
          <a href="/contact" class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)}></span>
          </a>
        </div>

        <div class="service-card">
          <div class="service-icon" set:html={icon("fan", 28)}></div>
          <h3 class="service-title">Nettoyage climatiseur</h3>
          <p class="service-desc">
            Nettoyage des filtres et des équipements pour une climatisation plus efficace.
          </p>
          <a href="/contact" class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)}></span>
          </a>
        </div>

        <div class="service-card">
          <div class="service-icon" set:html={icon("settings", 28)}></div>
          <h3 class="service-title">Remplacement</h3>
          <p class="service-desc">
            Remplacement d'un ancien climatiseur par une solution adaptée à vos besoins.
          </p>
          <a href="/contact" class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)}></span>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
  WHY CHOOSE US
  ============================================================ -->
  <section class="why-section" id="why">
    <div class="container">

      <div class="why-grid">

        <div class="why-image-wrapper">
          <div class="why-image-container">

            <img
              src="/climatisation3.png"
              alt="Technicien professionnel en climatisation"
              loading="lazy"
              decoding="async"
            />

            <div class="why-badge">
              <span set:html={icon("check-circle", 18, "badge-icon")}></span>
              Professionnels vérifiés
            </div>

          </div>
        </div>

        <div class="why-content">

          <span class="eyebrow">
            Pourquoi nous choisir ?
          </span>

          <h2 class="why-title">
            Une climatisation entretenue par des professionnels
          </h2>

          <p class="why-desc">
            Nous vous aidons à trouver un technicien adapté à votre besoin,
            que ce soit pour une installation, un entretien ou un dépannage.
          </p>

          <div class="why-benefits">

            <div class="why-benefit">
              <span class="benefit-icon" set:html={icon("check-circle", 20)}></span>

              <div>
                <strong>Techniciens locaux</strong>
                <span>Des professionnels disponibles à Tanger.</span>
              </div>
            </div>

            <div class="why-benefit">
              <span class="benefit-icon" set:html={icon("clock", 20)}></span>

              <div>
                <strong>Intervention rapide</strong>
                <span>Une prise en charge adaptée à votre situation.</span>
              </div>
            </div>

            <div class="why-benefit">
              <span class="benefit-icon" set:html={icon("file-text", 20)}></span>

              <div>
                <strong>Prix transparents</strong>
                <span>Des informations claires avant l'intervention.</span>
              </div>
            </div>

          </div>

          <a
            href=`/contact`
            class="btn btn-primary why-cta"
          >
            Demander un service
            <span set:html={icon("arrow-right", 18)}></span>
          </a>

        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
  HOW IT WORKS
  ============================================================ -->
  <section class="how-section" id="how">
    <div class="container">

      <div class="section-header">

        <span class="eyebrow">
          Comment ça marche
        </span>

        <h2 class="section-title">
          Trouver un technicien climatisation en quelques étapes
        </h2>

        <p class="section-desc">
          Un processus simple pour trouver rapidement le professionnel adapté.
        </p>

      </div>

      <div class="steps">

        <div class="step">

          <div class="step-number">01</div>

          <div class="step-icon" set:html={icon("file-text", 28)}></div>

          <h3 class="step-title">
            Décrivez votre besoin
          </h3>

          <p class="step-desc">
            Expliquez simplement le problème ou le travail à réaliser.
          </p>

        </div>

        <div class="step-connector"></div>

        <div class="step">

          <div class="step-number">02</div>

          <div class="step-icon" set:html={icon("snowflake", 28)}></div>

          <h3 class="step-title">
            Choisissez un professionnel
          </h3>

          <p class="step-desc">
            Consultez les professionnels disponibles pour votre demande.
          </p>

        </div>

        <div class="step-connector"></div>

        <div class="step">

          <div class="step-number">03</div>

          <div class="step-icon" set:html={icon("clock", 28)}></div>

          <h3 class="step-title">
            Planifiez l'intervention
          </h3>

          <p class="step-desc">
            Convenez directement des détails et de l'horaire de l'intervention.
          </p>

        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
  CTA
  ============================================================ -->
  <section class="cta-section" id="cta">
    <div class="container">

      <div class="cta-box">

        <span class="cta-badge">
          Climatisation à Tanger
        </span>

        <h2 class="cta-title">
          Besoin d'un technicien climatisation ?
        </h2>

        <p class="cta-desc">
          Décrivez votre besoin et trouvez un professionnel adapté à Tanger.
        </p>

        <div class="cta-actions">

          <a
            href='/contact'
            class="btn btn-primary btn-large"
          >
            Demander un service
            <span set:html={icon("arrow-right", 20)}></span>
          </a>

          <a
            href="#services"
            class="btn btn-secondary btn-large"
          >
            Voir nos services
            <span set:html={icon("arrow-down", 20)}></span>
          </a>

        </div>

        <div class="cta-footer">

          <span>
            <span set:html={icon("check-circle", 16, "footer-icon")}></span>
            Techniciens locaux
          </span>

          <span>
            <span set:html={icon("check-circle", 16, "footer-icon")}></span>
            Intervention à Tanger
          </span>

          <span>
            <span set:html={icon("check-circle", 16, "footer-icon")}></span>
            Professionnels vérifiés
          </span>

        </div>

      </div>
    </div>
  </section>

  <Footer lang={lang} />

  <!-- ============================================================
  SCROLL ANIMATION
  ============================================================ -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {

      const prefersReducedMotion =
        window.matchMedia("(prefers-reduced-motion: reduce)");

      if (prefersReducedMotion.matches) {
        document
          .querySelectorAll(".fade-up")
          .forEach(el => el.classList.add("visible"));
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
            }
          });
        },
        {
          threshold: 0.12,
          rootMargin: "0px 0px -40px 0px"
        }
      );

      document
        .querySelectorAll(
          ".section-header, .service-card, .why-image-wrapper, .why-content, .step, .cta-box"
        )
        .forEach(el => {
          el.classList.add("fade-up");
          observer.observe(el);
        });

      document
        .querySelectorAll(".service-card")
        .forEach((el, i) => {
          (el as HTMLElement).style.transitionDelay =
            (i * 60) + "ms";
        });
    });
  </script>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..800&display=swap');

  :root {
    --color-primary: #2563eb;
    --color-primary-dark: #1d4ed8;
    --color-primary-light: #eff6ff;
    --color-navy: #0f172a;
    --color-text: #475569;
    --color-slate: #64748b;
    --color-bg: #f8fafc;
    --color-white: #ffffff;

    --radius-card: 22px;
    --radius-image: 28px;

    --shadow-card:
      0 4px 24px rgba(15, 23, 42, 0.06);

    --shadow-hover:
      0 12px 40px rgba(15, 23, 42, 0.10);

    --transition:
      0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);

    font-family:
      'Inter',
      system-ui,
      -apple-system,
      sans-serif;
  }

  body {
    font-family: inherit;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 28px;
  }

  .fade-up {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  .fade-up.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .eyebrow {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    background: var(--color-primary-light);
    padding: 4px 18px;
    border-radius: 40px;
    margin-bottom: 14px;
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 52px;
  }

  .section-title {
    font-size: 40px;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 12px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .section-desc {
    font-size: 17px;
    color: var(--color-text);
    margin: 0;
    line-height: 1.6;
  }

  /* ============================================================
     BUTTONS
  ============================================================ */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 32px;
    border-radius: 60px;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    transition: all var(--transition);
    border: none;
    cursor: pointer;
    font-family: inherit;
    line-height: 1.2;
