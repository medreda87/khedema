// src/pages/[lang]/services/climatisation.astro
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  lang?: "fr" | "ar" | "en";
  currentPath?: string;
}

const {
  lang = "fr",
  currentPath = "/services/climatisation",
} = Astro.props;

// ============================================================
// ICON SYSTEM
// ============================================================
function icon(
  name: string,
  size: number = 24,
  className: string = ""
): string {
  const icons: Record<string, string> = {
    snowflake: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <line x1="12" y1="2" x2="12" y2="22"/>
      <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
      <line x1="19.07" y1="4.93" x2="4.93" y2="19.07"/>
      <line x1="5" y1="12" x2="19" y2="12"/>
      <polyline points="8 4 12 8 16 4"/>
      <polyline points="8 20 12 16 16 20"/>
      <polyline points="4 8 8 12 4 16"/>
      <polyline points="20 8 16 12 20 16"/>
    </svg>`,

    fan: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <circle cx="12" cy="12" r="2"/>
      <path d="M12 2c2.5 0 4 2.2 3 4.4-.8 1.8-2.8 2.5-4.3 1.5C9 6.9 9.8 3.3 12 2z"/>
      <path d="M22 12c0 2.5-2.2 4-4.4 3-1.8-.8-2.5-2.8-1.5-4.3 1-1.7 4.6-.9 5.9 1.3z"/>
      <path d="M12 22c-2.5 0-4-2.2-3-4.4.8-1.8 2.8-2.5 4.3-1.5 1.7 1 0.9 4.6-1.3 5.9z"/>
      <path d="M2 12c0-2.5 2.2-4 4.4-3 1.8.8 2.5 2.8 1.5 4.3-1 1.7-4.6.9-5.9-1.3z"/>
    </svg>`,

    wrench: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
    </svg>`,

    wind: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <path d="M9.5 9H19a3 3 0 1 0-3-3"/>
      <path d="M4 12h13a3 3 0 1 1-3 3"/>
      <path d="M2 6h5"/>
      <path d="M2 18h5"/>
    </svg>`,

    "map-pin": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/>
      <circle cx="12" cy="10" r="3"/>
    </svg>`,

    "check-circle": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
      <polyline points="22 4 12 14.01 9 11.01"/>
    </svg>`,

    "arrow-right": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <line x1="5" y1="12" x2="19" y2="12"/>
      <polyline points="12 5 19 12 12 19"/>
    </svg>`,

    "arrow-down": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <line x1="12" y1="5" x2="12" y2="19"/>
      <polyline points="19 12 12 19 5 12"/>
    </svg>`,

    settings: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
      <circle cx="12" cy="12" r="3"/>
    </svg>`,

    "file-text": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
      <polyline points="14 2 14 8 20 8"/>
      <line x1="16" y1="13" x2="8" y2="13"/>
      <line x1="16" y1="17" x2="8" y2="17"/>
      <polyline points="10 9 9 9 8 9"/>
    </svg>`,

    clock: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <circle cx="12" cy="12" r="10"/>
      <polyline points="12 6 12 12 16 14"/>
    </svg>`,
  };

  return icons[name] || "";
}

// ============================================================
// CONTENT
// ============================================================
const heroContent: Record<string, any> = {
  fr: {
    badge: "Climatisation à Tanger",
    title:
      'Votre confort à Tanger,<br/>entre de <span class="highlight">bonnes mains</span>.',
    subtitle:
      "Besoin d'installer, entretenir ou réparer votre climatisation ? AlloMealem vous met en relation avec des techniciens de confiance à Tanger.",
    primaryCta: "Trouver un professionnel",
    secondaryCta: "Voir les services",
    trust: [
      "Techniciens locaux",
      "Intervention à Tanger",
      "Intervention rapide",
      "Professionnels vérifiés",
    ],
    imgAlt: "Technicien professionnel en climatisation à Tanger",
  },

  ar: {
    badge: "تكييف الهواء في طنجة",
    title:
      'راحتك في طنجة،<br/>بين <span class="highlight">أيدٍ أمينة</span>.',
    subtitle:
      "هل تحتاج إلى تركيب أو صيانة أو إصلاح مكيف الهواء؟ يوصلك AlloMealem بتقنيين موثوقين في طنجة.",
    primaryCta: "ابحث عن حرفي",
    secondaryCta: "عرض الخدمات",
    trust: [
      "تقنيون محليون",
      "تدخل في طنجة",
      "تدخل سريع",
      "محترفون موثوقون",
    ],
    imgAlt: "تقني محترف في مجال تكييف الهواء في طنجة",
  },

  en: {
    badge: "Air Conditioning in Tangier",
    title:
      'Your comfort in Tangier,<br/>in <span class="highlight">good hands</span>.',
    subtitle:
      "Need air conditioning installation, maintenance or repair? AlloMealem connects you with trusted technicians in Tangier.",
    primaryCta: "Find a professional",
    secondaryCta: "View services",
    trust: [
      "Local technicians",
      "Service in Tangier",
      "Fast service",
      "Verified professionals",
    ],
    imgAlt: "Professional air conditioning technician in Tangier",
  },
};

const content = heroContent[lang] || heroContent.fr;
---

<Layout lang={lang} currentPath={currentPath}>
  <Header lang={lang} />

  <main class={`climatisation-page ${lang === "ar" ? "rtl" : ""}`}>

    <!-- ============================================================
    HERO
    ============================================================ -->
    <section class="climate-hero" id="hero">
      <div class="container">
        <div class="hero-grid">

          <div class="hero-content">

            <span class="hero-badge">
              <span set:html={icon("map-pin", 16, "badge-icon")}></span>
              {content.badge}
            </span>

            <h1 class="hero-title" set:html={content.title}></h1>

            <p class="hero-desc">
              {content.subtitle}
            </p>

            <div class="hero-actions">
              <a href="/contact" class="btn btn-primary">
                {content.primaryCta}
                <span set:html={icon("arrow-right", 18)}></span>
              </a>

              <a href="#services" class="btn btn-secondary">
                {content.secondaryCta}
              </a>
            </div>

            <div class="trust-indicators">
              {
                content.trust.map((item: string) => (
                  <span class="trust-item">
                    <span
                      set:html={icon("check-circle", 18, "trust-icon")}
                    />
                    {item}
                  </span>
                ))
              }
            </div>

          </div>

          <div class="hero-visuals">

            <div class="visual-main">
              <img
                src="/climatisation1.png"
                alt={content.imgAlt}
                loading="eager"
                decoding="async"
              />
            </div>

            <div class="visual-support support-1">
              <img
                src="/climatisation.png"
                alt="Technicien réparant une climatisation"
                loading="lazy"
                decoding="async"
              />
              <span class="support-label">Réparation</span>
            </div>

            <div class="visual-support support-2">
              <img
                src="/climatisation3.png"
                alt="Technicien installant une climatisation"
                loading="lazy"
                decoding="async"
              />
              <span class="support-label">Installation</span>
            </div>

            <div class="floating-card">
              <span
                class="float-icon"
                set:html={icon("check-circle", 20)}
              ></span>

              <div>
                <span class="float-title">Intervention rapide</span>
                <span class="float-sub">À Tanger</span>
              </div>
            </div>

            <div class="service-tags">
              <span class="tag">Installation</span>
              <span class="tag">Entretien</span>
              <span class="tag">Réparation</span>
              <span class="tag">Dépannage</span>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- ============================================================
    SERVICES
    ============================================================ -->
    <section class="services-section" id="services">
      <div class="container">

        <div class="section-header">
          <span class="eyebrow">Nos services</span>

          <h2 class="section-title">
            Des solutions pour tous vos besoins en climatisation
          </h2>

          <p class="section-desc">
            Installation, entretien ou dépannage : trouvez le service adapté à votre besoin.
          </p>
        </div>

        <div class="services-grid">

          <div class="service-card">
            <div class="service-icon" set:html={icon("snowflake", 28)}></div>
            <h3 class="service-title">Installation de climatisation</h3>
            <p class="service-desc">
              Installation de climatiseurs adaptée à votre logement ou votre local professionnel.
            </p>
            <a href="/contact" class="service-link">
              En savoir plus
              <span set:html={icon("arrow-right", 16)}></span>
            </a>
          </div>

          <div class="service-card">
            <div class="service-icon" set:html={icon("settings", 28)}></div>
            <h3 class="service-title">Entretien climatisation</h3>
            <p class="service-desc">
              Nettoyage et entretien régulier pour maintenir les performances de votre climatiseur.
            </p>
            <a href="/contact" class="service-link">
              En savoir plus
              <span set:html={icon("arrow-right", 16)}></span>
            </a>
          </div>

          <div class="service-card">
            <div class="service-icon" set:html={icon("wrench", 28)}></div>
            <h3 class="service-title">Réparation climatisation</h3>
            <p class="service-desc">
              Diagnostic et réparation des pannes pour retrouver rapidement votre confort.
            </p>
            <a href="/contact" class="service-link">
              En savoir plus
              <span set:html={icon("arrow-right", 16)}></span>
            </a>
          </div>

          <div class="service-card">
            <div class="service-icon" set:html={icon("wind", 28)}></div>
            <h3 class="service-title">Dépannage</h3>
            <p class="service-desc">
              Intervention rapide en cas de climatisation qui ne fonctionne plus correctement.
            </p>
            <a href="/contact" class="service-link">
              En savoir plus
              <span set:html={icon("arrow-right", 16)}></span>
            </a>
          </div>

          <div class="service-card">
            <div class="service-icon" set:html={icon("fan", 28)}></div>
            <h3 class="service-title">Nettoyage climatiseur</h3>
            <p class="service-desc">
              Nettoyage des filtres et des équipements pour une climatisation plus efficace.
            </p>
            <a href="/contact" class="service-link">
              En savoir plus
              <span set:html={icon("arrow-right", 16)}></span>
            </a>
          </div>

          <div class="service-card">
            <div class="service-icon" set:html={icon("settings", 28)}></div>
            <h3 class="service-title">Remplacement</h3>
            <p class="service-desc">
              Remplacement d'un ancien climatiseur par une solution adaptée à vos besoins.
            </p>
            <a href="/contact" class="service-link">
              En savoir plus
              <span set:html={icon("arrow-right", 16)}></span>
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- ============================================================
    WHY CHOOSE US
    ============================================================ -->
    <section class="why-section" id="why">
      <div class="container">

        <div class="why-grid">

          <div class="why-image-wrapper">
            <div class="why-image-container">

              <img
                src="/climatisation3.png"
                alt="Technicien professionnel en climatisation"
                loading="lazy"
                decoding="async"
              />

              <div class="why-badge">
                <span
                  set:html={icon("check-circle", 18, "badge-icon")}
                ></span>
                Professionnels vérifiés
              </div>

            </div>
          </div>

          <div class="why-content">

            <span class="eyebrow">
              Pourquoi nous choisir ?
            </span>

            <h2 class="why-title">
              Une climatisation entretenue par des professionnels
            </h2>

            <p class="why-desc">
              Nous vous aidons à trouver un technicien adapté à votre besoin,
              que ce soit pour une installation, un entretien ou un dépannage.
            </p>

            <div class="why-benefits">

              <div class="why-benefit">
                <span
                  class="benefit-icon"
                  set:html={icon("check-circle", 20)}
                ></span>

                <div>
                  <strong>Techniciens locaux</strong>
                  <span>Des professionnels disponibles à Tanger.</span>
                </div>
              </div>

              <div class="why-benefit">
                <span
                  class="benefit-icon"
                  set:html={icon("clock", 20)}
                ></span>

                <div>
                  <strong>Intervention rapide</strong>
                  <span>Une prise en charge adaptée à votre situation.</span>
                </div>
              </div>

              <div class="why-benefit">
                <span
                  class="benefit-icon"
                  set:html={icon("file-text", 20)}
                ></span>

                <div>
                  <strong>Prix transparents</strong>
                  <span>Des informations claires avant l'intervention.</span>
                </div>
              </div>

            </div>

            <a href="/contact" class="btn btn-primary why-cta">
              Demander un service
              <span set:html={icon("arrow-right", 18)}></span>
            </a>

          </div>

        </div>
      </div>
    </section>

    <!-- ============================================================
    HOW IT WORKS
    ============================================================ -->
    <section class="how-section" id="how">
      <div class="container">

        <div class="section-header">

          <span class="eyebrow">
            Comment ça marche
          </span>

          <h2 class="section-title">
            Trouver un technicien climatisation en quelques étapes
          </h2>

          <p class="section-desc">
            Un processus simple pour trouver rapidement le professionnel adapté.
          </p>

        </div>

        <div class="steps">

          <div class="step">
            <div class="step-number">01</div>

            <div
              class="step-icon"
              set:html={icon("file-text", 28)}
            ></div>

            <h3 class="step-title">
              Décrivez votre besoin
            </h3>

            <p class="step-desc">
              Expliquez simplement le problème ou le travail à réaliser.
            </p>
          </div>

          <div class="step-connector"></div>

          <div class="step">
            <div class="step-number">02</div>

            <div
              class="step-icon"
              set:html={icon("snowflake", 28)}
            ></div>

            <h3 class="step-title">
              Choisissez un professionnel
            </h3>

            <p class="step-desc">
              Consultez les professionnels disponibles pour votre demande.
            </p>
          </div>

          <div class="step-connector"></div>

          <div class="step">
            <div class="step-number">03</div>

            <div
              class="step-icon"
              set:html={icon("clock", 28)}
            ></div>

            <h3 class="step-title">
              Planifiez l'intervention
            </h3>

            <p class="step-desc">
              Convenez directement des détails et de l'horaire de l'intervention.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- ============================================================
    CTA
    ============================================================ -->
    <section class="cta-section" id="cta">
      <div class="container">

        <div class="cta-box">

          <span class="cta-badge">
            Climatisation à Tanger
          </span>

          <h2 class="cta-title">
            Besoin d'un technicien climatisation ?
          </h2>

          <p class="cta-desc">
            Décrivez votre besoin et trouvez un professionnel adapté à Tanger.
          </p>

          <div class="cta-actions">

            <a
              href="/contact"
              class="btn btn-primary btn-large"
            >
              Demander un service
              <span set:html={icon("arrow-right", 20)}></span>
            </a>

            <a
              href="#services"
              class="btn btn-secondary btn-large"
            >
              Voir nos services
              <span set:html={icon("arrow-down", 20)}></span>
            </a>

          </div>

          <div class="cta-footer">

            <span>
              <span
                set:html={icon("check-circle", 16, "footer-icon")}
              ></span>
              Techniciens locaux
            </span>

            <span>
              <span
                set:html={icon("check-circle", 16, "footer-icon")}
              ></span>
              Intervention à Tanger
            </span>

            <span>
              <span
                set:html={icon("check-circle", 16, "footer-icon")}
              ></span>
              Professionnels vérifiés
            </span>

          </div>

        </div>
      </div>
    </section>

  </main>

  <Footer lang={lang} />

  <!-- ============================================================
  SCROLL ANIMATION
  ============================================================ -->
  <script>
    const initAnimations = () => {
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      );

      const elements = document.querySelectorAll(
        ".section-header, .service-card, .why-image-wrapper, .why-content, .step, .cta-box"
      );

      if (prefersReducedMotion.matches) {
        elements.forEach((el) => {
          el.classList.add("visible");
        });
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.08,
          rootMargin: "0px 0px -30px 0px",
        }
      );

      elements.forEach((el, index) => {
        el.classList.add("fade-up");

        if (el.classList.contains("service-card")) {
          (el as HTMLElement).style.transitionDelay =
            `${(index % 3) * 70}ms`;
        }

        observer.observe(el);
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAnimations);
    } else {
      initAnimations();
    };

    document.addEventListener("astro:page-load", initAnimations);
  </script>
</Layout>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..800&display=swap");

  :root {
    --color-primary: #2563eb;
    --color-primary-dark: #1d4ed8;
    --color-primary-light: #eff6ff;
    --color-navy: #0f172a;
    --color-text: #475569;
    --color-slate: #64748b;
    --color-bg: #f8fafc;
    --color-white: #ffffff;

    --radius-card: 22px;
    --radius-image: 28px;

    --shadow-card:
      0 4px 24px rgba(15, 23, 42, 0.06);

    --shadow-hover:
      0 12px 40px rgba(15, 23, 42, 0.10);

    --transition:
      0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);

    font-family:
      "Inter",
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  /* ============================================================
     BASE
  ============================================================ */

  .climatisation-page {
    width: 100%;
    overflow-x: hidden;
    background: var(--color-white);
    color: var(--color-navy);
  }

  .climatisation-page.rtl {
    direction: rtl;
  }

  .container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding-left: 28px;
    padding-right: 28px;
    box-sizing: border-box;
  }

  img {
    max-width: 100%;
  }

  /* ============================================================
     ANIMATIONS
  ============================================================ */

  .fade-up {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  .fade-up.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ============================================================
     EYEBROW
  ============================================================ */

  .eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    background: var(--color-primary-light);
    padding: 6px 18px;
    border-radius: 40px;
    margin-bottom: 14px;
  }

  /* ============================================================
     SECTION HEADER
  ============================================================ */

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 52px;
  }

  .section-title {
    font-size: 40px;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 14px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .section-desc {
    font-size: 17px;
    color: var(--color-text);
    margin: 0;
    line-height: 1.65;
  }

  /* ============================================================
     BUTTONS
  ============================================================ */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 52px;
    padding: 14px 30px;
    border-radius: 60px;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    transition: all var(--transition);
    border: 2px solid transparent;
    cursor: pointer;
    font-family: inherit;
    line-height: 1.2;
    box-sizing: border-box;
  }

  .btn-primary {
    background: var(--color-primary);
    color: var(--color-white);
    box-shadow:
      0 4px 20px rgba(37, 99, 235, 0.3);
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    color: var(--color-white);
    transform: translateY(-3px);
    box-shadow:
      0 8px 32px rgba(37, 99, 235, 0.4);
  }

  .btn-primary svg {
    transition: transform 0.25s ease;
  }

  .btn-primary:hover svg {
    transform: translateX(4px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-navy);
    border-color: rgba(15, 23, 42, 0.15);
  }

  .btn-secondary:hover {
    background: rgba(15, 23, 42, 0.04);
    border-color: var(--color-navy);
    transform: translateY(-3px);
  }

  .btn-large {
    min-height: 58px;
    padding: 17px 38px;
    font-size: 17px;
  }

  /* ============================================================
     HERO
  ============================================================ */

  .climate-hero {
    position: relative;
    padding: 70px 0 90px;
    background: var(--color-bg);
    overflow: hidden;
    margin-top: var(--header-h, 76px);
  }

  .climate-hero::before {
    content: "";
    position: absolute;
    top: -260px;
    right: -180px;
    width: 650px;
    height: 650px;
    background:
      radial-gradient(
        circle,
        rgba(37, 99, 235, 0.08),
        transparent 70%
      );
    border-radius: 50%;
    pointer-events: none;
  }

  .climate-hero::after {
    content: "";
    position: absolute;
    bottom: -250px;
    left: -180px;
    width: 550px;
    height: 550px;
    background:
      radial-gradient(
        circle,
        rgba(37, 99, 235, 0.05),
        transparent 70%
      );
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 64px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hero-content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-primary-light);
    color: var(--color-primary);
    padding: 7px 18px 7px 14px;
    border-radius: 40px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    width: fit-content;
  }

  .badge-icon {
    stroke-width: 2.5;
    flex-shrink: 0;
  }

  .hero-title {
    max-width: 650px;
    font-size: clamp(40px, 4.4vw, 58px);
    font-weight: 800;
    line-height: 1.07;
    color: var(--color-navy);
    margin: 0;
    letter-spacing: -0.035em;
  }

  .highlight {
    color: var(--color-primary);
    position: relative;
    z-index: 0;
  }

  .highlight::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 3px;
    height: 7px;
    background: rgba(37, 99, 235, 0.10);
    border-radius: 4px;
    z-index: -1;
  }

  .hero-desc {
    max-width: 540px;
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-text);
    margin: 0;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 2px;
  }

  .trust-indicators {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 22px;
    margin-top: 5px;
  }

  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-navy);
  }

  .trust-icon {
    color: var(--color-primary);
    stroke-width: 2.5;
    flex-shrink: 0;
  }

  /* ============================================================
     HERO VISUAL
  ============================================================ */

  .hero-visuals {
    position: relative;
    width: 100%;
    height: 560px;
    min-width: 0;
  }

  .visual-main {
    position: absolute;
    width: 72%;
    height: 82%;
    top: 9%;
    left: 14%;
    border-radius: var(--radius-image);
    overflow: hidden;
    box-shadow:
      0 24px 64px rgba(15, 23, 42, 0.12);
    z-index: 2;
    background: #e2e8f0;
  }

  .visual-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.5s ease;
  }

  .visual-main:hover img {
    transform: scale(1.015);
  }

  .visual-support {
    position: absolute;
    border-radius: 18px;
    overflow: hidden;
    box-shadow:
      0 8px 32px rgba(15, 23, 42, 0.10);
    border: 3px solid var(--color-white);
    background: var(--color-white);
    z-index: 4;
    transition: all var(--transition);
  }

  .visual-support:hover {
    transform: scale(1.04) translateY(-4px);
    box-shadow:
      0 16px 48px rgba(15, 23, 42, 0.15);
    z-index: 8;
  }

  .visual-support img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .support-1 {
    width: 32%;
    height: 28%;
    top: 0;
    right: 0;
  }

  .support-2 {
    width: 32%;
    height: 28%;
    bottom: 0;
    left: 0;
  }

  .support-label {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(6px);
    color: var(--color-white);
    font-size: 11px;
    font-weight: 600;
    padding: 5px 13px;
    border-radius: 40px;
    white-space: nowrap;
  }

  .floating-card {
    position: absolute;
    bottom: 10%;
    right: 1%;
    background: rgba(255, 255, 255, 0.94);
    padding: 14px 22px 14px 16px;
    border-radius: 16px;
    box-shadow:
      0 12px 40px rgba(15, 23, 42, 0.12);
    display: flex;
    align-items: center;
    gap: 11px;
    z-index: 6;
    animation: float 4s ease-in-out infinite;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(15, 23, 42, 0.05);
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-8px);
    }
  }

  .float-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--color-primary-light);
    border-radius: 50%;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .float-title {
    display: block;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.2;
  }

  .float-sub {
    display: block;
    font-size: 12px;
    color: var(--color-text);
    line-height: 1.4;
  }

  .service-tags {
    position: absolute;
    bottom: -3px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 7;
    flex-wrap: wrap;
    justify-content: center;
    width: max-content;
    max-width: 90%;
  }

  .tag {
    background: var(--color-white);
    border: 1px solid rgba(15, 23, 42, 0.08);
    padding: 6px 15px;
    border-radius: 40px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-navy);
    box-shadow:
      0 4px 12px rgba(15, 23, 42, 0.05);
    transition: all var(--transition);
    white-space: nowrap;
  }

  .tag:hover {
    background: var(--color-primary);
    color: var(--color-white);
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  /* ============================================================
     SERVICES
  ============================================================ */

  .services-section {
    padding: 110px 0;
    background: var(--color-white);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .service-card {
    min-width: 0;
    background: var(--color-white);
    border-radius: var(--radius-card);
    padding: 32px 28px 28px;
    border: 1px solid rgba(15, 23, 42, 0.06);
    box-shadow: var(--shadow-card);
    transition: all var(--transition);
    display: flex;
    flex-direction: column;
  }

  .service-card:hover {
    transform: translateY(-5px);
    border-color: rgba(37, 99, 235, 0.35);
    box-shadow: var(--shadow-hover);
  }

  .service-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background: var(--color-primary-light);
    border-radius: 14px;
    color: var(--color-primary);
    margin-bottom: 17px;
    transition: all var(--transition);
    flex-shrink: 0;
  }

  .service-card:hover .service-icon {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .service-title {
    font-size: 19px;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 9px;
    line-height: 1.35;
  }

  .service-desc {
    font-size: 14px;
    color: var(--color-text);
    line-height: 1.65;
    margin: 0 0 20px;
    flex: 1;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    transition: gap 0.25s ease;
    margin-top: auto;
  }

  .service-link:hover {
    gap: 11px;
  }

  .service-link svg {
    transition: transform 0.25s ease;
  }

  .service-link:hover svg {
    transform: translateX(4px);
  }

  /* ============================================================
     WHY
  ============================================================ */

  .why-section {
    padding: 110px 0;
    background: var(--color-primary-light);
  }

  .why-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 70px;
    align-items: center;
  }

  .why-image-wrapper {
    min-width: 0;
    position: relative;
  }

  .why-image-container {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-image);
    box-shadow:
      0 12px 48px rgba(15, 23, 42, 0.10);
  }

  .why-image-container img {
    width: 100%;
    height: 460px;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s ease;
  }

  .why-image-container:hover img {
    transform: scale(1.025);
  }

  .why-badge {
    position: absolute;
    bottom: 24px;
    left: 24px;
    background: rgba(255, 255, 255, 0.96);
    padding: 10px 19px;
    border-radius: 40px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-navy);
    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    gap: 8px;
    backdrop-filter: blur(8px);
  }

  .why-content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .why-title {
    font-size: 40px;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 17px;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .why-desc {
    max-width: 600px;
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-text);
    margin: 0 0 30px;
  }

  .why-benefits {
    display: flex;
    flex-direction: column;
    gap: 17px;
    margin-bottom: 32px;
    width: 100%;
  }

  .why-benefit {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .benefit-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    background: var(--color-white);
    border-radius: 50%;
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .why-benefit div {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .why-benefit strong {
    font-size: 15px;
    font-weight: 650;
    color: var(--color-navy);
    margin-bottom: 2px;
  }

  .why-benefit span:last-child {
    font-size: 14px;
    color: var(--color-text);
    line-height: 1.5;
  }

  .why-cta {
    align-self: flex-start;
  }

  /* ============================================================
     HOW IT WORKS
  ============================================================ */

  .how-section {
    padding: 110px 0;
    background: var(--color-white);
  }

  .steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: start;
    gap: 12px;
    max-width: 1020px;
    margin: 0 auto;
  }

  .step {
    min-width: 0;
    text-align: center;
    padding: 0 12px;
  }

  .step-number {
    font-size: 52px;
    font-weight: 800;
    color: rgba(37, 99, 235, 0.12);
    line-height: 1;
    margin-bottom: 9px;
    letter-spacing: -0.04em;
  }

  .step-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    background: var(--color-primary-light);
    border-radius: 15px;
    color: var(--color-primary);
    margin-bottom: 15px;
  }

  .step-title {
    font-size: 19px;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 9px;
    line-height: 1.3;
  }

  .step-desc {
    font-size: 14px;
    color: var(--color-text);
    line-height: 1.65;
    margin: 0;
  }

  .step-connector {
    width: 42px;
    height: 2px;
    background: var(--color-primary);
    opacity: 0.22;
    margin-top: 68px;
    flex-shrink: 0;
  }

  /* ============================================================
     CTA
  ============================================================ */

  .cta-section {
    padding: 90px 0;
    background: var(--color-white);
    position: relative;
    overflow: hidden;
  }

  .cta-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse at 50% 0%,
        rgba(37, 99, 235, 0.13),
        transparent 70%
      );
    pointer-events: none;
  }

  .cta-box {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    color: var(--color-navy);
  }

  .cta-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #044bc5;
    background: rgba(37, 99, 235, 0.12);
    padding: 6px 18px;
    border-radius: 40px;
    margin-bottom: 17px;
  }

  .cta-title {
    font-size: 42px;
    font-weight: 700;
    margin: 0 0 13px;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .cta-desc {
    max-width: 620px;
    margin: 0 auto 32px;
    font-size: 18px;
    color: var(--color-text);
    line-height: 1.7;
  }

  .cta-actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 35px;
  }

  .cta-footer {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 25px;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--color-slate);
  }

  .cta-footer > span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .footer-icon {
    color: var(--color-primary);
    stroke-width: 2.5;
  }

  /* ============================================================
     RTL
  ============================================================ */

  .rtl .hero-content,
  .rtl .why-content {
    align-items: flex-start;
  }

  .rtl .hero-actions,
  .rtl .trust-indicators {
    direction: rtl;
  }

  .rtl .why-benefit {
    flex-direction: row;
  }

  .rtl .why-badge {
    left: auto;
    right: 24px;
  }

  .rtl .why-cta {
    align-self: flex-start;
  }

  /* ============================================================
     1200px
  ============================================================ */

  @media (max-width: 1200px) {
    .container {
      padding-left: 24px;
      padding-right: 24px;
    }

    .hero-grid {
      gap: 42px;
    }

    .hero-title {
      font-size: 46px;
    }

    .hero-visuals {
      height: 500px;
    }

    .why-grid {
      gap: 45px;
    }

    .why-title {
      font-size: 36px;
    }
  }

  /* ============================================================
     1024px TABLET
  ============================================================ */

  @media (max-width: 1024px) {
    .climate-hero {
      padding: 60px 0 75px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .hero-content {
      align-items: center;
      text-align: center;
    }

    .hero-title {
      max-width: 760px;
      font-size: 48px;
    }

    .hero-desc {
      max-width: 720px;
    }

    .hero-actions {
      justify-content: center;
    }

    .trust-indicators {
      justify-content: center;
    }

    .hero-visuals {
      width: min(100%, 680px);
      height: 500px;
      margin: 0 auto;
    }

    .services-section,
    .why-section,
    .how-section {
      padding: 85px 0;
    }

    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .why-grid {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .why-image-wrapper {
      width: min(100%, 700px);
      margin: 0 auto;
    }

    .why-image-container img {
      height: 400px;
    }

    .why-content {
      max-width: 700px;
      margin: 0 auto;
      align-items: center;
      text-align: center;
    }

    .why-desc {
      max-width: 700px;
    }

    .why-benefits {
      max-width: 620px;
      text-align: left;
    }

    .why-cta {
      align-self: center;
    }

    .steps {
      grid-template-columns: 1fr;
      gap: 42px;
      max-width: 620px;
    }

    .step {
      padding: 0;
    }

    .step-connector {
      display: none;
    }

    .cta-title {
      font-size: 36px;
    }

    .rtl .why-content {
      align-items: center;
      text-align: center;
    }

    .rtl .why-benefits {
      text-align: right;
    }

    .rtl .why-cta {
      align-self: center;
    }
  }

  /* ============================================================
     768px MOBILE / TABLET
  ============================================================ */

  @media (max-width: 768px) {
    .container {
      padding-left: 18px;
      padding-right: 18px;
    }

    .climate-hero {
      margin-top: var(--header-h, 70px);
      padding: 55px 0 65px;
    }

    .hero-grid {
      gap: 38px;
    }

    .hero-content {
      gap: 17px;
    }

    .hero-badge {
      font-size: 11px;
      padding: 6px 14px 6px 11px;
    }

    .hero-title {
      font-size: clamp(32px, 7vw, 42px);
      line-height: 1.1;
    }

    .hero-desc {
      font-size: 15px;
      line-height: 1.7;
    }

    .hero-actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
      margin-top: 3px;
    }

    .hero-actions .btn {
      width: 100%;
      max-width: 360px;
      margin: 0 auto;
    }

    .trust-indicators {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      justify-items: center;
      margin-top: 5px;
    }

    .trust-item {
      justify-content: center;
      font-size: 12px;
      text-align: center;
    }

    /* HERO IMAGES */

    .hero-visuals {
      height: 420px;
      width: 100%;
      max-width: 580px;
    }

    .visual-main {
      width: 78%;
      height: 78%;
      top: 10%;
      left: 11%;
      border-radius: 22px;
    }

    .visual-support {
      border-width: 2px;
      border-radius: 14px;
    }

    .support-1,
    .support-2 {
