---
// src/pages/[lang]/services/carrelage.astro
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  lang?: "fr" | "ar" | "en";
  currentPath?: string;
}

const { lang = "fr", currentPath = "/services/carrelage" } = Astro.props;

const baseUrl = `/${lang}`;

// ============================================================
// ICON SYSTEM — clean inline SVG
// ============================================================
function icon(name: string, size: number = 24, className: string = ""): string {
  const icons: Record<string, string> = {
    wrench: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,

    "map-pin": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`,

    "check-circle": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,

    "arrow-right": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`,

    "arrow-down": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>`,

    settings: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>`,

    grid: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/></svg>`,

    layers: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="m12 2 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5"/><path d="m3 17 9 5 9-5"/></svg>`,

    "file-text": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h6"/></svg>`,

    clock: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`
  };

  return icons[name] || "";
}

// ============================================================
// MULTILINGUAL HERO CONTENT
// ============================================================
const heroContent: Record<string, any> = {
  fr: {
    badge: "Carrelage à Tanger",
    title: "Un intérieur à Tanger,<br/>avec une <span class=\"highlight\">finition parfaite</span>.",
    subtitle:
      "Besoin de poser, remplacer ou rénover votre carrelage ? AlloMealem vous met en relation avec des carreleurs de confiance à Tanger.",
    primaryCta: "Trouver un professionnel",
    secondaryCta: "Voir les services",
    trust: [
      "Carreleurs locaux",
      "Intervention à Tanger",
      "Travail soigné",
      "Professionnels vérifiés"
    ],
    imgAlt: "Carreleur professionnel réalisant des travaux de carrelage à Tanger"
  },

  ar: {
    badge: "تركيب البلاط في طنجة",
    title: "منزلك في طنجة،<br/>بتشطيب <span class=\"highlight\">مثالي</span>.",
    subtitle:
      "هل تحتاج إلى تركيب أو تغيير أو تجديد البلاط؟ يوصلك AlloMealem بحرفيين موثوقين في طنجة.",
    primaryCta: "ابحث عن حرفي",
    secondaryCta: "عرض الخدمات",
    trust: [
      "حرفيون محليون",
      "تدخل في طنجة",
      "عمل متقن",
      "محترفون موثوقون"
    ],
    imgAlt: "حرفي محترف يقوم بأعمال تركيب البلاط في طنجة"
  },

  en: {
    badge: "Tiling in Tangier",
    title: "Your home in Tangier,<br/>with a <span class=\"highlight\">perfect finish</span>.",
    subtitle:
      "Need to install, replace or renovate your tiles? AlloMealem connects you with trusted tiling professionals in Tangier.",
    primaryCta: "Find a professional",
    secondaryCta: "View services",
    trust: [
      "Local tilers",
      "Service in Tangier",
      "Quality work",
      "Verified professionals"
    ],
    imgAlt: "Professional tiler carrying out tile installation in Tangier"
  }
};

const content = heroContent[lang] || heroContent.fr;
---

<Layout lang={lang} currentPath={currentPath}>
  <Header lang={lang} />

  <!-- ============================================================
       HERO
  ============================================================ -->
  <section class="tiling-hero" id="hero">
    <div class="container">
      <div class="hero-grid">

        <!-- LEFT -->
        <div class="hero-content">

          <span class="hero-badge">
            <span set:html={icon("map-pin", 16, "badge-icon")}></span>
            {content.badge}
          </span>

          <h1 class="hero-title" set:html={content.title}></h1>

          <p class="hero-desc">
            {content.subtitle}
          </p>

          <div class="hero-actions">
            <a href='/contact' class="btn btn-primary">
              {content.primaryCta}
              <span set:html={icon("arrow-right", 18)}></span>
            </a>

            <a href="#services" class="btn btn-secondary">
              {content.secondaryCta}
            </a>
          </div>

          <div class="trust-indicators">
            {content.trust.map((item: string) => (
              <span class="trust-item">
                <span set:html={icon("check-circle", 18, "trust-icon")}></span>
                {item}
              </span>
            ))}
          </div>

        </div>

        <!-- RIGHT -->
        <div class="hero-visuals">

          <div class="visual-main">
            <img
              src="carellage.png"
              alt={content.imgAlt}
              loading="eager"
              decoding="async"
            />
          </div>

          <div class="visual-support support-1">
            <img
              src="carrelage.png"
              alt="Pose professionnelle de carrelage"
              loading="lazy"
              decoding="async"
            />
            <span class="support-label">Pose de carrelage</span>
          </div>

          <div class="visual-support support-2">
            <img
              src="carrelage2.png"
              alt="Carrelage intérieur professionnel"
              loading="lazy"
              decoding="async"
            />
            <span class="support-label">Rénovation</span>
          </div>

          <div class="floating-card">
            <span
              class="float-icon"
              set:html={icon("check-circle", 20)}
            ></span>

            <div>
              <span class="float-title">Travail soigné</span>
              <span class="float-sub">À Tanger</span>
            </div>
          </div>

          <div class="service-tags">
            <span class="tag">Sol</span>
            <span class="tag">Mur</span>
            <span class="tag">Salle de bain</span>
            <span class="tag">Terrasse</span>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SERVICES
  ============================================================ -->
  <section class="services-section" id="services">
    <div class="container">

      <div class="section-header">
        <span class="eyebrow">Nos services</span>

        <h2 class="section-title">
          Des solutions pour tous vos projets de carrelage
        </h2>

        <p class="section-desc">
          Pose, rénovation ou remplacement : trouvez le professionnel
          adapté à votre projet.
        </p>
      </div>

      <div class="services-grid">

        <div class="service-card">
          <div class="service-icon" set:html={icon("grid", 28)}></div>

          <h3 class="service-title">
            Pose de carrelage
          </h3>

          <p class="service-desc">
            Pose professionnelle de carrelage pour vos sols et vos murs.
          </p>

          <a href="#" class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)}></span>
          </a>
        </div>

        <div class="service-card">
          <div class="service-icon" set:html={icon("layers", 28)}></div>

          <h3 class="service-title">
            Carrelage au sol
          </h3>

          <p class="service-desc">
            Installation de carrelage durable et esthétique pour toutes vos pièces.
          </p>

          <a href="#" class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)}></span>
          </a>
        </div>

        <div class="service-card">
          <div class="service-icon" set:html={icon("grid", 28)}></div>

          <h3 class="service-title">
            Carrelage mural
          </h3>

          <p class="service-desc">
            Pose de faïence et de carrelage mural pour cuisines et salles de bain.
          </p>

          <a href="#" class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)}></span>
          </a>
        </div>

        <div class="service-card">
          <div class="service-icon" set:html={icon("settings", 28)}></div>

          <h3 class="service-title">
            Rénovation
          </h3>

          <p class="service-desc">
            Remplacement de votre ancien carrelage et rénovation de vos surfaces.
          </p>

          <a href="#" class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)}></span>
          </a>
        </div>

        <div class="service-card">
          <div class="service-icon" set:html={icon("layers", 28)}></div>

          <h3 class="service-title">
            Salle de bain
          </h3>

          <p class="service-desc">
            Pose de carrelage et faïence pour créer une salle de bain moderne.
          </p>

          <a href="#" class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)}></span>
          </a>
        </div>

        <div class="service-card">
          <div class="service-icon" set:html={icon("wrench", 28)}></div>

          <h3 class="service-title">
            Terrasse & extérieur
          </h3>

          <p class="service-desc">
            Pose de carrelage adapté aux terrasses, balcons et espaces extérieurs.
          </p>

          <a href="#" class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)}></span>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       WHY
  ============================================================ -->
  <section class="why-section" id="why">
    <div class="container">

      <div class="why-grid">

        <div class="why-image-wrapper">
          <div class="why-image-container">

            <img
              src="carrelage2.png"
              alt="Carreleur professionnel en intervention"
              loading="lazy"
              decoding="async"
            />

            <div class="why-badge">
              <span
                set:html={icon("check-circle", 18, "badge-icon")}
              ></span>
              Professionnels vérifiés
            </div>

          </div>
        </div>

        <div class="why-content">

          <span class="eyebrow">
            Pourquoi nous choisir ?
          </span>

          <h2 class="why-title">
            Un carrelage posé avec précision et savoir-faire
          </h2>

          <p class="why-desc">
            Nous vous aidons à trouver un carreleur adapté à votre projet,
            que ce soit pour une petite réparation, une rénovation ou une
            pose complète.
          </p>

          <div class="why-benefits">

            <div class="why-benefit">
              <span
                class="benefit-icon"
                set:html={icon("check-circle", 20)}
              ></span>

              <div>
                <strong>Carreleurs locaux</strong>
                <span>
                  Des professionnels disponibles à Tanger.
                </span>
              </div>
            </div>

            <div class="why-benefit">
              <span
                class="benefit-icon"
                set:html={icon("clock", 20)}
              ></span>

              <div>
                <strong>Intervention adaptée</strong>
                <span>
                  Une prise en charge selon votre projet et vos besoins.
                </span>
              </div>
            </div>

            <div class="why-benefit">
              <span
                class="benefit-icon"
                set:html={icon("file-text", 20)}
              ></span>

              <div>
                <strong>Prix transparents</strong>
                <span>
                  Des informations claires avant le début des travaux.
                </span>
              </div>
            </div>

          </div>

          <a
            href='/contact'
            class="btn btn-primary why-cta"
          >
            Demander un service
            <span set:html={icon("arrow-right", 18)}></span>
          </a>

        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       HOW IT WORKS
  ============================================================ -->
  <section class="how-section" id="how">
    <div class="container">

      <div class="section-header">

        <span class="eyebrow">
          Comment ça marche
        </span>

        <h2 class="section-title">
          Trouver un carreleur en quelques étapes
        </h2>

        <p class="section-desc">
          Un processus simple pour trouver rapidement le professionnel
          adapté à votre projet.
        </p>

      </div>

      <div class="steps">

        <div class="step">

          <div class="step-number">01</div>

          <div
            class="step-icon"
            set:html={icon("file-text", 28)}
          ></div>

          <h3 class="step-title">
            Décrivez votre projet
          </h3>

          <p class="step-desc">
            Expliquez le type de carrelage, la surface et les travaux
            que vous souhaitez réaliser.
          </p>

        </div>

        <div class="step-connector"></div>

        <div class="step">

          <div class="step-number">02</div>

          <div
            class="step-icon"
            set:html={icon("grid", 28)}
          ></div>

          <h3 class="step-title">
            Choisissez un professionnel
          </h3>

          <p class="step-desc">
            Consultez les professionnels disponibles pour votre demande
            à Tanger.
          </p>

        </div>

        <div class="step-connector"></div>

        <div class="step">

          <div class="step-number">03</div>

          <div
            class="step-icon"
            set:html={icon("clock", 28)}
          ></div>

          <h3 class="step-title">
            Planifiez l'intervention
          </h3>

          <p class="step-desc">
            Convenez directement des détails et de la date des travaux.
          </p>

        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       CTA
  ============================================================ -->
  <section class="cta-section" id="cta">
    <div class="container">

      <div class="cta-box">

        <span class="cta-badge">
          Carrelage à Tanger
        </span>

        <h2 class="cta-title">
          Besoin d'un carreleur ?
        </h2>

        <p class="cta-desc">
          Décrivez votre projet et trouvez un professionnel adapté
          à vos besoins à Tanger.
        </p>

        <div class="cta-actions">

          <a
            href='/contact'
            class="btn btn-primary btn-large"
          >
            Demander un service
            <span set:html={icon("arrow-right", 20)}></span>
          </a>

          <a
            href="#services"
            class="btn btn-secondary btn-large"
          >
            Voir nos services
            <span set:html={icon("arrow-down", 20)}></span>
          </a>

        </div>

        <div class="cta-footer">

          <span>
            <span
              set:html={icon("check-circle", 16, "footer-icon")}
            ></span>
            Carreleurs locaux
          </span>

          <span>
            <span
              set:html={icon("check-circle", 16, "footer-icon")}
            ></span>
            Intervention à Tanger
          </span>

          <span>
            <span
              set:html={icon("check-circle", 16, "footer-icon")}
            ></span>
            Professionnels vérifiés
          </span>

        </div>

      </div>
    </div>
  </section>

  <Footer lang={lang} />

  <!-- ============================================================
       SCROLL ANIMATION
  ============================================================ -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      );

      if (prefersReducedMotion.matches) {
        document
          .querySelectorAll(".fade-up")
          .forEach(el => el.classList.add("visible"));
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
            }
          });
        },
        {
          threshold: 0.12,
          rootMargin: "0px 0px -40px 0px"
        }
      );

      document
        .querySelectorAll(
          ".section-header, .service-card, .why-image-wrapper, .why-content, .step, .cta-box"
        )
        .forEach(el => {
          el.classList.add("fade-up");
          observer.observe(el);
        });

      document
        .querySelectorAll(".service-card")
        .forEach((el, i) => {
          (el as HTMLElement).style.transitionDelay =
            (i * 60) + "ms";
        });
    });
  </script>
</Layout>

<style>
  /* ============================================================
     FONT
  ============================================================ */
  @import url('https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..800&display=swap');

  :root {
    --color-primary: #2563eb;
    --color-primary-dark: #1d4ed8;
    --color-primary-light: #eff6ff;
    --color-navy: #0f172a;
    --color-text: #475569;
    --color-slate: #64748b;
    --color-bg: #f8fafc;
    --color-white: #ffffff;

    --radius-card: 22px;
    --radius-image: 28px;

    --shadow-card:
      0 4px 24px rgba(15, 23, 42, 0.06);

    --shadow-hover:
      0 12px 40px rgba(15, 23, 42, 0.10);

    --transition:
      0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);

    font-family:
      'Inter',
      system-ui,
      -apple-system,
      sans-serif;
  }

  body {
    font-family: inherit;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 28px;
  }

  /* ============================================================
     ANIMATIONS
  ============================================================ */

  .fade-up {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  .fade-up.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ============================================================
     EYEBROW
  ============================================================ */

  .eyebrow {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    background: var(--color-primary-light);
    padding: 4px 18px;
    border-radius: 40px;
    margin-bottom: 14px;
  }

  /* ============================================================
     SECTION HEADER
  ============================================================ */

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 52px;
  }

  .section-title {
    font-size: 40px;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 12px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .section-desc {
    font-size: 17px;
    color: var(--color-text);
    margin: 0;
    line-height: 1.6;
  }

  /* ============================================================
     BUTTONS
  ============================================================ */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 32px;
    border-radius: 60px;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    transition: all var(--transition);
    border: none;
    cursor: pointer;
    font-family: inherit;
    line-height: 1.2;
  }

  .btn-primary {
    background: var(--color-primary);
    color: var(--color-white);
    box-shadow:
      0 4px 20px rgba(37, 99, 235, 0.3);
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    transform: translateY(-3px);
    box-shadow:
      0 8px 32px rgba(37, 99, 235, 0.4);
  }

  .btn-primary svg {
    transition: transform 0.25s ease;
  }

  .btn-primary:hover svg {
    transform: translateX(4px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-navy);
    border: 2px solid rgba(15, 23, 42, 0.15);
  }

  .btn-secondary:hover {
    background: rgba(15, 23, 42, 0.04);
    border-color: var(--color-navy);
    transform: translateY(-3px);
  }

  .btn-large {
    padding: 18px 40px;
