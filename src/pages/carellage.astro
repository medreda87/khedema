```astro
---
// src/pages/[lang]/services/carrelage.astro

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  lang?: "fr" | "ar" | "en";
  currentPath?: string;
}

const { lang = "fr", currentPath = "/services/carrelage" } = Astro.props;

function icon(
  name: string,
  size: number = 24,
  className: string = ""
): string {
  const icons: Record<string, string> = {
    wrench: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,

    "map-pin": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`,

    "check-circle": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,

    "arrow-right": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`,

    "arrow-down": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>`,

    settings: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>`,

    grid: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/></svg>`,

    layers: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="m12 2 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5"/><path d="m3 17 9 5 9-5"/></svg>`,

    "file-text": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h6"/></svg>`,

    clock: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`
  };

  return icons[name] || "";
}

const heroContent: Record<string, any> = {
  fr: {
    badge: "Carrelage à Tanger",
    title:
      "Un intérieur à Tanger,<br/>avec une <span class=\"highlight\">finition parfaite</span>.",
    subtitle:
      "Besoin de poser, remplacer ou rénover votre carrelage ? AlloMealem vous met en relation avec des carreleurs de confiance à Tanger.",
    primaryCta: "Trouver un professionnel",
    secondaryCta: "Voir les services",
    trust: [
      "Carreleurs locaux",
      "Intervention à Tanger",
      "Travail soigné",
      "Professionnels vérifiés"
    ],
    imgAlt:
      "Carreleur professionnel réalisant des travaux de carrelage à Tanger"
  },

  ar: {
    badge: "تركيب البلاط في طنجة",
    title:
      "منزلك في طنجة،<br/>بتشطيب <span class=\"highlight\">مثالي</span>.",
    subtitle:
      "هل تحتاج إلى تركيب أو تغيير أو تجديد البلاط؟ يوصلك AlloMealem بحرفيين موثوقين في طنجة.",
    primaryCta: "ابحث عن حرفي",
    secondaryCta: "عرض الخدمات",
    trust: [
      "حرفيون محليون",
      "تدخل في طنجة",
      "عمل متقن",
      "محترفون موثوقون"
    ],
    imgAlt: "حرفي محترف يقوم بأعمال تركيب البلاط في طنجة"
  },

  en: {
    badge: "Tiling in Tangier",
    title:
      "Your home in Tangier,<br/>with a <span class=\"highlight\">perfect finish</span>.",
    subtitle:
      "Need to install, replace or renovate your tiles? AlloMealem connects you with trusted tiling professionals in Tangier.",
    primaryCta: "Find a professional",
    secondaryCta: "View services",
    trust: [
      "Local tilers",
      "Service in Tangier",
      "Quality work",
      "Verified professionals"
    ],
    imgAlt:
      "Professional tiler carrying out tile installation in Tangier"
  }
};

const content = heroContent[lang] || heroContent.fr;
const isArabic = lang === "ar";
---

<Layout lang={lang} currentPath={currentPath}>
  <Header lang={lang} />

  <main class:list={{ arabic: isArabic }} dir={isArabic ? "rtl" : "ltr"}>

    <!-- ============================================================
         HERO
    ============================================================ -->
    <section class="tiling-hero" id="hero">
      <div class="container">
        <div class="hero-grid">

          <div class="hero-content">

            <span class="hero-badge">
              <span set:html={icon("map-pin", 16, "badge-icon")}></span>
              {content.badge}
            </span>

            <h1
              class="hero-title"
              set:html={content.title}
            ></h1>

            <p class="hero-desc">
              {content.subtitle}
            </p>

            <div class="hero-actions">
              <a href="/contact" class="btn btn-primary">
                {content.primaryCta}
                <span set:html={icon("arrow-right", 18)}></span>
              </a>

              <a href="#services" class="btn btn-secondary">
                {content.secondaryCta}
              </a>
            </div>

            <div class="trust-indicators">
              {content.trust.map((item: string) => (
                <span class="trust-item">
                  <span
                    set:html={icon("check-circle", 18, "trust-icon")}
                  ></span>
                  {item}
                </span>
              ))}
            </div>

          </div>

          <div class="hero-visuals">

            <div class="visual-main">
              <img
                src="/carellage.avif"
                alt={content.imgAlt}
                loading="eager"
                decoding="async"
              />
            </div>

            <div class="visual-support support-1">
              <img
                src="/carrelage.avif"
                alt="Pose professionnelle de carrelage"
                loading="lazy"
                decoding="async"
              />
              <span class="support-label">
                Pose de carrelage
              </span>
            </div>

            <div class="visual-support support-2">
              <img
                src="/carrelage2.avif"
                alt="Carrelage intérieur professionnel"
                loading="lazy"
                decoding="async"
              />
              <span class="support-label">
                Rénovation
              </span>
            </div>

            <div class="floating-card">
              <span
                class="float-icon"
                set:html={icon("check-circle", 20)}
              ></span>

              <div>
                <span class="float-title">
                  Travail soigné
                </span>
                <span class="float-sub">
                  À Tanger
                </span>
              </div>
            </div>

            <div class="service-tags">
              <span class="tag">Sol</span>
              <span class="tag">Mur</span>
              <span class="tag">Salle de bain</span>
              <span class="tag">Terrasse</span>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SERVICES
    ============================================================ -->
    <section class="services-section" id="services">
      <div class="container">

        <div class="section-header">
          <span class="eyebrow">Nos services</span>

          <h2 class="section-title">
            Des solutions pour tous vos projets de carrelage
          </h2>

          <p class="section-desc">
            Pose, rénovation ou remplacement : trouvez le professionnel
            adapté à votre projet.
          </p>
        </div>

        <div class="services-grid">

          <div class="service-card">
            <div
              class="service-icon"
              set:html={icon("grid", 28)}
            ></div>

            <h3 class="service-title">
              Pose de carrelage
            </h3>

            <p class="service-desc">
              Pose professionnelle de carrelage pour vos sols et vos murs.
            </p>

            <a href="/contact" class="service-link">
              En savoir plus
              <span set:html={icon("arrow-right", 16)}></span>
            </a>
          </div>

          <div class="service-card">
            <div
              class="service-icon"
              set:html={icon("layers", 28)}
            ></div>

            <h3 class="service-title">
              Carrelage au sol
            </h3>

            <p class="service-desc">
              Installation de carrelage durable et esthétique pour toutes vos pièces.
            </p>

            <a href="/contact" class="service-link">
              En savoir plus
              <span set:html={icon("arrow-right", 16)}></span>
            </a>
          </div>

          <div class="service-card">
            <div
              class="service-icon"
              set:html={icon("grid", 28)}
            ></div>

            <h3 class="service-title">
              Carrelage mural
            </h3>

            <p class="service-desc">
              Pose de faïence et de carrelage mural pour cuisines et salles de bain.
            </p>

            <a href="/contact" class="service-link">
              En savoir plus
              <span set:html={icon("arrow-right", 16)}></span>
            </a>
          </div>

          <div class="service-card">
            <div
              class="service-icon"
              set:html={icon("settings", 28)}
            ></div>

            <h3 class="service-title">
              Rénovation
            </h3>

            <p class="service-desc">
              Remplacement de votre ancien carrelage et rénovation de vos surfaces.
            </p>

            <a href="/contact" class="service-link">
              En savoir plus
              <span set:html={icon("arrow-right", 16)}></span>
            </a>
          </div>

          <div class="service-card">
            <div
              class="service-icon"
              set:html={icon("layers", 28)}
            ></div>

            <h3 class="service-title">
              Salle de bain
            </h3>

            <p class="service-desc">
              Pose de carrelage et faïence pour créer une salle de bain moderne.
            </p>

            <a href="/contact" class="service-link">
              En savoir plus
              <span set:html={icon("arrow-right", 16)}></span>
            </a>
          </div>

          <div class="service-card">
            <div
              class="service-icon"
              set:html={icon("wrench", 28)}
            ></div>

            <h3 class="service-title">
              Terrasse & extérieur
            </h3>

            <p class="service-desc">
              Pose de carrelage adapté aux terrasses, balcons et espaces extérieurs.
            </p>

            <a href="/contact" class="service-link">
              En savoir plus
              <span set:html={icon("arrow-right", 16)}></span>
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- ============================================================
         WHY
    ============================================================ -->
    <section class="why-section" id="why">
      <div class="container">

        <div class="why-grid">

          <div class="why-image-wrapper">
            <div class="why-image-container">

              <img
                src="/carrelage2.avif"
                alt="Carreleur professionnel en intervention"
                loading="lazy"
                decoding="async"
              />

              <div class="why-badge">
                <span
                  set:html={icon("check-circle", 18, "badge-icon")}
                ></span>
                Professionnels vérifiés
              </div>

            </div>
          </div>

          <div class="why-content">

            <span class="eyebrow">
              Pourquoi nous choisir ?
            </span>

            <h2 class="why-title">
              Un carrelage posé avec précision et savoir-faire
            </h2>

            <p class="why-desc">
              Nous vous aidons à trouver un carreleur adapté à votre projet,
              que ce soit pour une petite réparation, une rénovation ou une
              pose complète.
            </p>

            <div class="why-benefits">

              <div class="why-benefit">
                <span
                  class="benefit-icon"
                  set:html={icon("check-circle", 20)}
                ></span>

                <div>
                  <strong>Carreleurs locaux</strong>
                  <span>
                    Des professionnels disponibles à Tanger.
                  </span>
                </div>
              </div>

              <div class="why-benefit">
                <span
                  class="benefit-icon"
                  set:html={icon("clock", 20)}
                ></span>

                <div>
                  <strong>Intervention adaptée</strong>
                  <span>
                    Une prise en charge selon votre projet et vos besoins.
                  </span>
                </div>
              </div>

              <div class="why-benefit">
                <span
                  class="benefit-icon"
                  set:html={icon("file-text", 20)}
                ></span>

                <div>
                  <strong>Prix transparents</strong>
                  <span>
                    Des informations claires avant le début des travaux.
                  </span>
                </div>
              </div>

            </div>

            <a
              href="/contact"
              class="btn btn-primary why-cta"
            >
              Demander un service
              <span set:html={icon("arrow-right", 18)}></span>
            </a>

          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         HOW IT WORKS
    ============================================================ -->
    <section class="how-section" id="how">
      <div class="container">

        <div class="section-header">
          <span class="eyebrow">
            Comment ça marche
          </span>

          <h2 class="section-title">
            Trouver un carreleur en quelques étapes
          </h2>

          <p class="section-desc">
            Un processus simple pour trouver rapidement le professionnel
            adapté à votre projet.
          </p>
        </div>

        <div class="steps">

          <div class="step">
            <div class="step-number">01</div>

            <div
              class="step-icon"
              set:html={icon("file-text", 28)}
            ></div>

            <h3 class="step-title">
              Décrivez votre projet
            </h3>

            <p class="step-desc">
              Expliquez le type de carrelage, la surface et les travaux
              que vous souhaitez réaliser.
            </p>
          </div>

          <div class="step-connector"></div>

          <div class="step">
            <div class="step-number">02</div>

            <div
              class="step-icon"
              set:html={icon("grid", 28)}
            ></div>

            <h3 class="step-title">
              Choisissez un professionnel
            </h3>

            <p class="step-desc">
              Consultez les professionnels disponibles pour votre demande
              à Tanger.
            </p>
          </div>

          <div class="step-connector"></div>

          <div class="step">
            <div class="step-number">03</div>

            <div
              class="step-icon"
              set:html={icon("clock", 28)}
            ></div>

            <h3 class="step-title">
              Planifiez l'intervention
            </h3>

            <p class="step-desc">
              Convenez directement des détails et de la date des travaux.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- ============================================================
         CTA
    ============================================================ -->
    <section class="cta-section" id="contact">
      <div class="container">

        <div class="cta-box">

          <span class="cta-badge">
            Carrelage à Tanger
          </span>

          <h2 class="cta-title">
            Besoin d'un carreleur ?
          </h2>

          <p class="cta-desc">
            Décrivez votre projet et trouvez un professionnel adapté
            à vos besoins à Tanger.
          </p>

          <div class="cta-actions">

            <a
              href="/contact"
              class="btn btn-primary btn-large"
            >
              Demander un service
              <span set:html={icon("arrow-right", 20)}></span>
            </a>

            <a
              href="#services"
              class="btn btn-secondary btn-large"
            >
              Voir nos services
              <span set:html={icon("arrow-down", 20)}></span>
            </a>

          </div>

          <div class="cta-footer">

            <span>
              <span
                set:html={icon("check-circle", 16, "footer-icon")}
              ></span>
              Carreleurs locaux
            </span>

            <span>
              <span
                set:html={icon("check-circle", 16, "footer-icon")}
              ></span>
              Intervention à Tanger
            </span>

            <span>
              <span
                set:html={icon("check-circle", 16, "footer-icon")}
              ></span>
              Professionnels vérifiés
            </span>

          </div>

        </div>
      </div>
    </section>

  </main>

  <Footer lang={lang} />

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      );

      const elements = document.querySelectorAll(
        ".section-header, .service-card, .why-image-wrapper, .why-content, .step, .cta-box"
      );

      if (prefersReducedMotion.matches) {
        elements.forEach((el) => el.classList.add("visible"));
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.12,
          rootMargin: "0px 0px -40px 0px"
        }
      );

      elements.forEach((el, i) => {
        el.classList.add("fade-up");

        if (el.classList.contains("service-card")) {
          (el as HTMLElement).style.transitionDelay =
            `${i * 60}ms`;
        }

        observer.observe(el);
      });
    });
  </script>
</Layout>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..800&display=swap");

  :global(*) {
    box-sizing: border-box;
  }

  :root {
    --color-primary: #2563eb;
    --color-primary-dark: #1d4ed8;
    --color-primary-light: #eff6ff;
    --color-navy: #0f172a;
    --color-text: #475569;
    --color-slate: #64748b;
    --color-bg: #f8fafc;
    --color-white: #ffffff;

    --radius-card: 22px;
    --radius-image: 28px;

    --shadow-card:
      0 4px 24px rgba(15, 23, 42, 0.06);

    --shadow-hover:
      0 12px 40px rgba(15, 23, 42, 0.1);

    --transition:
      0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);

    font-family:
      "Inter",
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    font-family: "Inter", system-ui, sans-serif;
    overflow-x: hidden;
  }

  .container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 28px;
  }

  /* ============================================================
     RTL
  ============================================================ */

  .arabic {
    font-family:
      "Arial",
      "Tahoma",
      sans-serif;
  }

  .arabic .hero-content,
  .arabic .why-content {
    text-align: right;
  }

  .arabic .hero-actions {
    justify-content: flex-start;
  }

  .arabic .trust-item,
  .arabic .why-benefit,
  .arabic .floating-card {
    direction: rtl;
  }

  .arabic .why-cta {
    align-self: flex-start;
  }

  /* ============================================================
     ANIMATIONS
  ============================================================ */

  .fade-up {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  .fade-up.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ============================================================
     EYEBROW
  ============================================================ */

  .eyebrow {
    display: inline-flex;
    align-items: center;
    width: fit-content;

    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;

    color: var(--color-primary);
    background: var(--color-primary-light);

    padding: 6px 18px;
    border-radius: 40px;
    margin-bottom: 14px;
  }

  /* ============================================================
     SECTION HEADER
  ============================================================ */

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 52px;
  }

  .section-title {
    font-size: clamp(30px, 4vw, 40px);
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 14px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .section-desc {
    font-size: 17px;
    color: var(--color-text);
    margin: 0;
    line-height: 1.65;
  }

  /* ============================================================
     BUTTONS
  ============================================================ */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;

    min-height: 52px;
    padding: 14px 30px;

    border-radius: 60px;
    font-weight: 600;
    font-size: 16px;

    text-decoration: none;
    transition: all var(--transition);

    border: 2px solid transparent;
    cursor: pointer;

    font-family: inherit;
    line-height: 1.2;
    white-space: nowrap;
  }

  .btn-primary {
    background: var(--color-primary);
    color: var(--color-white);

    box-shadow:
      0 4px 20px rgba(37, 99, 235, 0.3);
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    transform: translateY(-3px);

    box-shadow:
      0 8px 32px rgba(37, 99, 235, 0.4);
  }

  .btn-primary svg {
    transition: transform 0.25s ease;
  }

  .btn-primary:hover svg {
    transform: translateX(4px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-navy);

    border-color: rgba(15, 23, 42, 0.15);
  }

  .btn-secondary:hover {
    background: rgba(15, 23, 42, 0.04);
    border-color: var(--color-navy);
    transform: translateY(-3px);
  }

  .btn-large {
    min-height: 58px;
    padding: 17px 38px;
    font-size: 17px;
  }

  /* ============================================================
     HERO
  ============================================================ */

  .tiling-hero {
    position: relative;
    overflow: hidden;

    padding: 70px 0 90px;

    background: var(--color-bg);

    margin-top: var(--header-h, 76px);
  }

  .tiling-hero::before {
    content: "";

    position: absolute;
    top: -40%;
    right: -10%;

    width: 600px;
    height: 600px;

    background:
      radial-gradient(
        circle,
        rgba(37, 99, 235, 0.07),
        transparent 70%
      );

    border-radius: 50%;
    pointer-events: none;
  }

  .tiling-hero::after {
    content: "";

    position: absolute;
    bottom: -20%;
    left: -10%;

    width: 400px;
    height: 400px;

    background:
      radial-gradient(
        circle,
        rgba(37, 99, 235, 0.04),
        transparent 70%
      );

    border-radius: 50%;
    pointer-events: none;
  }

  .hero-grid {
    display: grid;

    grid-template-columns:
      minmax(0, 0.95fr)
      minmax(0, 1.2fr);

    gap: clamp(40px, 5vw, 70px);

    align-items: center;

    position: relative;
    z-index: 1;
  }

  .hero-content {
    min-width: 0;

    display: flex;
    flex-direction: column;
    align-items: flex-start;

    gap: 20px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    background: var(--color-primary-light);
    color: var(--color-primary);

    padding: 7px 18px 7px 14px;

    border-radius: 40px;

    font-size: 13px;
    font-weight: 600;

    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .badge-icon {
    stroke-width: 2.5;
    flex-shrink: 0;
  }

  .hero-title {
    max-width: 650px;

    font-size: clamp(36px, 4.2vw, 54px);
    font-weight: 800;

    line-height: 1.08;

    color: var(--color-navy);

    margin: 0;

    letter-spacing: -0.035em;
  }

  .highlight {
    color: var(--color-primary);
    position: relative;
    z-index: 1;
  }

  .highlight::after {
    content: "";

    position: absolute;

    bottom: 2px;
    left: 0;

    width: 100%;
    height: 6px;

    background: #dbeafe;

    border-radius: 4px;

    z-index: -1;
  }

  .hero-desc {
    max-width: 540px;

    font-size: 17px;
    line-height: 1.75;

    color: var(--color-text);

    margin: 0;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 14px;

    flex-wrap: wrap;

    margin-top: 4px;
  }

  .trust-indicators {
    display: flex;
    flex-wrap: wrap;

    gap: 12px 22px;

    margin-top: 6px;
  }

  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    font-size: 13px;
    font-weight: 500;

    color: var(--color-navy);
  }

  .trust-icon {
    color: var(--color-primary);
    stroke-width: 2.5;

    flex-shrink: 0;
  }

  /* ============================================================
     HERO VISUALS
  ============================================================ */

  .hero-visuals {
    position: relative;

    width: 100%;
    height: 560px;

    min-width: 0;
  }

  .visual-main {
    position: absolute;

    width: 72%;
    height: 82%;

    top: 9%;
    left: 14%;

    border-radius: var(--radius-image);

    overflow: hidden;

    box-shadow:
      0 24px 64px rgba(15, 23, 42, 0.12);

    z-index: 2;

    transition: transform 0.5s ease;
  }

  .visual-main:hover {
    transform: scale(1.01);
  }

  .visual-main img,
  .visual-support img,
  .why-image-container img {
    width: 100%;
    height: 100%;

    object-fit: cover;
    display: block;
  }

  /* ============================================================
     SUPPORT IMAGES
  ============================================================ */

  .visual-support {
    position: absolute;

    border-radius: 18px;

    overflow: hidden;

    box-shadow:
      0 8px 32px rgba(15, 23, 42, 0.1);

    border: 3px solid var(--color-white);

    background: var(--color-white);

    z-index: 3;

    transition: all var(--transition);

    cursor: pointer;
  }

  .visual-support:hover {
    transform: scale(1.05) translateY(-4px);

    box-shadow:
      0 16px 48px rgba(15, 23, 42, 0.15);

    z-index: 5;
  }

  .support-1 {
    width: 32%;
    height: 28%;

    top: 0;
    right: 0;

    z-index: 4;
  }

  .support-2 {
    width: 32%;
    height: 28%;

    bottom: 0;
    left: 0;

    z-index: 4;
  }

  .support-label {
    position: absolute;

    bottom: 8px;
    left: 50%;

    transform: translateX(-50%);

    background: rgba(15, 23, 42, 0.72);

    backdrop-filter: blur(5px);

    color: var(--color-white);

    font-size: 11px;
    font-weight: 600;

    padding: 4px 13px;

    border-radius: 40px;

    white-space: nowrap;
  }

  /* ============================================================
     FLOATING CARD
  ============================================================ */

  .floating-card {
    position: absolute;

    bottom: 10%;
    right: 2%;

    background: rgba(255, 255, 255, 0.94);

    padding: 15px 22px 15px 17px;

    border-radius: 16px;

    box-shadow:
      0 12px 40px rgba(15, 23, 42, 0.12);

    display: flex;
    align-items: center;
    gap: 12px;

    z-index: 6;

    border: 1px solid rgba(15, 23, 42, 0.04);

    animation: float 4s ease-in-out infinite;

    backdrop-filter: blur(8px);
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-8px);
    }
  }

  .float-icon {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 36px;
    height: 36px;

    background: var(--color-primary-light);

    border-radius: 50%;

    color: var(--color-primary);

    flex-shrink: 0;
  }

  .float-title {
    display: block;

    font-size: 15px;
    font-weight: 700;

    color: var(--color-navy);

    line-height: 1.2;
  }

  .float-sub {
    display: block;

    font-size: 13px;

    color: var(--color-text);

    line-height: 1.4;
  }

  /* ============================================================
     SERVICE TAGS
  ============================================================ */

  .service-tags {
    position: absolute;

    bottom: 0;
    left: 50%;

    transform: translateX(-50%);

    display: flex;

    gap: 8px;

    z-index: 7;

    flex-wrap: wrap;

    justify-content: center;

    width: max-content;
    max-width: 95%;
  }

  .tag {
    background: var(--color-white);

    border: 1px solid rgba(15, 23, 42, 0.08);

    padding: 6px 16px;

    border-radius: 40px;

    font-size: 12px;
    font-weight: 600;

    color: var(--color-navy);

    box-shadow:
      0 4px 12px rgba(15, 23, 42, 0.04);

    transition: all var(--transition);
  }

  .tag:hover {
    background: var(--color-primary);
    color: var(--color-white);

    border-color: var(--color-primary);

    transform: translateY(-2px);
  }

  /* ============================================================
     SERVICES
  ============================================================ */

  .services-section {
    padding: 100px 0;

    background: var(--color-white);
  }

  .services-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 24px;
  }

  .service-card {
    min-width: 0;

    background: var(--color-white);

    border-radius: var(--radius-card);

    padding: 30px 28px 27px;

    border: 1px solid rgba(15, 23, 42, 0.06);

    box-shadow: var(--shadow-card);

    transition: all var(--transition);

    display: flex;
    flex-direction: column;
  }

  .service-card:hover {
    transform: translateY(-5px);

    border-color: rgba(37, 99, 235, 0.45);

    box-shadow: var(--shadow-hover);
  }

  .service-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 56px;
    height: 56px;

    background: var(--color-primary-light);

    border-radius: 14px;

    color: var(--color-primary);

    margin-bottom: 17px;

    transition: all var(--transition);

    flex-shrink: 0;
  }

  .service-card:hover .service-icon {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .service-title {
    font-size: 19px;
    font-weight: 700;

    color: var(--color-navy);

    margin: 0 0 9px;
  }

  .service-desc {
    font-size: 14px;

    color: var(--color-text);

    line-height: 1.65;

    margin: 0 0 20px;

    flex: 1;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;

    width: fit-content;

    font-size: 14px;
    font-weight: 600;

    color: var(--color-primary);

    text-decoration: none;

    transition: gap 0.25s ease;
  }

  .service-link:hover {
    gap: 12px;
  }

  /* ============================================================
     WHY
  ============================================================ */

  .why-section {
    padding: 100px 0;

    background: var(--color-primary-light);
  }

  .why-grid {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1fr);

    gap: clamp(40px, 6vw, 70px);

    align-items: center;
  }

  .why-image-wrapper {
    min-width: 0;
  }

  .why-image-container {
    position: relative;

    border-radius: var(--radius-image);

    overflow: hidden;

    box-shadow:
      0 12px 48px rgba(15, 23, 42, 0.08);

    min-height: 420px;
  }

  .why-image-container img {
    min-height: 420px;

    transition: transform 0.6s ease;
  }

  .why-image-container:hover img {
    transform: scale(1.025);
  }

  .why-badge {
    position: absolute;

    bottom: 24px;
    left: 24px;

    background: var(--color-white);

    padding: 10px 20px;

    border-radius: 40px;

    font-size: 14px;
    font-weight: 600;

    color: var(--color-navy);

    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.08);

    display: flex;
    align-items: center;
    gap: 8px;
  }

  .why-content {
    display: flex;
    flex-direction: column;

    min-width: 0;
  }

  .why-title {
    font-size: clamp(30px, 3.4vw, 40px);

    font-weight: 700;

    color: var(--color-navy);

    margin: 0 0 17px;

    line-height: 1.15;

    letter-spacing: -0.025em;
  }

  .why-desc {
    font-size: 17px;

    line-height: 1.7;

    color: var(--color-text);

    margin: 0 0 30px;

    max-width: 620px;
  }

  .why-benefits {
    display: flex;
    flex-direction: column;

    gap: 17px;

    margin-bottom: 32px;
  }

  .why-benefit {
    display: flex;
    align-items: flex-start;

    gap: 14px;
  }

  .benefit-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 34px;
    height: 34px;

    background: var(--color-white);

    border-radius: 50%;

    color: var(--color-primary);

    flex-shrink: 0;

    margin-top: 2px;
  }

  .why-benefit div {
    display: flex;
    flex-direction: column;

    gap: 3px;
  }

  .why-benefit strong {
    font-size: 15px;
    font-weight: 700;

    color: var(--color-navy);
  }

  .why-benefit span:last-child {
    font-size: 14px;

    color: var(--color-text);

    line-height: 1.5;
  }

  .why-cta {
    align-self: flex-start;
  }

  /* ============================================================
     HOW
  ============================================================ */

  .how-section {
    padding: 100px 0;

    background: var(--color-white);
  }

  .steps {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto
      minmax(0, 1fr)
      auto
      minmax(0, 1fr);

    align-items: start;

    gap: 12px;

    max-width: 1000px;

    margin: 0 auto;
  }

  .step {
    text-align: center;

    padding: 0 10px;
  }

  .step-number {
    font-size: 52px;

    font-weight: 800;

    color: rgba(37, 99, 235, 0.12);

    line-height: 1;

    margin-bottom: 9px;

    letter-spacing: -0.04em;
  }

  .step-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 56px;
    height: 56px;

    background: var(--color-primary-light);

    border-radius: 14px;

    color: var(--color-primary);

    margin-bottom: 15px;
  }

  .step-title {
    font-size: 19px;

    font-weight: 700;

    color: var(--color-navy);

    margin: 0 0 9px;
  }

  .step-desc {
    font-size: 14px;

    color: var(--color-text);

    line-height: 1.65;

    margin: 0;
  }

  .step-connector {
    width: 42px;
    height: 2px;

    background: var(--color-primary);

    opacity: 0.25;

    margin-top: 45px;

    flex-shrink: 0;
  }

  /* ============================================================
     CTA
  ============================================================ */

  .cta-section {
    padding: 80px 0;

    background: var(--color-white);

    position: relative;

    overflow: hidden;
  }

  .cta-section::before {
    content: "";

    position: absolute;

    inset: 0;

    background:
      radial-gradient(
        ellipse at 50% 0%,
        rgba(37, 99, 235, 0.13),
        transparent 70%
      );

    pointer-events: none;
  }

  .cta-box {
    position: relative;

    z-index: 1;

    text-align: center;

    max-width: 800px;

    margin: 0 auto;
  }

  .cta-badge {
    display: inline-block;

    font-size: 13px;

    font-weight: 600;

    text-transform: uppercase;

    letter-spacing: 0.06em;

    color: #044bc5;

    background: rgba(37, 99, 235, 0.12);

    padding: 6px 18px;

    border-radius: 40px;

    margin-bottom: 16px;
  }

  .cta-title {
    font-size: clamp(30px, 4vw, 42px);

    font-weight: 700;

    color: var(--color-navy);

    margin: 0 0 13px;

    line-height: 1.15;

    letter-spacing: -0.02em;
  }

  .cta-desc {
    font-size: 18px;

    color: var(--color-text);

    line-height: 1.7;

    margin: 0 auto 32px;

    max-width: 650px;
  }

  .cta-actions {
    display: flex;

    gap: 14px;

    justify-content: center;

    flex-wrap: wrap;

    margin-bottom: 36px;
  }

  .cta-footer {
    display: flex;

    justify-content: center;

    gap: 25px;

    flex-wrap: wrap;

    font-size: 14px;

    color: var(--color-text);
  }

  .cta-footer span {
    display: flex;

    align-items: center;

    gap: 6px;
  }

  .footer-icon {
    color: var(--color-primary);

    stroke-width: 2.5;
  }

  /* ============================================================
     LARGE TABLET
  ============================================================ */

  @media (max-width: 1100px) {
    .hero-grid {
      grid-template-columns:
        minmax(0, 1fr)
        minmax(0, 1fr);

      gap: 35px;
    }

    .hero-title {
      font-size: 43px;
    }

    .hero-visuals {
      height: 480px;
    }

    .services-grid {
      gap: 20px;
    }

    .service-card {
      padding: 27px 23px;
    }

    .why-grid {
      gap: 40px;
    }
  }

  /* ============================================================
     TABLET
  ============================================================ */

  @media (max-width: 900px) {
    .tiling-hero {
      padding: 55px 0 75px;
    }

    .hero-grid {
      grid-template-columns: 1fr;

      gap: 45px;
    }

    .hero-content {
      align-items: center;

      text-align: center;
    }

    .hero-title {
      max-width: 760px;

      font-size: 44px;
    }

    .hero-desc {
      max-width: 650px;
    }

    .hero-actions {
      justify-content: center;
    }

    .trust-indicators {
      justify-content: center;
    }

    .hero-visuals {
      width: 100%;
      max-width: 650px;

      height: 480px;

      margin: 0 auto;
    }

    .services-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

    .why-grid {
      grid-template-columns: 1fr;

      gap: 45px;
    }

    .why-image-container {
      max-width: 700px;

      margin: 0 auto;

      min-height: 380px;
    }

    .why-image-container img {
      min-height: 380px;
    }

    .why-content {
      max-width: 700px;

      margin: 0 auto;

      text-align: center;

      align-items: center;
    }

    .why-desc {
      max-width: 700px;
    }

    .why-benefits {
      width: 100%;

      max-width: 600px;

      text-align: left;

      align-items: stretch;
    }

    .why-cta {
      align-self: center;
    }

    .steps {
      grid-template-columns: 1fr;

      max-width: 600px;

      gap: 36px;
    }

    .step-connector {
      display: none;
    }

    .step {
      padding: 0;
    }
  }

  /* ============================================================
     MOBILE
  ============================================================ */

  @media (max-width: 768px) {
    .container {
      padding: 0 18px;
    }

    .tiling-hero {
      margin-top: var(--header-h, 70px);

      padding: 45px 0 65px;
    }

    .hero-content {
      gap: 16px;
    }

    .hero-badge {
      font-size: 11px;

      padding: 6px 14px;
    }

    .hero-title {
      font-size: 34px;

      line-height: 1.12;

      letter-spacing: -0.025em;
    }

    .hero-desc {
      font-size: 15px;

      line-height: 1.7;
    }

    .hero-actions {
      flex-direction: column;

      width: 100%;

      gap: 10px;

      margin-top: 5px;
    }

    .hero-actions .btn {
      width: 100%;

      max-width: 360px;
    }

    .trust-indicators {
      flex-direction: column;

      align-items: center;

      gap: 9px;

      margin-top: 7px;
    }

    .trust-item {
      font-size: 13px;
    }

    /* Hero images */

    .hero-visuals {
      height: 390px;

      max-width: 560px;
    }

    .visual-main {
      width: 78%;
      height: 76%;

      top: 12%;
      left: 11%;

      border-radius: 22px;
    }

    .visual-support {
      border-radius: 14px;

      border-width: 2px;
    }

    .support-1,
    .support-2 {
      width: 34%;
      height: 25%;
    }

    .support-1 {
      top: 0;
      right: 0;
    }

    .support-2 {
      bottom: 0;
      left: 0;
    }

    .support-label {
      font-size: 9px;

      padding: 3px 9px;

      bottom: 5px;
    }

    .floating-card {
      right: 0;
      bottom: 8%;

      padding: 10px 14px;

      border-radius: 13px;

      gap: 8px;
    }

    .float-icon {
      width: 31px;
      height: 31px;
    }

    .float-title {
      font-size: 12px;
    }

    .float-sub {
      font-size: 10px;
    }

    .service-tags {
      bottom: -2px;

      gap: 5px;

      width: 100%;
    }

    .tag {
      font-size: 10px;

      padding: 4px 10px;
    }

    /* Sections */

    .services-section,
    .why-section,
    .how-section {
      padding: 70px 0;
    }

    .section-header {
      margin-bottom: 38px;
    }

    .eyebrow {
      font-size: 11px;

      padding: 5px 14px;
    }

    .section-title {
      font-size: 29px;

      line-height: 1.18;
    }

    .section-desc {
      font-size: 15px;
    }

    /* Services */

    .services-grid {
      grid-template-columns: 1fr;

      max-width: 500px;

      margin: 0 auto;

      gap: 16px;
    }

    .service-card {
      padding: 25px 22px;

      border-radius: 18px;
    }

    .service-icon {
      width: 52px;
      height: 52px;

      margin-bottom: 14px;
    }

    .service-title {
      font-size: 18px;
    }

    .service-desc {
      font-size: 14px;
    }

    /* Why */

    .why-grid {
      gap: 35px;
    }

    .why-image-container {
      min-height: 280px;

      border-radius: 22px;
    }

    .why-image-container img {
      min-height: 280px;
    }

    .why-badge {
      left: 14px;
      bottom: 14px;

      padding: 8px 14px;

      font-size: 12px;
    }

    .why-title {
      font-size: 29px;
    }

    .why-desc {
      font-size: 15px;

      line-height: 1.7;
    }

    .why-benefits {
      gap: 15px;

      margin-bottom: 27px;
