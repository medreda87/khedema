const content = pageContent[lang] || pageContent.fr;
---

<Layout lang={lang} currentPath={currentPath}>
  <Header lang={lang} />

  <!-- ============================================================
       HERO
  ============================================================ -->
  <section class="how-hero">
    <div class="hero-decoration hero-decoration-1"></div>
    <div class="hero-decoration hero-decoration-2"></div>

    <div class="container">
      <div class="hero-grid">

        <div class="hero-content">
          <span class="hero-badge">
            <span set:html={icon("search", 16)}></span>
            {content.badge}
          </span>

          <h1 class="hero-title" set:html={content.title}></h1>

          <p class="hero-desc">
            {content.subtitle}
          </p>

          <div class="hero-actions">
            <a href=`/contact` class="btn btn-primary">
              {content.primaryCta}
              <span set:html={icon("arrow", 18)}></span>
            </a>

            <a href='#services' class="btn btn-secondary">
              {content.secondaryCta}
            </a>
          </div>

          <div class="trust-indicators">
            {content.trust.map((item: string) => (
              <span class="trust-item">
                <span
                  class="trust-icon"
                  set:html={icon("check", 17)}
                ></span>
                {item}
              </span>
            ))}
          </div>
        </div>

        <!-- HERO VISUAL -->
        <div class="hero-visual">

          <div class="visual-card main-card">
            <div class="card-number">01</div>

            <div class="visual-icon">
              <span set:html={icon("file", 30)}></span>
            </div>

            <div class="visual-card-content">
              <span class="visual-small">
                {content.heroCardTitle}
              </span>

              <strong>
                {content.heroCardText}
              </strong>

              <span class="visual-sub">
                {content.heroCardSub}
              </span>
            </div>
          </div>

          <div class="floating-step step-one">
            <span class="floating-number">01</span>
            <div>
              <strong>{content.steps[0].title}</strong>
              <span>{content.steps[0].desc}</span>
            </div>
          </div>

          <div class="floating-step step-two">
            <span class="floating-number">02</span>
            <div>
              <strong>{content.steps[1].title}</strong>
              <span>{content.steps[1].desc}</span>
            </div>
          </div>

          <div class="floating-check">
            <span set:html={icon("check", 20)}></span>
          </div>

          <div class="visual-circle"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       STEPS
  ============================================================ -->
  <section class="steps-section" id="steps">
    <div class="container">

      <div class="section-header">
        <span class="eyebrow">{content.stepsEyebrow}</span>

        <h2 class="section-title">
          {content.stepsTitle}
        </h2>

        <p class="section-desc">
          {content.stepsDesc}
        </p>
      </div>

      <div class="steps-grid">
        {content.steps.map((step: any, index: number) => (
          <>
            <div class="step-card">

              <div class="step-top">
                <span class="step-number">
                  {step.number}
                </span>

                <span class="step-icon">
                  <span set:html={icon(step.icon, 28)}></span>
                </span>
              </div>

              <h3 class="step-title">
                {step.title}
              </h3>

              <p class="step-desc">
                {step.desc}
              </p>

              <div class="step-line"></div>
            </div>

            {index < content.steps.length - 1 && (
              <div class="step-arrow">
                <span set:html={icon("arrow", 24)}></span>
              </div>
            )}
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       WHY SECTION
  ============================================================ -->
  <section class="why-section">
    <div class="container">

      <div class="why-grid">

        <div class="why-visual">

          <div class="why-card card-main">
            <div class="why-card-icon">
              <span set:html={icon("shield", 28)}></span>
            </div>

            <div>
              <strong>{content.benefits[0].title}</strong>
              <span>{content.benefits[0].desc}</span>
            </div>
          </div>

          <div class="why-card card-small">
            <div class="small-icon">
              <span set:html={icon("map", 21)}></span>
            </div>

            <div>
              <strong>{content.benefits[1].title}</strong>
              <span>{content.benefits[1].desc}</span>
            </div>
          </div>

          <div class="why-decoration"></div>
        </div>

        <div class="why-content">

          <span class="eyebrow">
            {content.whyEyebrow}
          </span>

          <h2 class="why-title">
            {content.whyTitle}
          </h2>

          <p class="why-desc">
            {content.whyDesc}
          </p>

          <div class="benefits-list">
            {content.benefits.map((benefit: any) => (
              <div class="benefit">

                <div class="benefit-icon">
                  <span set:html={icon(benefit.icon, 21)}></span>
                </div>

                <div class="benefit-content">
                  <strong>{benefit.title}</strong>
                  <span>{benefit.desc}</span>
                </div>

              </div>
            ))}
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SERVICES
  ============================================================ -->
  <section class="services-section" id="services">
    <div class="container">

      <div class="section-header">
        <span class="eyebrow">
          {content.examplesEyebrow}
        </span>

        <h2 class="section-title">
          {content.examplesTitle}
        </h2>

        <p class="section-desc">
          {content.examplesDesc}
        </p>
      </div>

      <div class="service-pills">
        {content.services.map((service: string, index: number) => (
          <a
            href="#service"
            class="service-pill"
          >
            <span class="pill-number">
              0{index + 1}
            </span>

            <span>{service}</span>

            <span
              class="pill-arrow"
              set:html={icon("arrow", 17)}
            ></span>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- ============================================================
       CTA
  ============================================================ -->
  <section class="cta-section">
    <div class="container">

      <div class="cta-box">

        <div class="cta-decoration"></div>

        <span class="cta-badge">
          {content.ctaBadge}
        </span>

        <h2 class="cta-title">
          {content.ctaTitle}
        </h2>

        <p class="cta-desc">
          {content.ctaDesc}
        </p>

        <div class="cta-actions">

          <a
            href='/contact'
            class="btn btn-primary btn-large"
          >
            {content.ctaPrimary}
            <span set:html={icon("arrow", 20)}></span>
          </a>

          <a
            href='/#service'
            class="btn btn-secondary btn-large"
          >
            {content.ctaSecondary}
            <span set:html={icon("arrowDown", 20)}></span>
          </a>

        </div>

        <div class="cta-footer">
          {content.trust.map((item: string) => (
            <span>
              <span set:html={icon("check", 16)}></span>
              {item}
            </span>
          ))}
        </div>

      </div>
    </div>
  </section>

  <Footer lang={lang} />

  <!-- ============================================================
       SCROLL ANIMATION
  ============================================================ -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      );

      const elements = document.querySelectorAll(
        ".section-header, .step-card, .why-content, .why-visual, .service-pill, .cta-box"
      );

      if (prefersReducedMotion.matches) {
        elements.forEach((el) => el.classList.add("visible"));
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.12,
          rootMargin: "0px 0px -40px 0px"
        }
      );

      elements.forEach((el) => {
        el.classList.add("fade-up");
        observer.observe(el);
      });

      document.querySelectorAll(".step-card").forEach((el, i) => {
        (el as HTMLElement).style.transitionDelay =
          `${i * 100}ms`;
      });

      document.querySelectorAll(".service-pill").forEach((el, i) => {
        (el as HTMLElement).style.transitionDelay =
          `${i * 60}ms`;
      });
    });
  </script>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..800&display=swap');

  :root {
    --color-primary: #2563eb;
    --color-primary-dark: #1d4ed8;
    --color-primary-light: #eff6ff;
    --color-navy: #0f172a;
    --color-text: #475569;
    --color-slate: #64748b;
    --color-bg: #f8fafc;
    --color-white: #ffffff;

    --radius-card: 22px;
    --radius-image: 28px;

    --shadow-card:
      0 4px 24px rgba(15, 23, 42, 0.06);

    --shadow-hover:
      0 16px 45px rgba(15, 23, 42, 0.11);

    --transition:
      0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);

    font-family:
      'Inter',
      system-ui,
      -apple-system,
      sans-serif;
  }

  body {
    font-family: inherit;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 28px;
  }

  /* ============================================================
     GLOBAL
  ============================================================ */

  .fade-up {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  .fade-up.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .eyebrow {
    display: inline-block;
    width: fit-content;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    background: var(--color-primary-light);
    padding: 5px 18px;
    border-radius: 40px;
    margin-bottom: 14px;
  }

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 60px;
  }

  .section-title {
    font-size: 40px;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 14px;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .section-desc {
    font-size: 17px;
    color: var(--color-text);
    margin: 0;
    line-height: 1.7;
  }

  /* ============================================================
     BUTTONS
  ============================================================ */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 14px 32px;
    border-radius: 60px;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    transition: all var(--transition);
    border: none;
    cursor: pointer;
    font-family: inherit;
    line-height: 1.2;
  }

  .btn-primary {
    background: var(--color-primary);
    color: var(--color-white);
    box-shadow:
      0 5px 22px rgba(37, 99, 235, 0.28);
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    transform: translateY(-3px);
    box-shadow:
      0 10px 32px rgba(37, 99, 235, 0.35);
  }

  .btn-primary svg {
    transition: transform 0.25s ease;
  }

  .btn-primary:hover svg {
    transform: translateX(4px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-navy);
    border: 2px solid rgba(15, 23, 42, 0.13);
  }

  .btn-secondary:hover {
    background: rgba(15, 23, 42, 0.04);
    border-color: var(--color-navy);
    transform: translateY(-3px);
  }

  .btn-large {
    padding: 18px 40px;
    font-size: 18px;
  }

  /* ============================================================
     HERO
  ============================================================ */

  .how-hero {
    position: relative;
    overflow: hidden;
    padding: 90px 0 100px;
    background: var(--color-bg);
    margin-top: var(--header-h, 76px);
  }

  .hero-decoration {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-decoration-1 {
    width: 620px;
    height: 620px;
    top: -350px;
    right: -120px;
    background:
      radial-gradient(
        circle,
        rgba(37, 99, 235, 0.09),
        transparent 70%
      );
  }

  .hero-decoration-2 {
    width: 450px;
    height: 450px;
    bottom: -280px;
    left: -160px;
    background:
      radial-gradient(
        circle,
        rgba(37, 99, 235, 0.06),
        transparent 70%
      );
  }

  .hero-grid {
    position: relative;
    z-index: 1;

    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    background: var(--color-primary-light);
    padding: 7px 18px 7px 14px;
    border-radius: 40px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .hero-title {
    font-size: 54px;
    font-weight: 800;
    line-height: 1.08;
    color: var(--color-navy);
    margin: 0;
    letter-spacing: -0.035em;
  }

  .highlight {
    position: relative;
    color: var(--color-primary);
  }

  .highlight::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 4px;
    width: 100%;
    height: 7px;
    background: var(--color-primary-light);
    border-radius: 5px;
    z-index: -1;
  }

  .hero-desc {
    max-width: 570px;
    margin: 0;
    color: var(--color-text);
    font-size: 17px;
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 4px;
  }

  .trust-indicators {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 24px;
    margin-top: 8px;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-navy);
  }

  .trust-icon {
    color: var(--color-primary);
  }

  /* ============================================================
     HERO VISUAL
  ============================================================ */

  .hero-visual {
    position: relative;
    height: 500px;
  }

  .visual-circle {
    position: absolute;
    width: 390px;
    height: 390px;
    border-radius: 50%;
    background:
      linear-gradient(
        145deg,
        rgba(37, 99, 235, 0.12),
        rgba(37, 99, 235, 0.025)
      );
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .visual-card {
    position: absolute;
    z-index: 3;
  }

  .main-card {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 310px;
    padding: 30px;
    border-radius: 26px;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(15, 23, 42, 0.06);
    box-shadow:
      0 30px 70px rgba(15, 23, 42, 0.12);
    backdrop-filter: blur(12px);
  }

  .card-number {
    position: absolute;
    top: -20px;
    right: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: 18px;
    background: var(--color-primary);
    color: white;
    font-size: 18px;
    font-weight: 800;
    box-shadow:
      0 10px 28px rgba(37, 99, 235, 0.3);
  }

  .visual-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 20px;
    color: var(--color-primary);
    background: var(--color-primary-light);
    margin-bottom: 24px;
  }

  .visual-card-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .visual-small {
    color: var(--color-slate);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .visual-card-content strong {
    color: var(--color-navy);
    font-size: 23px;
    line-height: 1.2;
  }

  .visual-sub {
    color: var(--color-text);
    font-size: 14px;
  }

  .floating-step {
    position: absolute;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 230px;
    padding: 14px;
    background: white;
    border-radius: 16px;
    border: 1px solid rgba(15, 23, 42, 0.06);
    box-shadow:
      0 12px 35px rgba(15, 23, 42, 0.1);
  }

  .step-one {
    top: 65px;
    left: 0;
    animation: floatOne 5s ease-in-out infinite;
  }

  .step-two {
    right: 0;
    bottom: 70px;
    animation: floatTwo 5s ease-in-out infinite;
  }

  .floating-number {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    color: var(--color-primary);
    background: var(--color-primary-light);
    font-size: 13px;
    font-weight: 800;
  }

  .floating-step div {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .floating-step strong {
    color: var(--color-navy);
    font-size: 13px;
  }

  .floating-step span:last-child {
    color: var(--color-slate);
    font-size: 11px;
    line-height: 1.35;
  }

  .floating-check {
    position: absolute;
    z-index: 6;
    right: 70px;
    top: 35px;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: white;
    background: var(--color-primary);
    box-shadow:
      0 10px 28px rgba(37, 99, 235, 0.3);
    animation: floatCheck 4s ease-in-out infinite;
  }

  @keyframes floatOne {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @keyframes floatTwo {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }

  @keyframes floatCheck {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-7px) rotate(5deg); }
  }

  /* ============================================================
     STEPS
  ============================================================ */

  .steps-section {
    padding: 110px 0;
    background: white;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
  }

  .step-card {
    position: relative;
    padding: 30px;
    min-height: 300px;
    border-radius: var(--radius-card);
    background: white;
    border: 1px solid rgba(15, 23, 42, 0.06);
    box-shadow: var(--shadow-card);
    transition: all var(--transition);
  }

  .step-card:hover {
    transform: translateY(-7px);
    box-shadow: var(--shadow-hover);
    border-color: rgba(37, 99, 235, 0.2);
  }

  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 25px;
  }

  .step-number {
    color: rgba(37, 99, 235, 0.12);
    font-size: 46px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .step-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    color: var(--color-primary);
    background: var(--color-primary-light);
    border-radius: 16px;
  }

  .step-title {
    color: var(--color-navy);
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 12px;
  }

  .step-desc {
    color: var(--color-text);
    font-size: 14px;
    line-height: 1.7;
    margin: 0;
  }

  .step-line {
    position: absolute;
    bottom: 0;
    left: 30px;
    width: 45px;
    height: 3px;
    border-radius: 4px 4px 0 0;
    background: var(--color-primary);
  }

  .step-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    color: var(--color-primary);
    opacity: 0.5;
  }

  /* ============================================================
     WHY
  ============================================================ */

  .why-section {
    padding: 110px 0;
    background: var(--color-primary-light);
  }

  .why-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 90px;
    align-items: center;
  }

  .why-visual {
    position: relative;
    height: 470px;
  }

  .why-decoration {
    position: absolute;
    width: 330px;
    height: 330px;
    border-radius: 50%;
    left: 30px;
    top: 60px;
    background:
      radial-gradient(
        circle,
        rgba(37, 99, 235, 0.16),
        transparent 70%
      );
  }

  .why-card {
    position: absolute;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: white;
    border: 1px solid rgba(15, 23, 42, 0.05);
    box-shadow:
      0 20px 55px rgba(15, 23, 42, 0.09);
  }

  .card-main {
    width: 300px;
    left: 30px;
    top: 85px;
    padding: 28px;
    border-radius: 24px;
  }

  .card-small {
    width: 270px;
    right: 0;
    bottom: 65px;
    padding: 20px;
    border-radius: 18px;
  }

  .why-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 15px;
    color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .small-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .why-card div:last-child {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .why-card strong {
    color: var(--color-navy);
    font-size: 16px;
  }

  .why-card span:last-child {
    color: var(--color-text);
    font-size: 13px;
    line-height: 1.5;
  }

  .why-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .why-title {
    max-width: 600px;
    color: var(--color-navy);
    font-size: 42px;
    font-weight: 700;
    line-height: 1.13;
    letter-spacing: -0.025em;
    margin: 0 0 18px;
  }

  .why-desc {
    max-width: 590px;
    color: var(--color-text);
    font-size: 17px;
    line-height: 1.7;
    margin: 0 0 34px;
  }

  .benefits-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 30px;
  }

  .benefit {
    display: flex;
    gap: 13px;
    align-items: flex-start;
  }

  .benefit-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    color: var(--color-primary);
    background: white;
    border-radius: 12px;
  }

  .benefit-content {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .benefit-content strong {
    color: var(--color-navy);
    font-size: 14px;
  }

  .benefit-content span {
    color: var(--color-text);
    font-size: 12px;
    line-height: 1.5;
  }

  /* ============================================================
     SERVICES
  ============================================================ */

  .services-section {
    padding: 110px 0;
    background: white;
  }

  .service-pills {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    max-width: 950px;
    margin: 0 auto;
  }

  .service-pill {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 18px 20px;
    color: var(--color-navy);
    text-decoration: none;
    background: white;
    border: 1px solid rgba(15, 23, 42, 0.07);
    border-radius: 16px;
    box-shadow: var(--shadow-card);
    transition: all var(--transition);
  }

  .service-pill:hover {
    color: var(--color-primary);
    border-color: rgba(37, 99, 235, 0.25);
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .pill-number {
    color: var(--color-primary);
    font-size: 12px;
    font-weight: 800;
    opacity: 0.6;
  }

  .service-pill > span:nth-child(2) {
    flex: 1;
    font-size: 15px;
    font-weight: 600;
  }

  .pill-arrow {
    display: flex;
    transition: transform 0.25s ease;
  }

  .service-pill:hover .pill-arrow {
    transform: translateX(4px);
  }

  /* ============================================================
     CTA
  ============================================================ */

  .cta-section {
    padding: 90px 0;
    background: white;
  }

  .cta-box {
    position: relative;
    overflow: hidden;
    max-width: 900px;
    margin: 0 auto;
    padding: 70px 40px;
    text-align: center;
    border-radius: 30px;
    background:
      linear-gradient(
        135deg,
        #eff6ff,
        #ffffff
      );
    border: 1px solid rgba(37, 99, 235, 0.1);
  }

  .cta-decoration {
    position: absolute;
    width: 400px;
    height: 400px;
    top: -260px;
    right: -100px;
    border-radius: 50%;
    background:
      radial-gradient(
        circle,
        rgba(37, 99, 235, 0.12),
        transparent 70%
      );
  }

  .cta-badge {
    position: relative;
    z-index: 1;
    display: inline-block;
    margin-bottom: 16px;
    padding: 5px 18px;
    color: var(--color-primary);
    background: white;
    border-radius: 40px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cta-title {
    position: relative;
    z-index: 1;
    color: var(--color-navy);
    font-size: 42px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin: 0 0 13px;
  }

  .cta-desc {
    position: relative;
    z-index: 1;
    max-width: 600px;
    margin: 0 auto 30px;
    color: var(--color-text);
    font-size: 17px;
    line-height: 1.7;
  }

  .cta-actions {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 30px;
  }

  .cta-footer {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
    color: var(--color-text);
    font-size: 13px;
  }

  .cta-footer > span {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cta-footer svg {
    color: var(--color-primary);
  }

  /* ============================================================
     RESPONSIVE
  ============================================================ */

  @media (max-width: 1100px) {
    .hero-title {
      font-size: 46px;
    }

    .hero-grid {
      gap: 50px;
    }

    .why-grid {
      gap: 50px;
    }

    .why-title {
      font-size: 36px;
    }
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 70px;
    }

    .hero-content {
      align-items: center;
      text-align: center;
    }

    .hero-desc {
      max-width: 700px;
    }

    .hero-actions,
    .trust-indicators {
      justify-content: center;
    }

    .hero-visual {
      max-width: 650px;
      width: 100%;
      margin: 0 auto;
    }

    .steps-grid {
      grid-template-columns: 1fr;
      gap: 25px;
      max-width: 520px;
    }

    .step-arrow {
      display: none;
    }

    .why-grid {
      grid-template-columns: 1fr;
    }

    .why-visual {
      max-width: 600px;
      width: 100%;
      margin: 0 auto;
    }

    .why-content {
      align-items: center;
      text-align: center;
    }

    .why-desc {
      max-width: 700px;
    }

    .benefits-list {
      text-align: left;
      width: 100%;
      max-width: 700px;
    }

    .service-pills {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 20px;
    }

    .how-hero {
      padding: 75px 0 70px;
    }

    .hero-title {
      font-size: 36px;
    }

    .hero-desc {
      font-size: 16px;
    }

    .hero-actions {
      width: 100%;
      flex-direction: column;
    }

    .hero-actions .btn {
      width: 100%;
      max-width: 320px;
    }

    .trust-indicators {
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }

    .hero-visual {
      height: 420px;
    }

    .visual-circle {
      width: 310px;
      height: 310px;
    }

    .main-card {
      width: 270px;
      padding: 25px;
    }

    .floating-step {
      width: 190px;
    }

    .step-one {
      left: 0;
      top: 35px;
    }

    .step-two {
      right: 0;
      bottom: 40px;
    }

    .floating-check {
      right: 35px;
      top: 15px;
    }

    .steps-section,
    .why-section,
    .services-section {
      padding: 75px 0;
    }

    .section-title {
      font-size: 31px;
    }

    .section-header {
      margin-bottom: 42px;
    }

    .why-visual {
      height: 390px;
    }

    .card-main {
      left: 0;
      width: 280px;
    }

    .card-small {
      right: 0;
      width: 245px;
    }

    .why-title {
      font-size: 31px;
    }

    .benefits-list {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .service-pills {
      grid-template-columns: 1fr;
      max-width: 500px;
    }

    .cta-section {
      padding: 60px 0;
