---
// src/pages/[lang]/services/electricien.astro
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  lang?: "fr" | "ar" | "en";
  currentPath?: string;
}

const {
  lang = "fr",
  currentPath = "/services/electricien",
} = Astro.props;

const baseUrl = `/${lang}`;

// ============================================================
// ICON SYSTEM
// ============================================================

function icon(
  name: string,
  size: number = 24,
  className: string = ""
): string {
  const icons: Record<string, string> = {
    "map-pin": `
      <svg xmlns="http://www.w3.org/2000/svg"
        width="${size}" height="${size}" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"
        class="${className}">
        <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/>
        <circle cx="12" cy="10" r="3"/>
      </svg>
    `,

    "check-circle": `
      <svg xmlns="http://www.w3.org/2000/svg"
        width="${size}" height="${size}" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"
        class="${className}">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
    `,

    "arrow-right": `
      <svg xmlns="http://www.w3.org/2000/svg"
        width="${size}" height="${size}" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"
        class="${className}">
        <line x1="5" y1="12" x2="19" y2="12"/>
        <polyline points="12 5 19 12 12 19"/>
      </svg>
    `,

    "arrow-down": `
      <svg xmlns="http://www.w3.org/2000/svg"
        width="${size}" height="${size}" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"
        class="${className}">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <polyline points="19 12 12 19 5 12"/>
      </svg>
    `,

    wrench: `
      <svg xmlns="http://www.w3.org/2000/svg"
        width="${size}" height="${size}" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"
        class="${className}">
        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
      </svg>
    `,

    settings: `
      <svg xmlns="http://www.w3.org/2000/svg"
        width="${size}" height="${size}" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"
        class="${className}">
        <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
        <circle cx="12" cy="12" r="3"/>
      </svg>
    `,

    zap: `
      <svg xmlns="http://www.w3.org/2000/svg"
        width="${size}" height="${size}" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"
        class="${className}">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
      </svg>
    `,

    lightbulb: `
      <svg xmlns="http://www.w3.org/2000/svg"
        width="${size}" height="${size}" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"
        class="${className}">
        <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/>
        <path d="M9 18h6"/>
        <path d="M10 22h4"/>
      </svg>
    `,

    plug: `
      <svg xmlns="http://www.w3.org/2000/svg"
        width="${size}" height="${size}" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"
        class="${className}">
        <path d="M12 22v-5"/>
        <path d="M9 8V2"/>
        <path d="M15 8V2"/>
        <path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8z"/>
      </svg>
    `,

    clock: `
      <svg xmlns="http://www.w3.org/2000/svg"
        width="${size}" height="${size}" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"
        class="${className}">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
      </svg>
    `,

    "file-text": `
      <svg xmlns="http://www.w3.org/2000/svg"
        width="${size}" height="${size}" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"
        class="${className}">
        <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="16" y1="13" x2="8" y2="13"/>
        <line x1="16" y1="17" x2="8" y2="17"/>
        <polyline points="10 9 9 9 8 9"/>
      </svg>
    `,
  };

  return icons[name] || "";
}

// ============================================================
// MULTILINGUAL HERO CONTENT
// ============================================================

const heroContent = {
  fr: {
    badge: "Électricité à Tanger",
    title: `Votre maison à Tanger,<br/>entre de <span class="highlight">bonnes mains</span>.`,
    subtitle:
      "Besoin d'un électricien pour une installation, une panne ou une réparation ? AlloMealem vous met en relation avec des électriciens de confiance à Tanger.",
    primaryCta: "Trouver un professionnel",
    secondaryCta: "Voir les services",
    trust: [
      "Électriciens locaux",
      "Intervention à Tanger",
      "Intervention rapide",
      "Professionnels vérifiés",
    ],
    imgAlt: "Électricien professionnel intervenant à Tanger",
  },

  ar: {
    badge: "الكهرباء في طنجة",
    title: `منزلك في طنجة،<br/>بين <span class="highlight">أيدٍ أمينة</span>.`,
    subtitle:
      "هل تحتاج إلى كهربائي للتركيب أو الإصلاح أو حل عطل كهربائي؟ يوصلك AlloMealem بكهربائيين موثوقين في طنجة.",
    primaryCta: "ابحث عن حرفي",
    secondaryCta: "عرض الخدمات",
    trust: [
      "كهربائيون محليون",
      "تدخل في طنجة",
      "تدخل سريع",
      "محترفون موثوقون",
    ],
    imgAlt: "كهربائي محترف يقدم خدمات الكهرباء في طنجة",
  },

  en: {
    badge: "Electrical services in Tangier",
    title: `Your home in Tangier,<br/>in <span class="highlight">good hands</span>.`,
    subtitle:
      "Need an electrician for an installation, repair or electrical issue? AlloMealem connects you with trusted electricians in Tangier.",
    primaryCta: "Find a professional",
    secondaryCta: "View services",
    trust: [
      "Local electricians",
      "Service in Tangier",
      "Fast service",
      "Verified professionals",
    ],
    imgAlt: "Professional electrician providing electrical services in Tangier",
  },
};

const content = heroContent[lang] || heroContent.fr;
---

<Layout lang={lang} currentPath={currentPath}>
  <Header lang={lang} />

  <!-- ============================================================
       HERO
  ============================================================ -->

  <section class="electrician-hero" id="hero">
    <div class="container">
      <div class="hero-grid">

        <!-- CONTENT -->
        <div class="hero-content">

          <span class="hero-badge">
            <span set:html={icon("map-pin", 16, "badge-icon")} />
            {content.badge}
          </span>

          <h1
            class="hero-title"
            set:html={content.title}
          />

          <p class="hero-desc">
            {content.subtitle}
          </p>

          <div class="hero-actions">

            <a
              href='/contact'
              class="btn btn-primary"
            >
              {content.primaryCta}
              <span
                set:html={icon("arrow-right", 18)}
              />
            </a>

            <a
              href="#services"
              class="btn btn-secondary"
            >
              {content.secondaryCta}
            </a>

          </div>

          <div class="trust-indicators">
            {
              content.trust.map((item) => (
                <span class="trust-item">
                  <span
                    set:html={icon(
                      "check-circle",
                      18,
                      "trust-icon"
                    )}
                  />
                  {item}
                </span>
              ))
            }
          </div>

        </div>

        <!-- VISUAL -->
        <div class="hero-visuals">

          <!-- Main image -->
          <div class="visual-main">
            <img
              src="/elictricien2.png"
              alt={content.imgAlt}
              loading="eager"
              decoding="async"
            />
          </div>

          <!-- Supporting image 1 -->
          <div class="visual-support support-1">
            <img
              src="/elictricien.png"
              alt="Électricien travaillant sur un tableau électrique"
              loading="lazy"
              decoding="async"
            />

            <span class="support-label">
              Installation électrique
            </span>
          </div>

          <!-- Supporting image 2 -->
          <div class="visual-support support-2">
            <img
              src="/elictricien1.png"
              alt="Électricien installant une prise"
              loading="lazy"
              decoding="async"
            />

            <span class="support-label">
              Dépannage
            </span>
          </div>

          <!-- Floating card -->
          <div class="floating-card">

            <span
              class="float-icon"
              set:html={icon("check-circle", 20)}
            />

            <div>
              <span class="float-title">
                Intervention rapide
              </span>

              <span class="float-sub">
                À Tanger
              </span>
            </div>

          </div>

          <!-- Tags -->
          <div class="service-tags">
            <span class="tag">Installation</span>
            <span class="tag">Dépannage</span>
            <span class="tag">Tableau électrique</span>
            <span class="tag">Éclairage</span>
            <span class="tag">Prises électriques</span>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SERVICES
  ============================================================ -->

  <section class="services-section" id="services">
    <div class="container">

      <div class="section-header">
        <span class="eyebrow">
          Nos services
        </span>

        <h2 class="section-title">
          Des solutions pour tous vos besoins en électricité
        </h2>

        <p class="section-desc">
          Installation, réparation ou dépannage : trouvez un
          électricien adapté à votre besoin.
        </p>
      </div>

      <div class="services-grid">

        <div class="service-card">
          <div class="service-icon">
            <span set:html={icon("zap", 28)} />
          </div>

          <h3 class="service-title">
            Dépannage électrique
          </h3>

          <p class="service-desc">
            Intervention rapide pour vos pannes et problèmes électriques.
          </p>

          <a href='/contact' class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)} />
          </a>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <span set:html={icon("zap", 28)} />
          </div>

          <h3 class="service-title">
            Installation électrique
          </h3>

          <p class="service-desc">
            Installation et mise en place de vos équipements électriques.
          </p>

          <a href='/contact' class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)} />
          </a>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <span set:html={icon("settings", 28)} />
          </div>

          <h3 class="service-title">
            Tableau électrique
          </h3>

          <p class="service-desc">
            Installation, remplacement et mise en conformité
            de votre tableau électrique.
          </p>

          <a href='/contact' class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)} />
          </a>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <span set:html={icon("lightbulb", 28)} />
          </div>

          <h3 class="service-title">
            Éclairage
          </h3>

          <p class="service-desc">
            Installation de luminaires, spots et solutions d'éclairage.
          </p>

          <a href='/contact' class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)} />
          </a>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <span set:html={icon("plug", 28)} />
          </div>

          <h3 class="service-title">
            Prises et interrupteurs
          </h3>

          <p class="service-desc">
            Installation et remplacement de prises et interrupteurs électriques.
          </p>

          <a href='/contact' class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)} />
          </a>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <span set:html={icon("wrench", 28)} />
          </div>

          <h3 class="service-title">
            Rénovation électrique
          </h3>

          <p class="service-desc">
            Rénovation et modernisation de vos installations électriques.
          </p>

          <a href='/contact' class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)} />
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       WHY US
  ============================================================ -->

  <section class="why-section" id="why">
    <div class="container">

      <div class="why-grid">

        <div class="why-image-wrapper">
          <div class="why-image-container">

            <img
              src="/elictricien2.png"
              alt="Électricien professionnel en intervention"
              loading="lazy"
              decoding="async"
            />

            <div class="why-badge">
              <span
                set:html={icon("check-circle", 18, "badge-icon")}
              />
              Professionnels vérifiés
            </div>

          </div>
        </div>

        <div class="why-content">

          <span class="eyebrow">
            Pourquoi nous choisir ?
          </span>

          <h2 class="why-title">
            Une intervention simple, rapide et fiable
          </h2>

          <p class="why-desc">
            Nous vous aidons à trouver un électricien adapté à votre
            besoin, avec une expérience claire et sans complication.
          </p>

          <div class="why-benefits">

            <div class="why-benefit">
              <span class="benefit-icon">
                <span set:html={icon("check-circle", 20)} />
              </span>

              <div>
                <strong>Électriciens locaux</strong>
                <span>
                  Des professionnels disponibles à Tanger.
                </span>
              </div>
            </div>

            <div class="why-benefit">
              <span class="benefit-icon">
                <span set:html={icon("clock", 20)} />
              </span>

              <div>
                <strong>Intervention rapide</strong>
                <span>
                  Une prise en charge adaptée à votre situation.
                </span>
              </div>
            </div>

            <div class="why-benefit">
              <span class="benefit-icon">
                <span set:html={icon("file-text", 20)} />
              </span>

              <div>
                <strong>Prix transparents</strong>
                <span>
                  Des informations claires avant l'intervention.
                </span>
              </div>
            </div>

          </div>

          <a
            href='/contact'
            class="btn btn-primary why-cta"
          >
            Demander un service
            <span set:html={icon("arrow-right", 18)} />
          </a>

        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       HOW IT WORKS
  ============================================================ -->

  <section class="how-section" id="how">
    <div class="container">

      <div class="section-header">

        <span class="eyebrow">
          Comment ça marche
        </span>

        <h2 class="section-title">
          Trouver un électricien en quelques étapes
        </h2>

        <p class="section-desc">
          Un processus simple pour vous permettre de trouver rapidement
          le professionnel adapté.
        </p>

      </div>

      <div class="steps">

        <div class="step">
          <div class="step-number">01</div>

          <div class="step-icon">
            <span set:html={icon("file-text", 28)} />
          </div>

          <h3 class="step-title">
            Décrivez votre besoin
          </h3>

          <p class="step-desc">
            Expliquez simplement le problème ou le travail électrique
            à réaliser.
          </p>
        </div>

        <div class="step-connector"></div>

        <div class="step">
          <div class="step-number">02</div>

          <div class="step-icon">
            <span set:html={icon("wrench", 28)} />
          </div>

          <h3 class="step-title">
            Choisissez un professionnel
          </h3>

          <p class="step-desc">
            Consultez les électriciens disponibles pour votre demande.
          </p>
        </div>

        <div class="step-connector"></div>

        <div class="step">
          <div class="step-number">03</div>

          <div class="step-icon">
            <span set:html={icon("clock", 28)} />
          </div>

          <h3 class="step-title">
            Planifiez l'intervention
          </h3>

          <p class="step-desc">
            Convenez directement des détails de l'intervention.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       FINAL CTA
  ============================================================ -->

  <section class="cta-section" id="cta">
    <div class="container">

      <div class="cta-box">

        <span class="cta-badge">
          Électricité à Tanger
        </span>

        <h2 class="cta-title">
          Besoin d'un électricien ?
        </h2>

        <p class="cta-desc">
          Décrivez votre besoin et trouvez un professionnel adapté
          à Tanger.
        </p>

        <div class="cta-actions">

          <a
            href='/contact'
            class="btn btn-primary btn-large"
          >
            Demander un service
            <span set:html={icon("arrow-right", 20)} />
          </a>

          <a
            href="#services"
            class="btn btn-secondary btn-large"
          >
            Voir nos services
            <span set:html={icon("arrow-down", 20)} />
          </a>

        </div>

        <div class="cta-footer">

          <span>
            <span
              set:html={icon("check-circle", 16, "footer-icon")}
            />
            Électriciens locaux
          </span>

          <span>
            <span
              set:html={icon("check-circle", 16, "footer-icon")}
            />
            Intervention à Tanger
          </span>

          <span>
            <span
              set:html={icon("check-circle", 16, "footer-icon")}
            />
            Professionnels vérifiés
          </span>

        </div>

      </div>
    </div>
  </section>

  <Footer lang={lang} />

  <!-- ============================================================
       SCROLL ANIMATION
  ============================================================ -->

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      );

      const elements = document.querySelectorAll(
        ".section-header, .service-card, .why-image-wrapper, .why-content, .step, .cta-box"
      );

      if (reducedMotion.matches) {
        elements.forEach((element) => {
          element.classList.add("fade-up", "visible");
        });

        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.12,
          rootMargin: "0px 0px -40px 0px",
        }
      );

      elements.forEach((element, index) => {
        element.classList.add("fade-up");

        if (element.classList.contains("service-card")) {
          element.style.transitionDelay = `${index * 60}ms`;
        }

        observer.observe(element);
      });
    });
  </script>
</Layout>

<style>
  /* ============================================================
     FONT
  ============================================================ */

  @import url("https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..800&display=swap");

  /* ============================================================
     ROOT
  ============================================================ */

  :root {
    --color-primary: #2563eb;
    --color-primary-dark: #1d4ed8;
    --color-primary-light: #eff6ff;

    --color-navy: #0f172a;
    --color-text: #475569;
    --color-slate: #64748b;

    --color-bg: #f8fafc;
    --color-white: #ffffff;

    --radius-card: 22px;
    --radius-image: 28px;

    --shadow-card:
      0 4px 24px rgba(15, 23, 42, 0.06);

    --shadow-hover:
      0 12px 40px rgba(15, 23, 42, 0.10);

    --transition:
      0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);

    font-family:
      "Inter",
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  html {
    scroll-behavior: smooth;
    overflow-x: hidden;
  }

  body {
    margin: 0;
    font-family: inherit;
    overflow-x: hidden;
  }

  * {
    box-sizing: border-box;
  }

  img {
    max-width: 100%;
  }

  /* ============================================================
     CONTAINER
  ============================================================ */

  .container {
    width: min(1280px, 100%);
    margin: 0 auto;
    padding: 0 28px;
  }

  /* ============================================================
     ANIMATION
  ============================================================ */

  .fade-up {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  .fade-up.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ============================================================
     EYEBROW
  ============================================================ */

  .eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: fit-content;

    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;

    color: var(--color-primary);
    background: var(--color-primary-light);

    padding: 6px 18px;
    border-radius: 40px;

    margin-bottom: 14px;
  }

  /* ============================================================
     SECTION HEADER
  ============================================================ */

  .section-header {
    width: 100%;
    max-width: 720px;

    text-align: center;

    margin: 0 auto 52px;
  }

  .section-title {
    font-size: 40px;
    font-weight: 750;
    color: var(--color-navy);

    margin: 0 0 14px;

    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .section-desc {
    font-size: 17px;
    color: var(--color-text);

    margin: 0;
    line-height: 1.7;
  }

  /* ============================================================
     BUTTONS
  ============================================================ */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 9px;

    min-height: 50px;

    padding: 14px 30px;

    border-radius: 999px;

    font-family: inherit;
    font-size: 16px;
    font-weight: 650;

    text-decoration: none;

    cursor: pointer;

    border: 2px solid transparent;

    transition:
      background var(--transition),
      color var(--transition),
      border-color var(--transition),
      transform var(--transition),
      box-shadow var(--transition);
  }

  .btn svg {
    flex-shrink: 0;
  }

  .btn-primary {
    background: var(--color-primary);
    color: var(--color-white);

    box-shadow:
      0 5px 22px rgba(37, 99, 235, 0.28);
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);

    transform: translateY(-3px);

    box-shadow:
      0 10px 32px rgba(37, 99, 235, 0.36);
  }

  .btn-primary svg {
    transition: transform 0.25s ease;
  }

  .btn-primary:hover svg {
    transform: translateX(4px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-navy);

    border-color: rgba(15, 23, 42, 0.15);
  }

  .btn-secondary:hover {
    background: rgba(15, 23, 42, 0.04);

    border-color: var(--color-navy);

    transform: translateY(-3px);
  }

  .btn-large {
    min-height: 58px;

    padding: 17px 38px;

    font-size: 17px;
  }

  /* ============================================================
     HERO
  ============================================================ */

  .electrician-hero {
    position: relative;

    padding:
      70px 0
      90px;

    background: var(--color-bg);

    overflow: hidden;

    margin-top: var(--header-h, 76px);
  }

  .electrician-hero::before {
    content: "";

    position: absolute;

    top: -300px;
    right: -150px;

    width: 700px;
    height: 700px;

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(37, 99, 235, 0.08),
        transparent 68%
      );

    pointer-events: none;
  }

  .electrician-hero::after {
    content: "";

    position: absolute;

    bottom: -200px;
    left: -150px;

    width: 500px;
    height: 500px;

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(37, 99, 235, 0.05),
        transparent 70%
      );

    pointer-events: none;
  }

  .hero-grid {
    display: grid;

    grid-template-columns:
      minmax(0, 0.9fr)
      minmax(0, 1.1fr);

    gap: clamp(40px, 5vw, 70px);

    align-items: center;

    position: relative;
    z-index: 2;
  }

  .hero-content {
    min-width: 0;

    display: flex;
    flex-direction: column;

    gap: 20px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;

    gap: 8px;

    width: fit-content;

    padding: 7px 17px 7px 13px;

    border-radius: 999px;

    background: var(--color-primary-light);
    color: var(--color-primary);

    font-size: 13px;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .badge-icon {
    flex-shrink: 0;
    stroke-width: 2.5;
  }

  .hero-title {
    max-width: 650px;

    font-size: clamp(38px, 4.2vw, 56px);

    font-weight: 800;

    line-height: 1.06;

    color: var(--color-navy);

    margin: 0;

    letter-spacing: -0.035em;
  }

  .highlight {
    position: relative;

    color: var(--color-primary);

    display: inline-block;
  }

  .highlight::after {
    content: "";

    position: absolute;

    left: 0;
    right: 0;

    bottom: 4px;

    height: 7px;

    border-radius: 999px;

    background: var(--color-primary-light);

    z-index: -1;
  }

  .hero-desc {
    max-width: 560px;

    font-size: 17px;

    line-height: 1.75;

    color: var(--color-text);

    margin: 0;
  }

  .hero-actions {
    display: flex;

    align-items: center;

    flex-wrap: wrap;

    gap: 14px;

    margin-top: 4px;
  }

  .trust-indicators {
    display: flex;

    flex-wrap: wrap;

    gap: 12px 22px;

    margin-top: 8px;
  }

  .trust-item {
    display: inline-flex;

    align-items: center;

    gap: 7px;

    font-size: 13px;
    font-weight: 600;

    color: var(--color-navy);
  }

  .trust-icon {
    flex-shrink: 0;

    color: var(--color-primary);

    stroke-width: 2.5;
  }

  /* ============================================================
     HERO VISUALS
  ============================================================ */

  .hero-visuals {
    position: relative;

    width: 100%;
    height: 570px;

    min-width: 0;
  }

  .visual-main {
    position: absolute;

    top: 8%;
    left: 13%;

    width: 74%;
    height: 82%;

    overflow: hidden;

    border-radius: var(--radius-image);

    background: #e2e8f0;

    box-shadow:
      0 24px 65px rgba(15, 23, 42, 0.14);

    z-index: 2;

    transition:
      transform 0.5s ease;
  }

  .visual-main:hover {
    transform: scale(1.01);
  }

  .visual-main img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
  }

  .visual-support {
    position: absolute;

    overflow: hidden;

    background: var(--color-white);

    border: 3px solid var(--color-white);

    border-radius: 18px;

    box-shadow:
      0 10px 34px rgba(15, 23, 42, 0.12);

    z-index: 4;

    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .visual-support:hover {
    transform:
      translateY(-5px)
      scale(1.04);

    box-shadow:
      0 18px 50px rgba(15, 23, 42, 0.16);

    z-index: 8;
  }

  .visual-support img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
  }

  .support-1 {
    top: 0;
    right: 0;

    width: 31%;
    height: 27%;
  }

  .support-2 {
    bottom: 0;
    left: 0;

    width: 31%;
    height: 27%;
  }

  .support-label {
    position: absolute;

    left: 50%;
    bottom: 8px;

    transform: translateX(-50%);

    white-space: nowrap;

    max-width: calc(100% - 12px);

    overflow: hidden;
    text-overflow: ellipsis;

    padding: 5px 11px;

    border-radius: 999px;

    background: rgba(15, 23, 42, 0.72);

    backdrop-filter: blur(7px);

    color: var(--color-white);

    font-size: 10px;
    font-weight: 700;
  }

  /* ============================================================
     FLOATING CARD
  ============================================================ */

  .floating-card {
    position: absolute;

    right: 1%;
    bottom: 11%;

    display: flex;
    align-items: center;

    gap: 12px;

    min-width: 185px;

    padding: 15px 21px 15px 16px;

    background: rgba(255, 255, 255, 0.94);

    border: 1px solid rgba(15, 23, 42, 0.05);

    border-radius: 17px;

    box-shadow:
      0 13px 40px rgba(15, 23, 42, 0.13);

    backdrop-filter: blur(10px);

    z-index: 7;

    animation:
      floatingCard 4s ease-in-out infinite;
  }

  @keyframes floatingCard {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-8px);
    }
  }

  .float-icon {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 38px;
    height: 38px;

    flex: 0 0 38px;

    border-radius: 50%;

    background: var(--color-primary-light);

    color: var(--color-primary);
  }

  .float-title {
    display: block;

    color: var(--color-navy);

    font-size: 14px;
    font-weight: 750;

    line-height: 1.25;
  }

  .float-sub {
    display: block;

    margin-top: 3px;

    color: var(--color-text);

    font-size: 12px;

    line-height: 1.25;
  }

  /* ============================================================
     SERVICE TAGS
  ============================================================ */

  .service-tags {
    position: absolute;

    left: 50%;
    bottom: 0;

    transform: translateX(-50%);

    width: max-content;
    max-width: 94%;

    display: flex;

    justify-content: center;
    align-items: center;

    flex-wrap: wrap;

    gap: 7px;

    z-index: 9;
  }

  .tag {
    padding: 6px 14px;

    border-radius: 999px;

    background: var(--color-white);

    border: 1px solid rgba(15, 23, 42, 0.08);

    color: var(--color-navy);

    font-size: 11px;
    font-weight: 650;

    white-space: nowrap;

    box-shadow:
      0 4px 13px rgba(15, 23, 42, 0.05);

    transition:
      all var(--transition);
  }

  .tag:hover {
    color: var(--color-white);

    background: var(--color-primary);

    border-color: var(--color-primary);

    transform: translateY(-2px);
  }

  /* ============================================================
     SERVICES
  ============================================================ */

  .services-section {
    padding: 105px 0;

    background: var(--color-white);
  }

  .services-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 24px;
  }

  .service-card {
    min-width: 0;

    display: flex;
    flex-direction: column;

    padding: 32px 28px 28px;

    background: var(--color-white);

    border:
      1px solid rgba(15, 23, 42, 0.055);

    border-radius: var(--radius-card);

    box-shadow: var(--shadow-card);

    transition:
      transform var(--transition),
      border-color var(--transition),
      box-shadow var(--transition);
  }

  .service-card:hover {
    transform: translateY(-6px);

    border-color: rgba(37, 99, 235, 0.5);

    box-shadow: var(--shadow-hover);
  }

  .service-icon {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 56px;
    height: 56px;

    margin-bottom: 17px;

    border-radius: 15px;

    background: var(--color-primary-light);

    color: var(--color-primary);

    transition:
      background var(--transition),
      color var(--transition),
      transform var(--transition);
  }

  .service-card:hover .service-icon {
    background: var(--color-primary);
    color: var(--color-white);

    transform: scale(1.04);
  }

  .service-title {
    font-size: 19px;
    font-weight: 750;

    line-height: 1.3;

    color: var(--color-navy);

    margin: 0 0 9px;
  }

  .service-desc {
    flex: 1;

    font-size: 14px;

    line-height: 1.65;

    color: var(--color-text);

    margin: 0 0 22px;
  }

  .service-link {
    display: inline-flex;
    align-items: center;

    gap: 7px;

    width: fit-content;

    color: var(--color-primary);

    font-size: 14px;
    font-weight: 700;

    text-decoration: none;

    transition: gap 0.25s ease;
  }

  .service-link:hover {
    gap: 12px;
  }

  /* ============================================================
     WHY
  ============================================================ */

  .why-section {
    padding: 105px 0;

    background: var(--color-primary-light);
  }

  .why-grid {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1fr);

    gap: clamp(45px, 6vw, 80px);

    align-items: center;
  }

  .why-image-wrapper {
    min-width: 0;
  }

  .why-image-container {
    position: relative;

    overflow: hidden;

    border-radius: var(--radius-image);

    box-shadow:
      0 16px 52px rgba(15, 23, 42, 0.10);
  }

  .why-image-container img {
    width: 100%;
    height: 460px;

    display: block;

    object-fit: cover;

    transition:
      transform 0.6s ease;
  }

  .why-image-container:hover img {
    transform: scale(1.025);
  }

  .why-badge {
    position: absolute;

    left: 22px;
    bottom: 22px;

    display: flex;
    align-items: center;

    gap: 8px;

    padding: 10px 18px;

    border-radius: 999px;

    background: var(--color-white);

    color: var(--color-navy);

    font-size: 13px;
    font-weight: 700;

    box-shadow:
      0 5px 22px rgba(0, 0, 0, 0.10);
  }

  .why-content {
    min-width: 0;

    display: flex;
    flex-direction: column;

    align-items: flex-start;
  }

  .why-title {
    max-width: 580px;

    font-size: 40px;
    font-weight: 750;

    line-height: 1.15;

    letter-spacing: -0.025em;

    color: var(--color-navy);

    margin: 0 0 17px;
  }

  .why-desc {
    max-width: 580px;

    font-size: 17px;

    line-height: 1.7;

    color: var(--color-text);

    margin: 0 0 30px;
  }

  .why-benefits {
    width: 100%;

    display: flex;
    flex-direction: column;

    gap: 18px;

    margin-bottom: 32px;
  }

  .why-benefit {
    display: flex;
    align-items: flex-start;

    gap: 14px;
  }

  .benefit-icon {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 34px;
    height: 34px;

    flex: 0 0 34px;

    margin-top: 1px;

    border-radius: 50%;

    background: var(--color-white);

    color: var(--color-primary);

    box-shadow:
      0 2px 8px rgba(15, 23, 42, 0.04);
  }

  .why-benefit div {
    display: flex;
    flex-direction: column;

    gap: 3px;
  }

  .why-benefit strong {
    color: var(--color-navy);

    font-size: 15px;
    font-weight: 750;
  }

  .why-benefit span:last-child {
    color: var(--color-text);

    font-size: 14px;

    line-height: 1.5;
  }

  .why-cta {
    align-self: flex-start;
  }

  /* ============================================================
     HOW IT WORKS
  ============================================================ */

  .how-section {
    padding: 105px 0;

    background: var(--color-white);
  }

  .steps {
    width: 100%;
    max-width: 1000px;

    margin: 0 auto;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto
      minmax(0, 1fr)
      auto
      minmax(0, 1fr);

    align-items: start;

    gap: 10px;
  }

  .step {
    text-align: center;

    padding: 0 12px;
  }

  .step-number {
    margin-bottom: 8px;

    color: rgba(37, 99, 235, 0.13);

    font-size: 54px;
    font-weight: 800;

    line-height: 1;

    letter-spacing: -0.05em;
  }

  .step-icon {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 58px;
    height: 58px;

    margin: 0 auto 15px;

    border-radius: 15px;

    background: var(--color-primary-light);

    color: var(--color-primary);
  }

  .step-title {
    color: var(--color-navy);

    font-size: 20px;
    font-weight: 750;

    line-height: 1.3;

    margin: 0 0 9px;
  }

  .step-desc {
    color: var(--color-text);

    font-size: 14px;

    line-height: 1.65;

    margin: 0;
  }

  .step-connector {
    width: 45px;
    height: 2px;

    margin-top: 88px;

    background: var(--color-primary);

    opacity: 0.20;
  }

  /* ============================================================
     CTA
  ============================================================ */

  .cta-section {
    position: relative;

    padding: 90px 0;

    background: var(--color-white);

    overflow: hidden;
  }

  .cta-section::before {
    content: "";

    position: absolute;

    inset: 0;

    background:
      radial-gradient(
        ellipse at 50% 0%,
        rgba(37, 99, 235, 0.14),
        transparent 68%
      );

    pointer-events: none;
  }

  .cta-box {
    position: relative;
    z-index: 1;

    width: 100%;
    max-width: 800px;

    margin: 0 auto;

    text-align: center;
  }

  .cta-badge {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    margin-bottom: 16px;

    padding: 6px 18px;

    border-radius: 999px;

    background: rgba(37, 99, 235, 0.10);

    color: var(--color-primary);

    font-size: 13px;
    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: 0.06em;
  }

  .cta-title {
    color: var(--color-navy);

    font-size: 44px;
    font-weight: 750;

    line-height: 1.15;

    letter-spacing: -0.025em;

    margin: 0 0 13px;
  }

  .cta-desc {
    max-width: 650px;

    margin: 0 auto 32px;

    color: var(--color-text);

    font-size: 18px;

    line-height: 1.7;
  }

  .cta-actions {
    display: flex;

    justify-content: center;
    align-items: center;

    flex-wrap: wrap;

    gap: 14px;

    margin-bottom: 34px;
  }

  .cta-footer {
    display: flex;

    justify-content: center;
    align-items: center;

    flex-wrap: wrap;

    gap: 20px 30px;

    color: var(--color-slate);

    font-size: 13px;
    font-weight: 600;
  }

  .cta-footer span {
    display: inline-flex;

    align-items: center;

    gap: 6px;
  }

  .footer-icon {
    color: var(--color-primary);

    stroke-width: 2.5;
  }

  /* ============================================================
     TABLET
  ============================================================ */

  @media (max-width: 1100px) {

    .hero-grid {
      grid-template-columns:
        minmax(0, 1fr)
        minmax(0, 1fr);

      gap: 35px;
    }

    .hero-title {
      font-size: clamp(38px, 4.5vw, 48px);
    }

    .hero-visuals {
      height: 500px;
    }

    .services-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

    .why-title {
      font-size: 34px;
    }

    .why-image-container img {
      height: 400px;
    }
  }

  /* ============================================================
     TABLET PORTRAIT
  ============================================================ */

  @media (max-width: 900px) {

    .electrician-hero {
      padding:
        60px 0
        75px;
    }

    .hero-grid {
      grid-template-columns: 1fr;

      gap: 55px;
    }

    .hero-content {
      align-items: center;

      text-align: center;
    }

    .hero-badge {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-title {
      max-width: 800px;

      font-size: clamp(38px, 6vw, 50px);
    }

    .hero-desc {
      max-width: 700px;
    }

    .hero-actions {
      justify-content: center;
    }

    .trust-indicators {
      justify-content: center;
    }

    .hero-visuals {
      width: min(680px, 100%);
      height: 500px;

      margin: 0 auto;
    }

    .why-grid {
      grid-template-columns: 1fr;

      gap: 45px;
    }

    .why-image-container {
      width: min(700px, 100%);

      margin: 0 auto;
    }

    .why-content {
      align-items: center;

      text-align: center;
    }

    .why-title,
    .why-desc {
      max-width: 700px;
    }

    .why-benefits {
      max-width: 650px;

      text-align: left;
    }

    .why-cta {
      align-self: center;
    }

    .steps {
      grid-template-columns: 1fr;

      max-width: 650px;

      gap: 38px;
    }

    .step {
      padding: 0;
    }

    .step-connector {
      display: none;
    }

    .step-desc {
      max-width: 500px;

      margin-left: auto;
      margin-right: auto;
    }
  }

  /* ============================================================
     MOBILE LARGE
  ============================================================ */

  @media (max-width: 768px) {

    .container {
      padding-left: 20px;
      padding-right: 20px;
    }

    .electrician-hero {
      margin-top: var(--header-h, 70px);

      padding:
        48px 0
        60px;
    }

    .hero-grid {
      gap: 42px;
    }

    .hero-content {
      gap: 17px;
    }

    .hero-badge {
      font-size: 11px;

      padding:
        6px 13px 6px 10px;
    }

    .hero-title {
      font-size: clamp(31px, 8vw, 40px);

      line-height: 1.1;
    }

    .hero-desc {
      font-size: 15px;

      line-height: 1.65;
    }

    .hero-actions {
      width: 100%;

      flex-direction: column;

      gap: 10px;
    }

    .hero-actions .btn {
      width: min(100%, 340px);
    }

    .trust-indicators {
      width: 100%;

      flex-direction: column;

      align-items: center;

      gap: 9px;

      margin-top: 5px;
    }

    .trust-item {
      font-size: 13px;
    }

    /* Hero image */

    .hero-visuals {
      height: 390px;

      width: 100%;

      max-width: 560px;
    }

    .visual-main {
      width: 78%;
      height: 77%;

      top: 11%;
      left: 11%;

      border-radius: 23px;
    }

    .visual-support {
      border-width: 2px;

      border-radius: 14px;
    }

    .support-1,
    .support-2 {
      width: 32%;
      height: 25%;
    }

    .support-1 {
      top: 0;
      right: 0;
    }

    .support-2 {
      bottom: 0;
      left: 0;
    }

