const content = pageContent[lang] || pageContent.fr;

const isArabic = lang === "ar";
---

<Layout lang={lang} currentPath={currentPath}>
  <Header lang={lang} />

  <!-- ============================================================
       HERO
  ============================================================ -->

  <section class="about-hero" dir={isArabic ? "rtl" : "ltr"}>
    <div class="hero-decoration hero-decoration-1"></div>
    <div class="hero-decoration hero-decoration-2"></div>

    <div class="container">
      <div class="hero-grid">

        <div class="hero-content">

          <span class="hero-badge">
            <span set:html={icon("map-pin", 16)}></span>
            {content.heroBadge}
          </span>

          <h1
            class="hero-title"
            set:html={content.heroTitle}
          ></h1>

          <p class="hero-description">
            {content.heroDesc}
          </p>

          <div class="hero-actions">

            <a href={`/${lang}/contact`} class="btn btn-primary">
              {content.heroPrimary}

              <span
                set:html={icon(
                  isArabic ? "arrow-right" : "arrow-right",
                  18
                )}
              ></span>
            </a>

            <a href="#values" class="btn btn-secondary">
              {content.heroSecondary}
            </a>

          </div>

          <div class="hero-trust">

            <span>
              <span
                set:html={icon("check-circle", 17)}
              ></span>
              {content.stats[0].label}
            </span>

            <span>
              <span
                set:html={icon("check-circle", 17)}
              ></span>
              Tanger
            </span>

            <span>
              <span
                set:html={icon("check-circle", 17)}
              ></span>
              Service local
            </span>

          </div>

        </div>

        <div class="hero-visual">

          <div class="hero-image-main">

            <img
              src="/propos.png"
              alt={content.imageAlt}
              loading="eager"
              decoding="async"
            />

          </div>

          <div class="hero-floating-card">

            <div class="floating-icon">
              <span set:html={icon("shield", 20)}></span>
            </div>

            <div>
              <strong>Professionnels</strong>
              <span>de confiance</span>
            </div>

          </div>

          <div class="hero-location-card">

            <span set:html={icon("map-pin", 18)}></span>

            <div>
              <strong>Tanger</strong>
              <span>Maroc</span>
            </div>

          </div>

        </div>

      </div>
    </div>
  </section>


  <!-- ============================================================
       STATS
  ============================================================ -->

  <section class="stats-section">
    <div class="container">

      <div class="stats-grid">

        {
          content.stats.map((stat: any) => (
            <div class="stat-card">

              <strong class="stat-number">
                {stat.number}
              </strong>

              <span class="stat-label">
                {stat.label}
              </span>

            </div>
          ))
        }

      </div>

    </div>
  </section>


  <!-- ============================================================
       OUR STORY / MISSION
  ============================================================ -->

  <section
    class="story-section"
    id="mission"
    dir={isArabic ? "rtl" : "ltr"}
  >
    <div class="container">

      <div class="story-grid">

        <div class="story-image-wrapper">

          <div class="story-image">

            <img
              src="/propos2.png"
              alt={content.storyImageAlt}
              loading="lazy"
