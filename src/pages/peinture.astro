// src/pages/[lang]/services/peinture.astro

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  lang?: "fr" | "ar" | "en";
  currentPath?: string;
}

const { lang = "fr", currentPath = "/services/peinture" } = Astro.props;

const baseUrl = `/${lang}`;

// ============================================================
// ICON SYSTEM — clean inline SVG
// ============================================================
function icon(name: string, size: number = 24, className: string = ""): string {
  const icons: Record<string, string> = {
    "map-pin": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`,

    "check-circle": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,

    "arrow-right": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`,

    "arrow-down": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>`,

    "paintbrush": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="m14.622 17.897-10.68-2.2a2 2 0 0 1-1.595-2.358l1.02-4.96a2 2 0 0 1 2.358-1.596l10.68 2.2a2 2 0 0 1 1.595 2.358l-1.02 4.96a2 2 0 0 1-2.358 1.596Z"/><path d="m8 7 3-5"/><path d="m18 13 4 1"/><path d="m14 17-1 5"/><path d="M4.5 11.5 3 19"/></svg>`,

    "palette": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2a10 10 0 1 0 10 10c0-1.1-.9-2-2-2h-1.5a1.5 1.5 0 0 1-1.5-1.5V8a2 2 0 0 0-2-2h-1a2 2 0 0 1-2-2V2Z"/></svg>`,

    "brush": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="m9.06 11.9 8.07-8.06a2.85 2.85 0 1 1 4.03 4.03l-8.06 8.08"/><path d="M7.07 14.94c-1.66 0-3 1.34-3 3 0 1.1-.9 2-2 2 .5 1.22 1.72 2 3 2 2.21 0 4-1.79 4-4 0-1.1-.9-2-2-2Z"/><path d="m9.06 11.9 1.04 1.04"/></svg>`,

    "home": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,

    "settings": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>`,

    "file-text": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h6"/></svg>`,

    "clock": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  };

  return icons[name] || "";
}

// ============================================================
// MULTILINGUAL CONTENT
// ============================================================
const heroContent: Record<string, any> = {
  fr: {
    badge: "Peinture à Tanger",
    title: "Donnez une nouvelle vie à<br/>votre intérieur avec de <span class=\"highlight\">belles couleurs</span>.",
    subtitle:
      "Besoin d'un peintre professionnel ? MyHandy vous met en relation avec des peintres de confiance à Tanger pour vos travaux de peinture, rénovation et décoration.",
    primaryCta: "Trouver un professionnel",
    secondaryCta: "Voir les services",
    trust: [
      "Peintres locaux",
      "Intervention à Tanger",
      "Travail soigné",
      "Professionnels vérifiés"
    ],
    imgAlt: "Peintre professionnel réalisant des travaux de peinture à Tanger"
  },

  ar: {
    badge: "الطلاء في طنجة",
    title: "امنح منزلك مظهراً جديداً<br/>مع <span class=\"highlight\">ألوان جميلة</span>.",
    subtitle:
      "هل تحتاج إلى صباغ محترف؟ يوصلك MyHandy بصباغين موثوقين في طنجة لأعمال الصباغة والتجديد والديكور.",
    primaryCta: "ابحث عن حرفي",
    secondaryCta: "عرض الخدمات",
    trust: [
      "صباغون محليون",
      "تدخل في طنجة",
      "عمل متقن",
      "محترفون موثوقون"
    ],
    imgAlt: "صباغ محترف يقوم بأعمال الطلاء في طنجة"
  },

  en: {
    badge: "Painting in Tangier",
    title: "Give your home a fresh look<br/>with <span class=\"highlight\">beautiful colors</span>.",
    subtitle:
      "Need a professional painter? MyHandy connects you with trusted painters in Tangier for painting, renovation and decoration projects.",
    primaryCta: "Find a professional",
    secondaryCta: "View services",
    trust: [
      "Local painters",
      "Service in Tangier",
      "Quality work",
      "Verified professionals"
    ],
    imgAlt: "Professional painter working in Tangier"
  }
};

const content = heroContent[lang] || heroContent.fr;
---

<Layout lang={lang} currentPath={currentPath}>
  <Header lang={lang} />

  <!-- ============================================================
  HERO
  ============================================================ -->
  <section class="painting-hero" id="hero">
    <div class="container">
      <div class="hero-grid">

        <!-- LEFT -->
        <div class="hero-content">
          <span class="hero-badge">
            <span set:html={icon("map-pin", 16, "badge-icon")}></span>
            {content.badge}
          </span>

          <h1 class="hero-title" set:html={content.title}></h1>

          <p class="hero-desc">
            {content.subtitle}
          </p>

          <div class="hero-actions">
            <a href='/contact' class="btn btn-primary">
              {content.primaryCta}
              <span set:html={icon("arrow-right", 18)}></span>
            </a>

            <a href="#services" class="btn btn-secondary">
              {content.secondaryCta}
            </a>
          </div>

          <div class="trust-indicators">
            {content.trust.map((item: string) => (
              <span class="trust-item">
                <span set:html={icon("check-circle", 18, "trust-icon")}></span>
                {item}
              </span>
            ))}
          </div>
        </div>

        <!-- RIGHT -->
        <div class="hero-visuals">

          <div class="visual-main">
            <img
              src="/peinture1.png"
              alt={content.imgAlt}
              loading="eager"
              decoding="async"
            />
          </div>

          <div class="visual-support support-1">
            <img
              src="/peinture.avif"
              alt="Peintre réalisant des travaux de peinture"
              loading="lazy"
              decoding="async"
            />
            <span class="support-label">Travaux de peinture</span>
          </div>

          <div class="visual-support support-2">
            <img
              src="/peinture3.png"
              alt="Peintre professionnel réalisant une finition"
              loading="lazy"
              decoding="async"
            />
            <span class="support-label">Finitions</span>
          </div>

          <div class="floating-card">
            <span
              class="float-icon"
              set:html={icon("check-circle", 20)}
            ></span>

            <div>
              <span class="float-title">Travail soigné</span>
              <span class="float-sub">À Tanger</span>
            </div>
          </div>

          <div class="service-tags">
            <span class="tag">Peinture intérieure</span>
            <span class="tag">Façades</span>
            <span class="tag">Rénovation</span>
            <span class="tag">Décoration</span>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
  SERVICES
  ============================================================ -->
  <section class="services-section" id="services">
    <div class="container">

      <div class="section-header">
        <span class="eyebrow">Nos services</span>

        <h2 class="section-title">
          Des solutions de peinture pour tous vos projets
        </h2>

        <p class="section-desc">
          De la simple retouche à la rénovation complète, trouvez le peintre adapté à vos besoins.
        </p>
      </div>

      <div class="services-grid">

        <div class="service-card">
          <div class="service-icon" set:html={icon("paintbrush", 28)}></div>

          <h3 class="service-title">
            Peinture intérieure
          </h3>

          <p class="service-desc">
            Donnez une nouvelle ambiance à vos chambres, salons, bureaux et autres espaces intérieurs.
          </p>

          <a href="/contact" class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)}></span>
          </a>
        </div>

        <div class="service-card">
          <div class="service-icon" set:html={icon("home", 28)}></div>

          <h3 class="service-title">
            Peinture extérieure
          </h3>

          <p class="service-desc">
            Rafraîchissement et protection des façades et murs extérieurs de votre maison.
          </p>

          <a href="/contact" class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)}></span>
          </a>
        </div>

        <div class="service-card">
          <div class="service-icon" set:html={icon("palette", 28)}></div>

          <h3 class="service-title">
            Décoration murale
          </h3>

          <p class="service-desc">
            Création d'ambiances personnalisées avec couleurs, effets et finitions décoratives.
          </p>

          <a href="/contact" class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)}></span>
          </a>
        </div>

        <div class="service-card">
          <div class="service-icon" set:html={icon("brush", 28)}></div>

          <h3 class="service-title">
            Rénovation peinture
          </h3>

          <p class="service-desc">
            Remise à neuf de vos murs avant application d'une nouvelle peinture.
          </p>

          <a href="/contact" class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)}></span>
          </a>
        </div>

        <div class="service-card">
          <div class="service-icon" set:html={icon("settings", 28)}></div>

          <h3 class="service-title">
            Préparation des surfaces
          </h3>

          <p class="service-desc">
            Préparation, réparation et traitement des murs pour obtenir une finition propre et durable.
          </p>

          <a href="/contact" class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)}></span>
          </a>
        </div>

        <div class="service-card">
          <div class="service-icon" set:html={icon("palette", 28)}></div>

          <h3 class="service-title">
            Conseil couleurs
          </h3>

          <p class="service-desc">
            Choisissez les couleurs et les finitions adaptées à votre intérieur et à votre style.
          </p>

          <a href="/contact" class="service-link">
            En savoir plus
            <span set:html={icon("arrow-right", 16)}></span>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
  WHY US
  ============================================================ -->
  <section class="why-section" id="why">
    <div class="container">

      <div class="why-grid">

        <div class="why-image-wrapper">
          <div class="why-image-container">

            <img
              src="/peinture3.png"
              alt="Peintre professionnel en intervention"
              loading="lazy"
              decoding="async"
            />

            <div class="why-badge">
              <span
                set:html={icon("check-circle", 18, "badge-icon")}
              ></span>

              Professionnels vérifiés
            </div>

          </div>
        </div>

        <div class="why-content">

          <span class="eyebrow">
            Pourquoi nous choisir ?
          </span>

          <h2 class="why-title">
            Une peinture soignée pour un résultat qui dure
          </h2>

          <p class="why-desc">
            Nous vous aidons à trouver un peintre adapté à votre projet, que ce soit pour une petite pièce, une rénovation complète ou des travaux de décoration.
          </p>

          <div class="why-benefits">

            <div class="why-benefit">
              <span
                class="benefit-icon"
                set:html={icon("check-circle", 20)}
              ></span>

              <div>
                <strong>Peintres locaux</strong>
                <span>
                  Des professionnels disponibles à Tanger.
                </span>
              </div>
            </div>

            <div class="why-benefit">
              <span
                class="benefit-icon"
                set:html={icon("clock", 20)}
              ></span>

              <div>
                <strong>Intervention rapide</strong>
                <span>
                  Une prise en charge adaptée à votre projet.
                </span>
              </div>
            </div>

            <div class="why-benefit">
              <span
                class="benefit-icon"
                set:html={icon("check-circle", 20)}
              ></span>

              <div>
                <strong>Finitions soignées</strong>
                <span>
                  Un travail propre et adapté à vos attentes.
                </span>
              </div>
            </div>

          </div>

          <a
            href='/contact'
            class="btn btn-primary why-cta"
          >
            Demander un service
            <span set:html={icon("arrow-right", 18)}></span>
          </a>

        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
  HOW IT WORKS
  ============================================================ -->
  <section class="how-section" id="how">
    <div class="container">

      <div class="section-header">

        <span class="eyebrow">
          Comment ça marche
        </span>

        <h2 class="section-title">
          Trouver un peintre en quelques étapes
        </h2>

        <p class="section-desc">
          Un processus simple pour trouver rapidement le professionnel adapté à votre projet.
        </p>

      </div>

      <div class="steps">

        <div class="step">

          <div class="step-number">01</div>

          <div
            class="step-icon"
            set:html={icon("file-text", 28)}
          ></div>

          <h3 class="step-title">
            Décrivez votre projet
          </h3>

          <p class="step-desc">
            Indiquez les pièces, surfaces ou travaux de peinture dont vous avez besoin.
          </p>

        </div>

        <div class="step-connector"></div>

        <div class="step">

          <div class="step-number">02</div>

          <div
            class="step-icon"
            set:html={icon("paintbrush", 28)}
          ></div>

          <h3 class="step-title">
            Choisissez un professionnel
          </h3>

          <p class="step-desc">
            Consultez les professionnels disponibles pour votre demande.
          </p>

        </div>

        <div class="step-connector"></div>

        <div class="step">

          <div class="step-number">03</div>

          <div
            class="step-icon"
            set:html={icon("clock", 28)}
          ></div>

          <h3 class="step-title">
            Planifiez l'intervention
          </h3>

          <p class="step-desc">
            Convenez directement du rendez-vous et des détails des travaux.
          </p>

        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
  CTA
  ============================================================ -->
  <section class="cta-section" id="cta">
    <div class="container">

      <div class="cta-box">

        <span class="cta-badge">
          Peinture à Tanger
        </span>

        <h2 class="cta-title">
          Besoin d'un peintre ?
        </h2>

        <p class="cta-desc">
          Décrivez votre projet et trouvez un professionnel adapté à Tanger.
        </p>

        <div class="cta-actions">

          <a
            href='/contact'
            class="btn btn-primary btn-large"
          >
            Demander un service
            <span set:html={icon("arrow-right", 20)}></span>
          </a>

          <a
            href="#services"
            class="btn btn-secondary btn-large"
          >
            Voir nos services
            <span set:html={icon("arrow-down", 20)}></span>
          </a>

        </div>

        <div class="cta-footer">

          <span>
            <span
              set:html={icon("check-circle", 16, "footer-icon")}
            ></span>
            Peintres locaux
          </span>

          <span>
            <span
              set:html={icon("check-circle", 16, "footer-icon")}
            ></span>
            Intervention à Tanger
          </span>

          <span>
            <span
              set:html={icon("check-circle", 16, "footer-icon")}
            ></span>
            Professionnels vérifiés
          </span>

        </div>

      </div>
    </div>
  </section>

  <Footer lang={lang} />

  <!-- ============================================================
  SCROLL ANIMATION
  ============================================================ -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {

      const prefersReducedMotion =
        window.matchMedia("(prefers-reduced-motion: reduce)");

      if (prefersReducedMotion.matches) {
        document
          .querySelectorAll(".fade-up")
          .forEach(el => el.classList.add("visible"));

        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
            }
          });
        },
        {
          threshold: 0.12,
          rootMargin: "0px 0px -40px 0px"
        }
      );

      document
        .querySelectorAll(
          ".section-header, .service-card, .why-image-wrapper, .why-content, .step, .cta-box"
        )
        .forEach(el => {
          el.classList.add("fade-up");
          observer.observe(el);
        });

      document
        .querySelectorAll(".service-card")
        .forEach((el, i) => {
          (el as HTMLElement).style.transitionDelay =
            (i * 60) + "ms";
        });
    });
  </script>
</Layout>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..800&display=swap');

  :root {
    --color-primary: #2563eb;
    --color-primary-dark: #1d4ed8;
    --color-primary-light: #eff6ff;
    --color-navy: #0f172a;
    --color-text: #475569;
    --color-slate: #64748b;
    --color-bg: #f8fafc;
    --color-white: #ffffff;

    --radius-card: 22px;
    --radius-image: 28px;

    --shadow-card: 0 4px 24px rgba(15, 23, 42, 0.06);
    --shadow-hover: 0 12px 40px rgba(15, 23, 42, 0.1);

    --transition: 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);

    font-family:
      "Inter",
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    overflow-x: hidden;
  }

  body {
    margin: 0;
    font-family: inherit;
    overflow-x: hidden;
  }

  img {
    max-width: 100%;
  }

  .container {
    width: min(100% - 48px, 1280px);
    margin-inline: auto;
  }

  /* ============================================================
     ANIMATIONS
  ============================================================ */

  .fade-up {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  .fade-up.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ============================================================
     GLOBAL HEADERS
  ============================================================ */

  .eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;

    color: var(--color-primary);
    background: var(--color-primary-light);

    padding: 7px 18px;
    border-radius: 999px;

    margin-bottom: 14px;
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 52px;
  }

  .section-title {
    font-size: clamp(30px, 4vw, 40px);
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 12px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .section-desc {
    font-size: clamp(15px, 2vw, 17px);
    color: var(--color-text);
    margin: 0;
    line-height: 1.7;
  }

  /* ============================================================
     BUTTONS
  ============================================================ */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;

    min-height: 50px;
    padding: 14px 30px;

    border-radius: 999px;
    border: none;

    font-size: 16px;
    font-weight: 600;
    font-family: inherit;
    line-height: 1.2;
    text-decoration: none;

    cursor: pointer;
    transition: all var(--transition);
  }

  .btn-primary {
    background: var(--color-primary);
    color: var(--color-white);

    box-shadow:
      0 4px 20px rgba(37, 99, 235, 0.28);
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);

    box-shadow:
      0 8px 30px rgba(37, 99, 235, 0.35);
  }

  .btn-primary svg {
    transition: transform 0.25s ease;
  }

  .btn-primary:hover svg {
    transform: translateX(4px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-navy);

    border: 2px solid rgba(15, 23, 42, 0.13);
  }

  .btn-secondary:hover {
    background: rgba(15, 23, 42, 0.04);
    border-color: var(--color-navy);
    transform: translateY(-2px);
  }

  .btn-large {
    min-height: 56px;
    padding: 17px 38px;
    font-size: 17px;
  }

  /* ============================================================
     HERO
  ============================================================ */

  .painting-hero {
    position: relative;
    overflow: hidden;

    padding: clamp(60px, 8vw, 100px) 0 90px;

    background: var(--color-bg);
  }

  .painting-hero::before {
    content: "";
    position: absolute;

    top: -250px;
    right: -200px;

    width: 600px;
    height: 600px;

    background:
      radial-gradient(
        circle,
        rgba(37, 99, 235, 0.08),
        transparent 70%
      );

    border-radius: 50%;
    pointer-events: none;
  }

  .painting-hero::after {
    content: "";
    position: absolute;

    bottom: -220px;
    left: -180px;

    width: 450px;
    height: 450px;

    background:
      radial-gradient(
        circle,
        rgba(37, 99, 235, 0.05),
        transparent 70%
      );

    border-radius: 50%;
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);

    gap: clamp(40px, 6vw, 70px);

    align-items: center;

    position: relative;
    z-index: 1;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;

    min-width: 0;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    background: var(--color-primary-light);
    color: var(--color-primary);

    padding: 7px 16px;

    border-radius: 999px;

    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .badge-icon {
    stroke-width: 2.5;
  }

  .hero-title {
    font-size: clamp(38px, 4.3vw, 58px);
    font-weight: 800;
    line-height: 1.06;

    color: var(--color-navy);

    margin: 0;
    letter-spacing: -0.035em;

    overflow-wrap: break-word;
  }

  .hero-title :global(.highlight) {
    color: var(--color-primary);
    position: relative;
  }

  .hero-desc {
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.75;

    color: var(--color-text);

    max-width: 540px;

    margin: 0;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;

    margin-top: 4px;
  }

  .trust-indicators {
    display: flex;
    flex-wrap: wrap;

    gap: 14px 22px;

    margin-top: 6px;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 7px;

    font-size: 14px;
    font-weight: 500;

    color: var(--color-navy);
  }

  .trust-icon {
    color: var(--color-primary);
    stroke-width: 2.5;
    flex-shrink: 0;
  }

  /* ============================================================
     HERO IMAGES
  ============================================================ */

  .hero-visuals {
    position: relative;

    width: 100%;
    min-width: 0;

    height: clamp(440px, 44vw, 570px);
  }

  .visual-main {
    position: absolute;

    width: 73%;
    height: 82%;

    top: 8%;
    left: 13.5%;

    border-radius: var(--radius-image);
    overflow: hidden;

    box-shadow:
      0 24px 64px rgba(15, 23, 42, 0.14);

    z-index: 2;
    transition: transform 0.5s ease;
  }

  .visual-main:hover {
    transform: scale(1.012);
  }

  .visual-main img {
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    display: block;
  }

  .visual-support {
    position: absolute;

    overflow: hidden;

    background: var(--color-white);

    border: 3px solid var(--color-white);
    border-radius: 18px;

    box-shadow:
      0 8px 32px rgba(15, 23, 42, 0.12);

    z-index: 4;

    transition: all var(--transition);
  }

  .visual-support:hover {
    transform: scale(1.04) translateY(-3px);

    box-shadow:
      0 16px 48px rgba(15, 23, 42, 0.15);

    z-index: 5;
  }

  .visual-support img {
    width: 100%;
    height: 100%;

    display: block;
    object-fit: cover;
    object-position: center;
  }

  .support-1 {
    width: 31%;
    height: 28%;

    top: 0;
    right: 0;
  }

  .support-2 {
    width: 31%;
    height: 28%;

    bottom: 0;
    left: 0;
  }

  .support-label {
    position: absolute;

    left: 50%;
    bottom: 9px;

    transform: translateX(-50%);

    max-width: calc(100% - 16px);

    padding: 5px 12px;

    background: rgba(15, 23, 42, 0.76);
    backdrop-filter: blur(6px);

    color: var(--color-white);

    border-radius: 999px;

    font-size: 11px;
    font-weight: 600;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ============================================================
     FLOAT CARD
  ============================================================ */

  .floating-card {
    position: absolute;

    right: 0;
    bottom: 11%;

    display: flex;
    align-items: center;
    gap: 12px;

    padding: 14px 20px;

    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(10px);

    border: 1px solid rgba(15, 23, 42, 0.05);
    border-radius: 16px;

    box-shadow:
      0 12px 40px rgba(15, 23, 42, 0.13);

    z-index: 6;

    animation: float 4s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-8px);
    }
  }

  .float-icon {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 38px;
    height: 38px;

    flex-shrink: 0;

    background: var(--color-primary-light);
    color: var(--color-primary);

    border-radius: 50%;
  }

  .float-title {
    display: block;

    color: var(--color-navy);

    font-size: 14px;
    font-weight: 700;

    line-height: 1.25;
  }

  .float-sub {
    display: block;

    color: var(--color-text);

    font-size: 12px;

    margin-top: 2px;
  }

  /* ============================================================
     TAGS
  ============================================================ */

  .service-tags {
    position: absolute;

    left: 50%;
    bottom: 0;

    transform: translateX(-50%);

    display: flex;
    justify-content: center;
    flex-wrap: wrap;

    width: 100%;
    gap: 8px;

    z-index: 7;
  }

  .tag {
    padding: 6px 15px;

    background: var(--color-white);

    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 999px;

    box-shadow:
      0 4px 12px rgba(15, 23, 42, 0.05);

    color: var(--color-navy);

    font-size: 12px;
    font-weight: 600;

    white-space: nowrap;

    transition: all var(--transition);
  }

  .tag:hover {
    background: var(--color-primary);
    color: var(--color-white);
    border-color: var(--color-primary);

    transform: translateY(-2px);
  }

  /* ============================================================
     SERVICES
  ============================================================ */

  .services-section {
    padding: clamp(72px, 8vw, 105px) 0;

    background: var(--color-white);
  }

  .services-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 24px;
  }

  .service-card {
    display: flex;
    flex-direction: column;

    min-width: 0;

    padding: 30px 26px;

    background: var(--color-white);

    border: 1px solid rgba(15, 23, 42, 0.05);
    border-radius: var(--radius-card);

    box-shadow: var(--shadow-card);

    transition: all var(--transition);
  }

  .service-card:hover {
    transform: translateY(-5px);

    border-color: rgba(37, 99, 235, 0.5);

    box-shadow: var(--shadow-hover);
  }

  .service-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 56px;
    height: 56px;

    flex-shrink: 0;

    background: var(--color-primary-light);
    color: var(--color-primary);

    border-radius: 14px;

    margin-bottom: 18px;

    transition: all var(--transition);
  }

  .service-card:hover .service-icon {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .service-title {
    font-size: 19px;
    font-weight: 700;

    color: var(--color-navy);

    margin: 0 0 9px;
  }

  .service-desc {
    flex: 1;

    font-size: 14px;
    line-height: 1.7;

    color: var(--color-text);

    margin: 0 0 20px;
  }

  .service-link {
    display: inline-flex;
    align-items: center;

    gap: 6px;

    color: var(--color-primary);

    font-size: 14px;
    font-weight: 600;

    text-decoration: none;

    margin-top: auto;

    transition: gap 0.25s ease;
  }

  .service-link:hover {
    gap: 11px;
  }

  .service-link svg {
    transition: transform 0.25s ease;
  }

  .service-link:hover svg {
    transform: translateX(4px);
  }

  /* ============================================================
     WHY SECTION
  ============================================================ */

  .why-section {
    padding: clamp(72px, 8vw, 105px) 0;

    background: var(--color-primary-light);
  }

  .why-grid {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: clamp(40px, 6vw, 70px);

    align-items: center;
  }

  .why-image-wrapper {
    min-width: 0;
  }

  .why-image-container {
    position: relative;

    overflow: hidden;

    border-radius: var(--radius-image);

    box-shadow:
      0 12px 48px rgba(15, 23, 42, 0.09);
  }

  .why-image-container img {
    display: block;

    width: 100%;
    height: clamp(320px, 35vw, 440px);

    object-fit: cover;
    object-position: center;

    transition: transform 0.6s ease;
  }

  .why-image-container:hover img {
    transform: scale(1.02);
  }

  .why-badge {
    position: absolute;

    left: 22px;
    bottom: 22px;

    display: flex;
    align-items: center;
    gap: 8px;

    max-width: calc(100% - 44px);

    padding: 10px 18px;

    background: rgba(255, 255, 255, 0.96);

    border-radius: 999px;

    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.08);

    color: var(--color-navy);

    font-size: 14px;
    font-weight: 600;
  }

  .why-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    min-width: 0;
  }

  .why-title {
    font-size: clamp(30px, 4vw, 40px);
    font-weight: 700;

    color: var(--color-navy);

    margin: 0 0 16px;

    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .why-desc {
    font-size: clamp(15px, 1.8vw, 17px);
    line-height: 1.7;

    color: var(--color-text);

    margin: 0 0 28px;
  }

  .why-benefits {
    display: flex;
    flex-direction: column;

    gap: 18px;

    margin-bottom: 30px;
  }

  .why-benefit {
    display: flex;
    align-items: flex-start;

    gap: 14px;
  }

  .benefit-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 34px;
    height: 34px;

    flex-shrink: 0;

    margin-top: 1px;

    background: var(--color-white);
    color: var(--color-primary);

    border-radius: 50%;
  }

  .why-benefit div {
    display: flex;
    flex-direction: column;
  }

  .why-benefit strong {
    color: var(--color-navy);

    font-size: 15px;
    font-weight: 600;
  }

  .why-benefit span:last-child {
    color: var(--color-text);

    font-size: 14px;
    line-height: 1.55;

    margin-top: 2px;
  }

  .why-cta {
    align-self: flex-start;
  }

  /* ============================================================
     HOW IT WORKS
  ============================================================ */

  .how-section {
    padding: clamp(72px, 8vw, 105px) 0;

    background: var(--color-white);
  }

  .steps {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      50px
      minmax(0, 1fr)
      50px
      minmax(0, 1fr);

    align-items: start;

    gap: 10px;

    max-width: 1020px;

    margin: 0 auto;
  }

  .step {
    min-width: 0;

    text-align: center;

    padding: 0 10px;
  }

  .step-number {
    color: rgba(37, 99, 235, 0.12);

    font-size: clamp(42px, 5vw, 54px);
    font-weight: 800;

    line-height: 1;

    margin-bottom: 8px;

    letter-spacing: -0.04em;
  }

  .step-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 56px;
    height: 56px;

    background: var(--color-primary-light);
    color: var(--color-primary);

    border-radius: 14px;

    margin-bottom: 14px;
  }

  .step-title {
    color: var(--color-navy);

    font-size: 19px;
    font-weight: 700;

    margin: 0 0 8px;
  }

  .step-desc {
    color: var(--color-text);

    font-size: 14px;
    line-height: 1.65;

    margin: 0;
  }

  .step-connector {
    width: 100%;
    height: 2px;

    background: var(--color-primary);

    opacity: 0.2;

    margin-top: 44px;
  }

  /* ============================================================
     CTA
  ============================================================ */

  .cta-section {
    position: relative;

    overflow: hidden;

    padding: clamp(60px, 7vw, 85px) 0;

    background: var(--color-white);
  }

  .cta-section::before {
    content: "";

    position: absolute;
    inset: 0;

    background:
      radial-gradient(
        ellipse at 50% 0%,
        rgba(37, 99, 235, 0.15),
        transparent 70%
      );

    pointer-events: none;
  }

  .cta-box {
    position: relative;

    z-index: 1;

    width: min(100%, 780px);

    margin: 0 auto;

    text-align: center;

    color: var(--color-navy);
  }

  .cta-badge {
    display: inline-block;

    padding: 6px 18px;

    background: rgba(37, 99, 235, 0.13);

    border-radius: 999px;

    color: var(--color-primary-dark);

    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;

    margin-bottom: 16px;
  }

  .cta-title {
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 700;

    margin: 0 0 12px;

    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .cta-desc {
    max-width: 600px;

    margin: 0 auto 30px;

    color: var(--color-text);

    font-size: clamp(16px, 2vw, 18px);
    line-height: 1.7;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    align-items: center;

    gap: 14px;

    flex-wrap: wrap;

    margin-bottom: 34px;
  }

  .cta-footer {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 14px 30px;

    flex-wrap: wrap;

    color: var(--color-text);

    font-size: 14px;
  }

  .cta-footer span {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .footer-icon {
    color: var(--color-primary);
  }

  /* ============================================================
     LARGE TABLET
     <= 1100px
  ============================================================ */

  @media (max-width: 1100px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }

    .hero-title {
      font-size: clamp(38px, 4vw, 48px);
    }

    .hero-visuals {
      height: 470px;
    }

    .services-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  /* ============================================================
     TABLET
     <= 900px
  ============================================================ */

  @media (max-width: 900px) {
    .container {
      width: min(100% - 40px, 760px);
    }

    .painting-hero {
      padding-top: 70px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 52px;
    }

    .hero-content {
      align-items: center;
      text-align: center;

      max-width: 700px;

      margin: 0 auto;
    }

    .hero-desc {
      max-width: 650px;
    }

    .hero-actions {
      justify-content: center;
    }

    .trust-indicators {
      justify-content: center;
    }

    .hero-visuals {
      width: min(100%, 650px);
      height: 510px;

      margin: 0 auto;
    }

    .why-grid {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .why-image-wrapper {
      width: min(100%, 650px);
      margin: 0 auto;
    }

    .why-content {
      align-items: center;
      text-align: center;

      max-width: 700px;

      margin: 0 auto;
    }

    .why-benefits {
      width: min(100%, 520px);
      text-align: left;
    }

    .why-cta {
      align-self: center;
    }

    .steps {
      grid-template-columns: 1fr;
      max-width: 620px;
      gap: 36px;
    }

    .step {
      padding: 0;
    }

    .step-connector {
      display: none;
    }

    .step-desc {
      max-width: 450px;
      margin-inline: auto;
    }
  }

  /* ============================================================
     MOBILE / SMALL TABLET
     <= 700px
  ============================================================ */

  @media (max-width: 700px) {
    .container {
      width: calc(100% - 32px);
    }

    .painting-hero {
      padding:
        55px 0
        65px;
    }

    .hero-grid {
      gap: 40px;
    }

    .hero-content {
      gap: 17px;
    }

    .hero-title {
      font-size: clamp(31px, 9vw, 40px);
      line-height: 1.1;
    }

    .hero-title br {
      display: none;
    }

    .hero-desc {
      font-size: 16px;
      line-height: 1.7;
    }

    .hero-actions {
      width: 100%;

      flex-direction: column;
      gap: 11px;
    }

    .hero-actions .btn {
      width: 100%;
      max-width: 390px;
    }

    .trust-indicators {
      gap: 10px 16px;
    }

    .trust-item {
      font-size: 13px;
    }

    .hero-visuals {
      height: 410px;
      max-width: 520px;
    }

    .visual-main {
      width: 82%;
      height: 76%;

      left: 9%;
      top: 11%;
    }

    .support-1,
    .support-2 {
      width: 34%;
      height: 25%;
    }

    .floating-card {
      right: 0;
      bottom: 7%;

      padding: 11px 14px;
    }

    .float-icon {
      width: 34px;
      height: 34px;
    }

    .float-title {
      font-size: 13px;
    }

    .float-sub {
      font-size: 11px;
    }

    .service-tags {
      gap: 5px;
    }

    .tag {
      padding: 5px 11px;

      font-size: 10px;
    }

    .section-header {
      margin-bottom: 38px;
    }

    .services-grid {
      grid-template-columns: 1fr;
      gap: 18px;

      max-width: 520px;

      margin: 0 auto;
    }

    .service-card {
      padding: 25px 22px;
    }

    .why-image-container img {
      height: 320px;
    }

    .why-badge {
      left: 14px;
      bottom: 14px;

      max-width: calc(100% - 28px);

      padding: 8px 14px;

      font-size: 12px;
    }

    .why-benefits {
      gap: 16px;
    }

    .cta-actions {
      flex-direction: column;

      width: 100%;
    }

    .cta-actions .btn {
      width: 100%;
      max-width: 390px;
    }

    .cta-footer {
      flex-direction: column;
      gap: 10px;
    }
  }

  /* ============================================================
     PHONE
     <= 520px
  ============================================================ */

  @media (max-width: 520px) {
    .container {
      width: calc(100% - 28px);
    }

    .painting-hero {
      padding:
        42px 0
        55px;
    }

    .hero-badge {
      font-size: 11px;

      padding: 6px 12px;
    }

    .hero-title {
      font-size: clamp(28px, 9vw, 34px);
    }

    .hero-desc {
      font-size: 15px;
    }

    .btn {
      min-height: 48px;

      padding: 13px 22px;

      font-size: 15px;
    }

    .trust-indicators {
      display: grid;
      grid-template-columns: repeat(2, auto);

      justify-content: center;

      gap: 9px 14px;
    }

    .hero-visuals {
      height: 340px;
    }

    .visual-main {
      width: 86%;
      height: 74%;

      left: 7%;
      top: 13%;

      border-radius: 22px;
    }

