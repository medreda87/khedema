---
// src/pages/[lang]/services/plombier.astro
import Layout from "../layouts/Layout.astro";
import { t } from "../../../lib/i18n";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  lang?: "fr" | "ar";
  currentPath?: string;
}

const { lang = "fr", currentPath = "/services/plombier" } = Astro.props;

const baseUrl = `/${lang}`;

// ============================================================
// ICON SYSTEM — clean inline SVG (Lucide style)
// ============================================================
function icon(name: string, size: number = 24, className: string = ""): string {
  const icons: Record<string, string> = {
    wrench: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
    droplets: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="M12 22a7 7 0 0 0 7-7c0-3.5-3-8-7-12-4 4-7 8.5-7 12a7 7 0 0 0 7 7z"/><path d="M12 16a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/></svg>`,
    "map-pin": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`,
    "check-circle": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,
    "arrow-right": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`,
    settings: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>`,
    shower: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}"><path d="m4 4 2.5 2.5"/><path d="M13.5 6.5a4.95 4.95 0 0 0-7 7"/><path d="M15 5 5 15"/><path d="M14 17v.01"/><path d="M10 16v.01"/><path d="M13 13v.01"/><path d="M16 10v.01"/><path d="M11 20v.01"/><path d="M17 14v.01"/><path d="M20 11v.01"/></svg>`,
  };
  return icons[name] || "";
}

// ============================================================
// HERO MULTILINGUAL CONTENT — with the new text from image.png
// ============================================================
const heroContent: Record<string, any> = {
  fr: {
    badge: "Plomberie à Tanger",
    title: "Votre maison à Tanger,<br/>entre de <span class=\"highlight\">bonnes mains</span>.",
    subtitle: "Besoin d'un plombier, électricien, climatiseur ou autre professionnel ? AlloMealem vous met en relation avec des techniciens de confiance à Tanger.",
    primaryCta: "Trouver un professionnel",
    secondaryCta: "Voir les services",
    trust: [
      "Techniciens locaux",
      "Intervention à Tanger",
      "Intervention rapide",
      "Professionnels vérifiés"
    ],
    imgAlt: "Plombier professionnel intervenant à Tanger"
  },
  ar: {
    badge: "سباكة في طنجة",
    title: "منزلك في طنجة،<br/>بين <span class=\"highlight\">أيدٍ أمينة</span>.",
    subtitle: "هل تحتاج سباكًا، كهربائيًا، مكيفًا أو أي حرفي آخر؟ يوصلك AlloMealem بتقنيين موثوقين في طنجة.",
    primaryCta: "ابحث عن حرفي",
    secondaryCta: "عرض الخدمات",
    trust: [
      "تقنيون محليون",
      "تدخل في طنجة",
      "تدخل سريع",
      "محترفون موثوقون"
    ],
    imgAlt: "سباك محترف يقدم خدمات السباكة في طنجة"
  },
  en: {
    badge: "Plumbing in Tangier",
    title: "Your home in Tangier,<br/>in <span class=\"highlight\">good hands</span>.",
    subtitle: "Need a plumber, electrician, air conditioner or other professional? AlloMealem connects you with trusted technicians in Tangier.",
    primaryCta: "Find a professional",
    secondaryCta: "View services",
    trust: [
      "Local technicians",
      "Service in Tangier",
      "Fast service",
      "Verified professionals"
    ],
    imgAlt: "Professional plumber providing plumbing services in Tangier"
  }
};

const content = heroContent[lang] || heroContent.fr;
---

<Layout lang={lang} currentPath={currentPath}>
  <Header lang={lang} />

  <!-- ============================================================
  HERO SECTION — with updated textual content & font
  ============================================================ -->
  <section class="plumbing-hero" id="hero">
    <div class="container">
      <div class="hero-grid">
        <!-- LEFT COLUMN: Content -->
        <div class="hero-content">
          <span class="hero-badge">
            <span set:html={icon("map-pin", 16, "badge-icon")}></span>
            {content.badge}
          </span>

          <h1 class="hero-title" set:html={content.title}></h1>

          <p class="hero-desc">{content.subtitle}</p>

          <div class="hero-actions">
            <a href='/contact' class="btn btn-primary">
              {content.primaryCta}
              <span set:html={icon("arrow-right", 18)}></span>
            </a>
            <a href="#services" class="btn btn-secondary">
              {content.secondaryCta}
            </a>
          </div>

          <div class="trust-indicators">
            {content.trust.map((item: string) => (
              <span class="trust-item">
                <span set:html={icon("check-circle", 18, "trust-icon")}></span>
                {item}
              </span>
            ))}
          </div>
        </div>

        <!-- RIGHT COLUMN: Visual Composition -->
        <div class="hero-visuals">
          <!-- Main Image -->
          <div class="visual-main">
            <img
              src="plombier1.png"
              alt={content.imgAlt}
              loading="eager"
              decoding="async"
            />
          </div>

          <!-- Supporting Image 1 -->
          <div class="visual-support support-1">
            <img
              src="plombier2.png"
              alt="Plombier réparant une fuite d'eau"
              loading="lazy"
              decoding="async"
            />
            <span class="support-label">Réparation de fuite</span>
          </div>

          <!-- Supporting Image 2 -->
          <div class="visual-support support-2">
            <img
              src="plombier3.png"
              alt="Plombier installant un chauffe-eau"
              loading="lazy"
              decoding="async"
            />
            <span class="support-label">Installation</span>
          </div>

          <!-- Floating Card -->
          <div class="floating-card">
            <span class="float-icon" set:html={icon("check-circle", 20)}></span>
            <div>
              <span class="float-title">Intervention rapide</span>
              <span class="float-sub">À Tanger</span>
            </div>
          </div>

          <!-- Service Tags -->
          <div class="service-tags">
            <span class="tag">Fuites</span>
            <span class="tag">Débouchage</span>
            <span class="tag">Installation</span>
            <span class="tag">Chauffe-eau</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
  REST OF THE PAGE (Existing sections kept intact)
  ============================================================ -->
  <section class="services-section" id="services">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Nos services</span>
        <h2 class="section-title">Des solutions pour tous vos besoins en plomberie</h2>
        <p class="section-desc">
          Réparation, installation ou dépannage : trouvez le service adapté à votre besoin.
        </p>
      </div>
      <div class="services-grid">
        <div class="service-card">
          <div class="service-icon" set:html={icon("wrench", 28)}></div>
          <h3 class="service-title">Dépannage plomberie</h3>
          <p class="service-desc">Intervention pour vos problèmes de plomberie du quotidien.</p>
          <a href="#" class="service-link">En savoir plus <span set:html={icon("arrow-right", 16)}></span></a>
        </div>
        <div class="service-card">
          <div class="service-icon" set:html={icon("droplets", 28)}></div>
          <h3 class="service-title">Fuite d'eau</h3>
          <p class="service-desc">Détection et réparation de vos fuites rapidement.</p>
          <a href="#" class="service-link">En savoir plus <span set:html={icon("arrow-right", 16)}></span></a>
        </div>
        <div class="service-card">
          <div class="service-icon" set:html={icon("settings", 28)}></div>
          <h3 class="service-title">Débouchage</h3>
          <p class="service-desc">Éviers, canalisations et sanitaires bouchés.</p>
          <a href="#" class="service-link">En savoir plus <span set:html={icon("arrow-right", 16)}></span></a>
        </div>
        <div class="service-card">
          <div class="service-icon" set:html={icon("shower", 28)}></div>
          <h3 class="service-title">Installation sanitaire</h3>
          <p class="service-desc">Installation de lavabos, robinets, WC et équipements.</p>
          <a href="#" class="service-link">En savoir plus <span set:html={icon("arrow-right", 16)}></span></a>
        </div>
        <div class="service-card">
          <div class="service-icon" set:html={icon("settings", 28)}></div>
          <h3 class="service-title">Chauffe-eau</h3>
          <p class="service-desc">Installation, remplacement et dépannage de chauffe-eau.</p>
          <a href="#" class="service-link">En savoir plus <span set:html={icon("arrow-right", 16)}></span></a>
        </div>
        <div class="service-card">
          <div class="service-icon" set:html={icon("wrench", 28)}></div>
          <h3 class="service-title">Rénovation plomberie</h3>
          <p class="service-desc">Création et rénovation de vos installations de plomberie.</p>
          <a href="#" class="service-link">En savoir plus <span set:html={icon("arrow-right", 16)}></span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="why-section" id="why">
    <div class="container">
      <div class="why-grid">
        <div class="why-image-wrapper">
          <div class="why-image-container">
            <img src="plombier2.png" alt="Plombier professionnel en intervention" loading="lazy" decoding="async" />
            <div class="why-badge"><span set:html={icon("check-circle", 18, "badge-icon")}></span> Professionnels vérifiés</div>
          </div>
        </div>
        <div class="why-content">
          <span class="eyebrow">Pourquoi nous choisir ?</span>
          <h2 class="why-title">Une intervention simple, rapide et fiable</h2>
          <p class="why-desc">Nous vous aidons à trouver un professionnel adapté à votre besoin, avec une expérience claire et sans complication.</p>
          <div class="why-benefits">
            <div class="why-benefit">
              <span class="benefit-icon" set:html={icon("check-circle", 20)}></span>
              <div><strong>Techniciens locaux</strong><span>Des professionnels disponibles à Tanger.</span></div>
            </div>
            <div class="why-benefit">
              <span class="benefit-icon" set:html={icon("clock", 20)}></span>
              <div><strong>Intervention rapide</strong><span>Une prise en charge adaptée à votre situation.</span></div>
            </div>
            <div class="why-benefit">
              <span class="benefit-icon" set:html={icon("file-text", 20)}></span>
              <div><strong>Prix transparents</strong><span>Des informations claires avant l'intervention.</span></div>
            </div>
          </div>
          <a href=`/contact` class="btn btn-primary why-cta">Demander un service <span set:html={icon("arrow-right", 18)}></span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="how-section" id="how">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Comment ça marche</span>
        <h2 class="section-title">Trouver un plombier en quelques étapes</h2>
        <p class="section-desc">Un processus simple pour vous permettre de trouver rapidement le professionnel adapté.</p>
      </div>
      <div class="steps">
        <div class="step">
          <div class="step-number">01</div>
          <div class="step-icon" set:html={icon("file-text", 28)}></div>
          <h3 class="step-title">Décrivez votre besoin</h3>
          <p class="step-desc">Expliquez simplement le problème ou le travail à réaliser.</p>
        </div>
        <div class="step-connector"></div>
        <div class="step">
          <div class="step-number">02</div>
          <div class="step-icon" set:html={icon("wrench", 28)}></div>
          <h3 class="step-title">Choisissez un professionnel</h3>
          <p class="step-desc">Consultez les professionnels disponibles pour votre demande.</p>
        </div>
        <div class="step-connector"></div>
        <div class="step">
          <div class="step-number">03</div>
          <div class="step-icon" set:html={icon("clock", 28)}></div>
          <h3 class="step-title">Planifiez l'intervention</h3>
          <p class="step-desc">Convenez directement des détails de l'intervention.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section" id="cta">
    <div class="container">
      <div class="cta-box">
        <span class="cta-badge">Plomberie à Tanger</span>
        <h2 class="cta-title">Besoin d'un plombier ?</h2>
        <p class="cta-desc">Décrivez votre besoin et trouvez un professionnel adapté à Tanger.</p>
        <div class="cta-actions">
          <a href=`/contact` class="btn btn-primary btn-large">Demander un service <span set:html={icon("arrow-right", 20)}></span></a>
<a href="#services" class="btn btn-secondary btn-large">
  Voir nos services
  <span set:html={icon("arrow-down", 20)}></span>
</a>        </div>
        <div class="cta-footer">
          <span><span set:html={icon("check-circle", 16, "footer-icon")}></span> Techniciens locaux</span>
          <span><span set:html={icon("check-circle", 16, "footer-icon")}></span> Intervention à Tanger</span>
          <span><span set:html={icon("check-circle", 16, "footer-icon")}></span> Professionnels vérifiés</span>
        </div>
      </div>
    </div>
  </section>
<Footer lang={lang} />

  <!-- ============================================================
  SCROLL ANIMATION
  ============================================================ -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      if (prefersReducedMotion.matches) {
        document.querySelectorAll(".fade-up").forEach(el => el.classList.add("visible"));
        return;
      }
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add("visible"); });
      }, { threshold: 0.12, rootMargin: "0px 0px -40px 0px" });
      document.querySelectorAll(".section-header, .service-card, .why-image-wrapper, .why-content, .step, .cta-box").forEach(el => {
        el.classList.add("fade-up");
        observer.observe(el);
      });
      document.querySelectorAll(".service-card").forEach((el, i) => el.style.transitionDelay = (i * 60) + "ms");
    });
  </script>
</Layout>

<style>
  /* ==============================================================
     IMPORT GOOGLE FONT — Inter (premium, similar to image)
     ============================================================== */
  @import url('https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..800&display=swap');

  /* ==============================================================
     ROOT — apply Inter font to the entire page
     ============================================================== */
  :root {
    --color-primary: #2563eb;
    --color-primary-dark: #1d4ed8;
    --color-primary-light: #eff6ff;
    --color-navy: #0f172a;
    --color-text: #475569;
    --color-slate: #64748b;
    --color-bg: #f8fafc;
    --color-white: #ffffff;
    --radius-card: 22px;
    --radius-image: 28px;
    --shadow-card: 0 4px 24px rgba(15, 23, 42, 0.06);
    --shadow-hover: 0 12px 40px rgba(15, 23, 42, 0.10);
    --transition: 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    /* Global font family */
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  /* Ensure all elements inherit the font */
  body {
    font-family: inherit;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 28px;
  }

  .fade-up {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .fade-up.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .eyebrow {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    background: var(--color-primary-light);
    padding: 4px 18px;
    border-radius: 40px;
    margin-bottom: 14px;
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 52px;
  }
  .section-title {
    font-size: 40px;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 12px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .section-desc {
    font-size: 17px;
    color: var(--color-text);
    margin: 0;
    line-height: 1.6;
  }

  /* ---- Buttons (matching global Hero) ---- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 32px;
    border-radius: 60px;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    transition: all var(--transition);
    border: none;
    cursor: pointer;
    font-family: inherit;
    line-height: 1.2;
  }
  .btn-primary {
    background: var(--color-primary);
    color: var(--color-white);
    box-shadow: 0 4px 20px rgba(37, 99, 235, 0.3);
  }
  .btn-primary:hover {
    background: var(--color-primary-dark);
    transform: translateY(-3px);
    box-shadow: 0 8px 32px rgba(37, 99, 235, 0.4);
  }
  .btn-primary svg {
    transition: transform 0.25s ease;
  }
  .btn-primary:hover svg {
    transform: translateX(4px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-navy);
    border: 2px solid rgba(15, 23, 42, 0.15);
  }
  .btn-secondary:hover {
    background: rgba(15, 23, 42, 0.04);
    border-color: var(--color-navy);
    transform: translateY(-3px);
  }

  .btn-outline-dark {
    background: transparent;
    color: var(--color-white);
    border: 2px solid rgba(255, 255, 255, 0.3);
  }
  .btn-outline-dark:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--color-white);
    transform: translateY(-3px);
  }

  .btn-large {
    padding: 18px 40px;
    font-size: 18px;
  }

  /* ==============================================================
     PLUMBING HERO — Redesigned section
     ============================================================== */
  .plumbing-hero {
    padding: 60px 0 80px;
    background: var(--color-bg);
    position: relative;
    overflow: hidden;
    margin-top: var(--header-h, 76px);
  }
  .plumbing-hero::before {
    content: "";
    position: absolute;
    top: -40%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.06), transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }
  .plumbing-hero::after {
    content: "";
    position: absolute;
    bottom: -20%;
    left: -10%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.04), transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 60px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  /* --- Left Column: Content --- */
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-primary-light);
    color: var(--color-primary);
    padding: 6px 18px 6px 14px;
    border-radius: 40px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    width: fit-content;
  }
  .badge-icon {
    stroke-width: 2.5;
  }

  .hero-title {
    font-size: 52px;
    font-weight: 800;
    line-height: 1.08;
    color: var(--color-navy);
    margin: 0;
    letter-spacing: -0.03em;
  }
  .highlight {
    color: var(--color-primary);
    position: relative;
  }
  .highlight::after {
    content: "";
    position: absolute;
    bottom: 4px;
    left: 0;
    width: 100%;
    height: 6px;
    background: var(--color-primary-light);
    border-radius: 4px;
    z-index: -1;
  }

  .hero-desc {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-text);
    max-width: 480px;
    margin: 0;
  }

  .hero-actions {
