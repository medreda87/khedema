---
// src/pages/[lang]/services/plombier.astro

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  lang?: "fr" | "ar" | "en";
  currentPath?: string;
}

const { lang = "fr", currentPath = "/services/plombier" } = Astro.props;

const baseUrl = `/${lang}`;
const isRTL = lang === "ar";

// ============================================================
// ICON SYSTEM
// ============================================================

function icon(
  name: string,
  size: number = 24,
  className: string = ""
): string {
  const icons: Record<string, string> = {
    wrench: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
    </svg>`,

    droplets: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <path d="M12 22a7 7 0 0 0 7-7c0-3.5-3-8-7-12-4 4-7 8.5-7 12a7 7 0 0 0 7 7z"/>
      <path d="M12 16a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>
    </svg>`,

    "map-pin": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/>
      <circle cx="12" cy="10" r="3"/>
    </svg>`,

    "check-circle": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
      <polyline points="22 4 12 14.01 9 11.01"/>
    </svg>`,

    "arrow-right": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <line x1="5" y1="12" x2="19" y2="12"/>
      <polyline points="12 5 19 12 12 19"/>
    </svg>`,

    "arrow-down": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <line x1="12" y1="5" x2="12" y2="19"/>
      <polyline points="19 12 12 19 5 12"/>
    </svg>`,

    settings: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
      <circle cx="12" cy="12" r="3"/>
    </svg>`,

    shower: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <path d="m4 4 2.5 2.5"/>
      <path d="M13.5 6.5a4.95 4.95 0 0 0-7 7"/>
      <path d="M15 5 5 15"/>
      <path d="M14 17v.01"/>
      <path d="M10 16v.01"/>
      <path d="M13 13v.01"/>
      <path d="M16 10v.01"/>
      <path d="M11 20v.01"/>
      <path d="M17 14v.01"/>
      <path d="M20 11v.01"/>
    </svg>`,

    clock: `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <circle cx="12" cy="12" r="10"/>
      <polyline points="12 6 12 12 16 14"/>
    </svg>`,

    "file-text": `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}">
      <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
      <polyline points="14 2 14 8 20 8"/>
      <line x1="16" y1="13" x2="8" y2="13"/>
      <line x1="16" y1="17" x2="8" y2="17"/>
      <line x1="10" y1="9" x2="8" y2="9"/>
    </svg>`,
  };

  return icons[name] || "";
}

// ============================================================
// MULTILINGUAL CONTENT
// ============================================================

const heroContent: Record<string, any> = {
  fr: {
    badge: "Plomberie à Tanger",
    title: `Votre maison à Tanger,<br/>entre de <span class="highlight">bonnes mains</span>.`,
    subtitle:
      "Besoin d'un plombier, électricien, climatiseur ou autre professionnel ? AlloMealem vous met en relation avec des techniciens de confiance à Tanger.",
    primaryCta: "Trouver un professionnel",
    secondaryCta: "Voir les services",
    trust: [
      "Techniciens locaux",
      "Intervention à Tanger",
      "Intervention rapide",
      "Professionnels vérifiés",
    ],
    imgAlt: "Plombier professionnel intervenant à Tanger",
  },

  ar: {
    badge: "سباكة في طنجة",
    title: `منزلك في طنجة،<br/>بين <span class="highlight">أيدٍ أمينة</span>.`,
    subtitle:
      "هل تحتاج سباكًا، كهربائيًا، مكيفًا أو أي حرفي آخر؟ يوصلك AlloMealem بتقنيين موثوقين في طنجة.",
    primaryCta: "ابحث عن حرفي",
    secondaryCta: "عرض الخدمات",
    trust: [
      "تقنيون محليون",
      "تدخل في طنجة",
      "تدخل سريع",
      "محترفون موثوقون",
    ],
    imgAlt: "سباك محترف يقدم خدمات السباكة في طنجة",
  },

  en: {
    badge: "Plumbing in Tangier",
    title: `Your home in Tangier,<br/>in <span class="highlight">good hands</span>.`,
    subtitle:
      "Need a plumber, electrician, air conditioner or other professional? AlloMealem connects you with trusted technicians in Tangier.",
    primaryCta: "Find a professional",
    secondaryCta: "View services",
    trust: [
      "Local technicians",
      "Service in Tangier",
      "Fast service",
      "Verified professionals",
    ],
    imgAlt: "Professional plumber providing plumbing services in Tangier",
  },
};

const content = heroContent[lang] || heroContent.fr;
---

<Layout lang={lang} currentPath={currentPath}>
  <Header lang={lang} />

  <main dir={isRTL ? "rtl" : "ltr"}>

    <!-- ============================================================
    HERO
    ============================================================ -->

    <section class="plumbing-hero" id="hero">
      <div class="container">
        <div class="hero-grid">

          <div class="hero-content">

            <span class="hero-badge">
              <span set:html={icon("map-pin", 16, "badge-icon")}></span>
              {content.badge}
            </span>

            <h1 class="hero-title" set:html={content.title}></h1>

            <p class="hero-desc">
              {content.subtitle}
            </p>

            <div class="hero-actions">

              <a
                href={`/${lang}/contact`}
                class="btn btn-primary"
              >
                {content.primaryCta}
                <span set:html={icon("arrow-right", 18)}></span>
              </a>

              <a
                href="#services"
                class="btn btn-secondary"
              >
                {content.secondaryCta}
              </a>

            </div>

            <div class="trust-indicators">
              {content.trust.map((item: string) => (
                <span class="trust-item">
                  <span
                    set:html={icon("check-circle", 18, "trust-icon")}
                  ></span>
                  {item}
                </span>
              ))}
            </div>

          </div>

          <!-- HERO VISUAL -->

          <div class="hero-visuals">

            <div class="visual-main">
              <img
                src="/plombier1.png"
                alt={content.imgAlt}
                loading="eager"
                decoding="async"
              />
            </div>

            <div class="visual-support support-1">
              <img
                src="/plombier2.png"
                alt="Plombier réparant une fuite d'eau"
                loading="lazy"
                decoding="async"
              />
              <span class="support-label">
                Réparation de fuite
              </span>
            </div>

            <div class="visual-support support-2">
              <img
                src="/plombier3.png"
                alt="Plombier installant un chauffe-eau"
                loading="lazy"
                decoding="async"
              />
              <span class="support-label">
                Installation
              </span>
            </div>

            <div class="floating-card">
              <span
                class="float-icon"
                set:html={icon("check-circle", 20)}
              ></span>

              <div>
                <span class="float-title">
                  Intervention rapide
                </span>

                <span class="float-sub">
                  À Tanger
                </span>
              </div>
            </div>

            <div class="service-tags">
              <span class="tag">Fuites</span>
              <span class="tag">Débouchage</span>
              <span class="tag">Installation</span>
              <span class="tag">Chauffe-eau</span>
            </div>

          </div>

        </div>
      </div>
    </section>


    <!-- ============================================================
    SERVICES
    ============================================================ -->

    <section class="services-section" id="services">

      <div class="container">

        <div class="section-header">

          <span class="eyebrow">
            Nos services
          </span>

          <h2 class="section-title">
            Des solutions pour tous vos besoins en plomberie
          </h2>

          <p class="section-desc">
            Réparation, installation ou dépannage :
            trouvez le service adapté à votre besoin.
          </p>

        </div>

        <div class="services-grid">

          <div class="service-card">
            <div class="service-icon" set:html={icon("wrench", 28)}></div>

            <h3 class="service-title">
              Dépannage plomberie
            </h3>

            <p class="service-desc">
              Intervention pour vos problèmes de plomberie du quotidien.
            </p>

            <a href={`/${lang}/contact`} class="service-link">
              En savoir plus
              <span set:html={icon("arrow-right", 16)}></span>
            </a>
          </div>


          <div class="service-card">
            <div class="service-icon" set:html={icon("droplets", 28)}></div>

            <h3 class="service-title">
              Fuite d'eau
            </h3>

            <p class="service-desc">
              Détection et réparation de vos fuites rapidement.
            </p>

            <a href={`/${lang}/contact`} class="service-link">
              En savoir plus
              <span set:html={icon("arrow-right", 16)}></span>
            </a>
          </div>


          <div class="service-card">
            <div class="service-icon" set:html={icon("settings", 28)}></div>

            <h3 class="service-title">
              Débouchage
            </h3>

            <p class="service-desc">
              Éviers, canalisations et sanitaires bouchés.
            </p>

            <a href={`/${lang}/contact`} class="service-link">
              En savoir plus
              <span set:html={icon("arrow-right", 16)}></span>
            </a>
          </div>


          <div class="service-card">
            <div class="service-icon" set:html={icon("shower", 28)}></div>

            <h3 class="service-title">
              Installation sanitaire
            </h3>

            <p class="service-desc">
              Installation de lavabos, robinets, WC et équipements.
            </p>

            <a href={`/${lang}/contact`} class="service-link">
              En savoir plus
              <span set:html={icon("arrow-right", 16)}></span>
            </a>
          </div>


          <div class="service-card">
            <div class="service-icon" set:html={icon("settings", 28)}></div>

            <h3 class="service-title">
              Chauffe-eau
            </h3>

            <p class="service-desc">
              Installation, remplacement et dépannage de chauffe-eau.
            </p>

            <a href={`/${lang}/contact`} class="service-link">
              En savoir plus
              <span set:html={icon("arrow-right", 16)}></span>
            </a>
          </div>


          <div class="service-card">
            <div class="service-icon" set:html={icon("wrench", 28)}></div>

            <h3 class="service-title">
              Rénovation plomberie
            </h3>

            <p class="service-desc">
              Création et rénovation de vos installations de plomberie.
            </p>

            <a href={`/${lang}/contact`} class="service-link">
              En savoir plus
              <span set:html={icon("arrow-right", 16)}></span>
            </a>
          </div>

        </div>
      </div>
    </section>


    <!-- ============================================================
    WHY
    ============================================================ -->

    <section class="why-section" id="why">

      <div class="container">

        <div class="why-grid">

          <div class="why-image-wrapper">

            <div class="why-image-container">

              <img
                src="/plombier2.png"
                alt="Plombier professionnel en intervention"
                loading="lazy"
                decoding="async"
              />

              <div class="why-badge">
                <span
                  set:html={icon("check-circle", 18, "badge-icon")}
                ></span>
                Professionnels vérifiés
              </div>

            </div>

          </div>


          <div class="why-content">

            <span class="eyebrow">
              Pourquoi nous choisir ?
            </span>

            <h2 class="why-title">
              Une intervention simple, rapide et fiable
            </h2>

            <p class="why-desc">
              Nous vous aidons à trouver un professionnel adapté à votre
              besoin, avec une expérience claire et sans complication.
            </p>


            <div class="why-benefits">

              <div class="why-benefit">

                <span
                  class="benefit-icon"
                  set:html={icon("check-circle", 20)}
                ></span>

                <div>
                  <strong>Techniciens locaux</strong>
                  <span>
                    Des professionnels disponibles à Tanger.
                  </span>
                </div>

              </div>


              <div class="why-benefit">

                <span
                  class="benefit-icon"
                  set:html={icon("clock", 20)}
                ></span>

                <div>
                  <strong>Intervention rapide</strong>
                  <span>
                    Une prise en charge adaptée à votre situation.
                  </span>
                </div>

              </div>


              <div class="why-benefit">

                <span
                  class="benefit-icon"
                  set:html={icon("file-text", 20)}
                ></span>

                <div>
                  <strong>Prix transparents</strong>
                  <span>
                    Des informations claires avant l'intervention.
                  </span>
                </div>

              </div>

            </div>


            <a
              href={`/${lang}/contact`}
              class="btn btn-primary why-cta"
            >
              Demander un service
              <span set:html={icon("arrow-right", 18)}></span>
            </a>

          </div>

        </div>
      </div>
    </section>


    <!-- ============================================================
    HOW
    ============================================================ -->

    <section class="how-section" id="how">

      <div class="container">

        <div class="section-header">

          <span class="eyebrow">
            Comment ça marche
          </span>

          <h2 class="section-title">
            Trouver un plombier en quelques étapes
          </h2>

          <p class="section-desc">
            Un processus simple pour vous permettre de trouver rapidement
            le professionnel adapté.
          </p>

        </div>


        <div class="steps">

          <div class="step">

            <div class="step-number">
              01
            </div>

            <div
              class="step-icon"
              set:html={icon("file-text", 28)}
            ></div>

            <h3 class="step-title">
              Décrivez votre besoin
            </h3>

            <p class="step-desc">
              Expliquez simplement le problème ou le travail à réaliser.
            </p>

          </div>


          <div class="step-connector"></div>


          <div class="step">

            <div class="step-number">
              02
            </div>

            <div
              class="step-icon"
              set:html={icon("wrench", 28)}
            ></div>

            <h3 class="step-title">
              Choisissez un professionnel
            </h3>

            <p class="step-desc">
              Consultez les professionnels disponibles pour votre demande.
            </p>

          </div>


          <div class="step-connector"></div>


          <div class="step">

            <div class="step-number">
              03
            </div>

            <div
              class="step-icon"
              set:html={icon("clock", 28)}
            ></div>

            <h3 class="step-title">
              Planifiez l'intervention
            </h3>

            <p class="step-desc">
              Convenez directement des détails de l'intervention.
            </p>

          </div>

        </div>

      </div>
    </section>


    <!-- ============================================================
    CTA
    ============================================================ -->

    <section class="cta-section" id="cta">

      <div class="container">

        <div class="cta-box">

          <span class="cta-badge">
            Plomberie à Tanger
          </span>

          <h2 class="cta-title">
            Besoin d'un plombier ?
          </h2>

          <p class="cta-desc">
            Décrivez votre besoin et trouvez un professionnel adapté à Tanger.
          </p>


          <div class="cta-actions">

            <a
              href={`/${lang}/contact`}
              class="btn btn-primary btn-large"
            >
              Demander un service
              <span set:html={icon("arrow-right", 20)}></span>
            </a>

            <a
              href="#services"
              class="btn btn-secondary btn-large"
            >
              Voir nos services
              <span set:html={icon("arrow-down", 20)}></span>
            </a>

          </div>


          <div class="cta-footer">

            <span>
              <span
                set:html={icon("check-circle", 16, "footer-icon")}
              ></span>
              Techniciens locaux
            </span>

            <span>
              <span
                set:html={icon("check-circle", 16, "footer-icon")}
              ></span>
              Intervention à Tanger
            </span>

            <span>
              <span
                set:html={icon("check-circle", 16, "footer-icon")}
              ></span>
              Professionnels vérifiés
            </span>

          </div>

        </div>

      </div>
    </section>

  </main>

  <Footer lang={lang} />
</Layout>


<!-- ================================================================
STYLES
================================================================ -->

<style>

@import url("https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..800&display=swap");


/* ================================================================
ROOT
================================================================ */

:root {
  --color-primary: #2563eb;
  --color-primary-dark: #1d4ed8;
  --color-primary-light: #eff6ff;

  --color-navy: #0f172a;
  --color-text: #475569;
  --color-slate: #64748b;

  --color-bg: #f8fafc;
  --color-white: #ffffff;

  --radius-card: 22px;
  --radius-image: 28px;

  --shadow-card:
    0 4px 24px rgba(15, 23, 42, 0.06);

  --shadow-hover:
    0 12px 40px rgba(15, 23, 42, 0.10);

  --transition:
    0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);

  font-family:
    "Inter",
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}


/* ================================================================
GLOBAL SAFETY
================================================================ */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  overflow-x: hidden;
}

body {
  margin: 0;
  font-family: inherit;
  overflow-x: hidden;
}

img {
  max-width: 100%;
}

a {
  -webkit-tap-highlight-color: transparent;
}


/* ================================================================
CONTAINER
================================================================ */

.container {
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding-left: 28px;
  padding-right: 28px;
}


/* ================================================================
ANIMATION
================================================================ */

.fade-up {
  opacity: 0;
  transform: translateY(28px);
  transition:
    opacity 0.7s ease,
    transform 0.7s ease;
}

.fade-up.visible {
  opacity: 1;
  transform: translateY(0);
}


/* ================================================================
EYEBROW
================================================================ */

.eyebrow {
  display: inline-flex;
  align-items: center;

  width: fit-content;

  font-size: 13px;
  font-weight: 600;

  text-transform: uppercase;
  letter-spacing: 0.06em;

  color: var(--color-primary);
  background: var(--color-primary-light);

  padding: 5px 18px;

  border-radius: 40px;

  margin-bottom: 14px;
}


/* ================================================================
SECTION HEADER
================================================================ */

.section-header {
  width: 100%;
  max-width: 700px;

  text-align: center;

  margin:
    0 auto 52px;
}

.section-title {
  font-size: 40px;
  font-weight: 700;

  color: var(--color-navy);

  margin: 0 0 12px;

  line-height: 1.15;

  letter-spacing: -0.02em;
}

.section-desc {
  font-size: 17px;

  color: var(--color-text);

  margin: 0;

  line-height: 1.6;
}


/* ================================================================
BUTTONS
================================================================ */

.btn {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 8px;

  min-height: 48px;

  padding: 14px 32px;

  border-radius: 60px;

  font-family: inherit;

  font-size: 16px;
  font-weight: 600;

  line-height: 1.2;

  text-decoration: none;

  cursor: pointer;

  border: 0;

  transition:
    background var(--transition),
    color var(--transition),
    border-color var(--transition),
    transform var(--transition),
    box-shadow var(--transition);

  -webkit-tap-highlight-color: transparent;

  touch-action: manipulation;
}

.btn:active {
  transform: scale(0.97);
}


/* PRIMARY */

.btn-primary {
  background: var(--color-primary);
  color: var(--color-white);

  box-shadow:
    0 4px 20px rgba(37, 99, 235, 0.30);
}

.btn-primary:hover {
  background: var(--color-primary-dark);

  transform: translateY(-3px);

  box-shadow:
    0 8px 32px rgba(37, 99, 235, 0.40);
}

.btn-primary svg {
  transition:
    transform 0.25s ease;
}

.btn-primary:hover svg {
  transform: translateX(4px);
}


/* SECONDARY */

.btn-secondary {
  background: transparent;

  color: var(--color-navy);

  border:
    2px solid rgba(15, 23, 42, 0.15);
}

.btn-secondary:hover {
  background:
    rgba(15, 23, 42, 0.04);

  border-color:
    var(--color-navy);

  transform:
    translateY(-3px);
}


/* LARGE */

.btn-large {
  min-height: 54px;

  padding: 17px 38px;

  font-size: 17px;
}


/* ================================================================
HERO
================================================================ */

.plumbing-hero {
  position: relative;

  overflow: hidden;

  padding:
    70px 0 90px;

  background:
    var(--color-bg);

  margin-top:
    var(--header-h, 76px);
}

.plumbing-hero::before {
  content: "";

  position: absolute;

  top: -40%;
  right: -10%;

  width: 600px;
  height: 600px;

  background:
    radial-gradient(
      circle,
      rgba(37, 99, 235, 0.06),
      transparent 70%
    );

  border-radius: 50%;

  pointer-events: none;
}

.plumbing-hero::after {
  content: "";

  position: absolute;

  bottom: -20%;
  left: -10%;

  width: 400px;
  height: 400px;

  background:
    radial-gradient(
      circle,
      rgba(37, 99, 235, 0.04),
      transparent 70%
    );

  border-radius: 50%;

  pointer-events: none;
}


/* ================================================================
HERO GRID
================================================================ */

.hero-grid {
  position: relative;

  z-index: 1;

  display: grid;

  grid-template-columns:
    minmax(0, 0.9fr)
    minmax(0, 1.1fr);

  align-items: center;

  gap: 60px;
}


/* ================================================================
HERO CONTENT
================================================================ */

.hero-content {
  display: flex;

  flex-direction: column;

  align-items: flex-start;

  gap: 20px;

  min-width: 0;
}

.hero-badge {
  display: inline-flex;

  align-items: center;

  gap: 8px;

  width: fit-content;

  max-width: 100%;

  background:
    var(--color-primary-light);

  color:
    var(--color-primary);

  padding:
    7px 18px 7px 14px;

  border-radius:
    40px;

  font-size:
    13px;

  font-weight:
    600;

  text-transform:
    uppercase;

  letter-spacing:
    0.04em;
}

.badge-icon {
  stroke-width: 2.5;
}


.hero-title {
  max-width: 720px;

  margin: 0;

  font-size: clamp(38px, 4.2vw, 56px);

  font-weight: 800;

  line-height: 1.08;

  letter-spacing: -0.035em;

  color:
    var(--color-navy);
}

.highlight {
  position: relative;

  color:
    var(--color-primary);

  z-index: 1;
}

.highlight::after {
  content: "";

  position: absolute;

  left: 0;
  right: 0;

  bottom: 5px;

  height: 7px;

  background:
    var(--color-primary-light);

  border-radius:
    4px;

  z-index: -1;
}


.hero-desc {
  max-width: 520px;

  margin: 0;

  font-size: 17px;

  line-height: 1.7;

  color:
    var(--color-text);
}


/* ================================================================
HERO ACTIONS
================================================================ */

.hero-actions {
  display: flex;

  flex-wrap: wrap;

  align-items: center;

  gap: 14px;

  margin-top: 2px;
}


/* ================================================================
TRUST
================================================================ */

.trust-indicators {
  display: flex;

  flex-wrap: wrap;

  gap: 12px 22px;

  margin-top: 5px;
}

.trust-item {
  display: inline-flex;

  align-items: center;

  gap: 7px;

  font-size: 13px;

  font-weight: 500;

  color:
    var(--color-navy);
}

.trust-icon {
  flex-shrink: 0;

  color:
    var(--color-primary);

  stroke-width:
    2.5;
}


/* ================================================================
HERO VISUAL
================================================================ */

.hero-visuals {
  position: relative;

  width: 100%;

  height: 560px;

  min-width: 0;
}

.visual-main {
  position: absolute;

  top: 9%;
  left: 14%;

  width: 72%;
  height: 82%;

  overflow: hidden;

  border-radius:
    var(--radius-image);

  background:
    var(--color-white);

  box-shadow:
    0 24px 64px rgba(15, 23, 42, 0.12);

  z-index: 2;

  transition:
    transform 0.5s ease;
}

.visual-main:hover {
  transform:
    scale(1.01);
}

.visual-main img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
}


/* ================================================================
SUPPORT IMAGES
================================================================ */

.visual-support {
  position: absolute;

  overflow: hidden;

  background:
    var(--color-white);

  border:
    3px solid var(--color-white);

  border-radius:
    18px;

  box-shadow:
    0 8px 32px rgba(15, 23, 42, 0.10);

  z-index: 4;

  transition:
    transform var(--transition),
    box-shadow var(--transition);
}

.visual-support:hover {
  transform:
    scale(1.05)
    translateY(-4px);

  box-shadow:
    0 16px 48px rgba(15, 23, 42, 0.15);

  z-index: 5;
}

.visual-support img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
}

.support-1 {
  top: 0;
  right: 0;

  width: 32%;
  height: 28%;
}

.support-2 {
  bottom: 0;
  left: 0;

  width: 32%;
  height: 28%;
}

.support-label {
  position: absolute;

  left: 50%;
  bottom: 8px;

  transform:
    translateX(-50%);

  white-space:
    nowrap;

  color:
    var(--color-white);

  background:
    rgba(15, 23, 42, 0.72);

  backdrop-filter:
    blur(5px);

  padding:
    4px 12px;

  border-radius:
    40px;

  font-size:
    11px;

  font-weight:
    600;
}


/* ================================================================
FLOATING CARD
================================================================ */

.floating-card {
  position: absolute;

  right: 2%;
  bottom: 10%;

  z-index: 6;

  display: flex;

  align-items: center;

  gap: 12px;

  padding:
    14px 22px 14px 16px;

  background:
    rgba(255, 255, 255, 0.94);

  border:
    1px solid rgba(15, 23, 42, 0.05);

  border-radius:
    16px;

  box-shadow:
    0 12px 40px rgba(15, 23, 42, 0.12);

  backdrop-filter:
    blur(10px);

  animation:
    float 4s ease-in-out infinite;
}

@keyframes float {

  0%,
  100% {
    transform:
      translateY(0);
  }

  50% {
    transform:
      translateY(-8px);
  }
}

.float-icon {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 36px;
  height: 36px;

  flex-shrink: 0;

  color:
    var(--color-primary);

  background:
    var(--color-primary-light);

  border-radius:
    50%;
}

.float-title {
  display: block;

  color:
    var(--color-navy);

  font-size:
    14px;

  font-weight:
    700;
}

.float-sub {
  display: block;

  margin-top: 2px;

  color:
    var(--color-text);

  font-size:
    12px;
}


/* ================================================================
SERVICE TAGS
================================================================ */

.service-tags {
  position: absolute;

  left: 50%;
  bottom: 0;

  z-index: 7;

  display: flex;

  justify-content: center;

  flex-wrap: wrap;

  gap: 8px;

  width: max-content;

  max-width: 95%;

  transform:
    translateX(-50%);
}

.tag {
  padding:
    6px 16px;

  background:
    var(--color-white);

  border:
    1px solid rgba(15, 23, 42, 0.08);

  border-radius:
    40px;

  color:
    var(--color-navy);

  box-shadow:
    0 4px 12px rgba(15, 23, 42, 0.04);

  font-size:
    12px;

  font-weight:
    600;

  white-space:
    nowrap;

  transition:
    all var(--transition);
}

.tag:hover {
  color:
    var(--color-white);

  background:
    var(--color-primary);

  border-color:
    var(--color-primary);

  transform:
    translateY(-2px);
}


/* ================================================================
SERVICES
================================================================ */

.services-section {
  padding:
    100px 0;

  background:
    var(--color-white);
}

.services-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 24px;
}

.service-card {
  display: flex;

  flex-direction: column;

  min-width: 0;

  padding:
    30px 28px 28px;

  background:
    var(--color-white);

  border:
    1px solid rgba(15, 23, 42, 0.05);

  border-radius:
    var(--radius-card);

  box-shadow:
    var(--shadow-card);

  transition:
    transform var(--transition),
    box-shadow var(--transition),
    border-color var(--transition);
}

.service-card:hover {
  transform:
    translateY(-5px);

  border-color:
    rgba(37, 99, 235, 0.30);

  box-shadow:
    var(--shadow-hover);
}

.service-icon {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 56px;
  height: 56px;

  margin-bottom: 17px;

  color:
    var(--color-primary);

  background:
    var(--color-primary-light);

  border-radius:
    14px;

  transition:
    all var(--transition);
}

.service-card:hover .service-icon {
  color:
    var(--color-white);

  background:
    var(--color-primary);
}

.service-title {
  margin:
    0 0 8px;

  color:
    var(--color-navy);

  font-size:
    19px;

  font-weight:
    700;

  line-height:
    1.3;
}

.service-desc {
  flex: 1;

  margin:
    0 0 20px;

  color:
    var(--color-text);

  font-size:
    14px;

  line-height:
    1.65;
}

.service-link {
  display: inline-flex;

  align-items: center;

  gap: 6px;

  width: fit-content;

  color:
    var(--color-primary);

  font-size:
    14px;

  font-weight:
    600;

  text-decoration:
    none;

  transition:
    gap 0.25s ease;
}

.service-link:hover {
  gap: 11px;
}


/* ================================================================
WHY
================================================================ */

.why-section {
  padding:
    100px 0;

  background:
    var(--color-primary-light);
}

.why-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  align-items: center;

  gap: 60px;
}

.why-image-wrapper {
  min-width: 0;
}

.why-image-container {
  position: relative;

  overflow: hidden;

  border-radius:
    var(--radius-image);

  box-shadow:
    0 12px 48px rgba(15, 23, 42, 0.08);
}

.why-image-container img {
  display: block;

  width: 100%;
  height: 420px;

  object-fit: cover;

  transition:
    transform 0.6s ease;
}

.why-image-container:hover img {
  transform:
    scale(1.02);
}

.why-badge {
  position: absolute;

  left: 24px;
  bottom: 24px;

  display: inline-flex;

  align-items: center;

  gap: 8px;

  padding:
    10px 20px;

  background:
    var(--color-white);

  border-radius:
    40px;

  box-shadow:
    0 4px 20px rgba(0, 0, 0, 0.08);

  color:
    var(--color-navy);

  font-size:
    14px;

  font-weight:
    600;
}

.why-content {
  display: flex;

  flex-direction: column;

  min-width: 0;
}

.why-title {
  margin:
    0 0 16px;

  color:
    var(--color-navy);

  font-size:
    38px;

  font-weight:
    700;

  line-height:
    1.15;

  letter-spacing:
    -0.025em;
}

.why-desc {
  margin:
    0 0 28px;

  color:
    var(--color-text);

  font-size:
    17px;

  line-height:
    1.7;
}

.why-benefits {
  display: flex;

  flex-direction: column;

  gap: 16px;

  margin-bottom:
    32px;
}

.why-benefit {
  display: flex;

  align-items: flex-start;

  gap: 14px;
}

.benefit-icon {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 32px;
  height: 32px;

  flex-shrink: 0;

  margin-top: 2px;

  color:
    var(--color-primary);

  background:
    var(--color-white);

  border-radius:
    50%;
}

.why-benefit div {
  display: flex;

  flex-direction: column;

  gap: 3px;
}

.why-benefit strong {
  color:
    var(--color-navy);

  font-size:
    15px;

  font-weight:
    600;
}

.why-benefit div span {
  color:
    var(--color-text);

  font-size:
    14px;

  line-height:
    1.5;
}

.why-cta {
  align-self:
    flex-start;
}


/* ================================================================
HOW
================================================================ */

.how-section {
  padding:
    100px 0;

  background:
    var(--color-white);
}

.steps {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    auto
    minmax(0, 1fr)
    auto
    minmax(0, 1fr);

  align-items: start;

  gap: 8px;

  max-width:
    960px;

  margin:
    0 auto;
}

.step {
  min-width: 0;

  padding:
    0 12px;

  text-align:
    center;
}

.step-number {
  margin-bottom:
    8px;

  color:
    rgba(37, 99, 235, 0.12);

  font-size:
    52px;

  font-weight:
    800;

  line-height:
    1;

  letter-spacing:
    -0.04em;
}

.step-icon {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  width: 56px;
  height: 56px;

  margin-bottom:
    14px;

  color:
    var(--color-primary);

  background:
    var(--color-primary-light);

  border-radius:
    14px;
}

.step-title {
  margin:
    0 0 8px;

  color:
    var(--color-navy);

  font-size:
    19px;

  font-weight:
    700;

  line-height:
    1.3;
}

.step-desc {
  margin:
    0;

  color:
    var(--color-text);

  font-size:
    14px;

  line-height:
    1.6;
}

.step-connector {
  width:
    40px;

  height:
    2px;

  margin-top:
    44px;

  flex-shrink:
    0;

  background:
    var(--color-primary);

  opacity:
    0.25;
}


/* ================================================================
CTA
================================================================ */

.cta-section {
  position: relative;

  overflow: hidden;

  padding:
    80px 0;

  background:
    var(--color-white);
}

.cta-section::before {
  content: "";

  position: absolute;

  inset: 0;

  background:
    radial-gradient(
      ellipse at 50% 0%,
      rgba(37, 99, 235, 0.15),
      transparent 70%
    );

  pointer-events:
    none;
}

.cta-box {
  position: relative;

  z-index: 1;

  max-width:
    760px;

  margin:
    0 auto;

  text-align:
    center;
}

.cta-badge {
  display: inline-flex;

  padding:
    5px 18px;

  margin-bottom:
    16px;

  color:
    #044bc5;

  background:
    rgba(37, 99, 235, 0.10);

  border-radius:
    40px;

  font-size:
    13px;

  font-weight:
    600;

  text-transform:
    uppercase;

  letter-spacing:
    0.06em;
}

.cta-title {
  margin:
    0 0 12px;

  color:
    var(--color-navy);

  font-size:
    42px;

  font-weight:
    700;

  line-height:
    1.15;

  letter-spacing:
    -0.025em;
}

.cta-desc {
  margin:
    0 0 32px;

  color:
    var(--color-text);

  font-size:
    18px;

  line-height:
    1.7;
}

.cta-actions {
  display: flex;

  align-items: center;
  justify-content: center;

  flex-wrap: wrap;

  gap: 14px;

  margin-bottom:
    34px;
}

.cta-footer {
  display: flex;

  justify-content: center;

  flex-wrap: wrap;

  gap: 20px 30px;

  color:
    var(--color-text);

  font-size:
    13px;

  opacity:
    0.75;
}

.cta-footer span {
  display: inline-flex;

  align-items: center;

  gap: 6px;
}

.footer-icon {
  color:
    var(--color-primary);

  stroke-width:
    2.5;
}


/* ================================================================
LARGE TABLET / SMALL DESKTOP
================================================================ */

@media (max-width: 1200px) {

  .container {
    padding-left: 24px;
    padding-right: 24px;
  }

  .hero-grid {
    gap: 40px;
  }

  .hero-title {
    font-size:
      clamp(38px, 4vw, 48px);
  }

  .hero-visuals {
    height:
      500px;
  }

  .why-grid {
    gap: 40px;
  }

}


/* ================================================================
TABLET
================================================================ */

@media (max-width: 1024px) {

  .container {
    padding-left: 22px;
    padding-right: 22px;
  }

  .plumbing-hero {
    padding:
      65px 0 75px;
  }

  .hero-grid {
    grid-template-columns:
      1fr;

    gap:
      50px;
  }

  .hero-content {
    align-items:
      center;

    text-align:
      center;
  }

  .hero-title {
    max-width:
      760px;

    font-size:
      clamp(38px, 6vw, 52px);
  }

  .hero-desc {
    max-width:
      700px;
  }

  .hero-actions {
    justify-content:
      center;
  }

  .trust-indicators {
    justify-content:
      center;
  }

  .hero-visuals {
    width:
      min(100%, 680px);

    height:
      500px;

    margin:
      0 auto;
  }


  .services-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }


  .why-grid {
    grid-template-columns:
      1fr;

    gap:
      42px;
  }

  .why-image-container {
    max-width:
      700px;

    margin:
      0 auto;
  }

  .why-image-container img {
    height:
      380px;
  }

  .why-content {
    max-width:
      700px;

    margin:
      0 auto;

    align-items:
      center;

    text-align:
      center;
  }

  .why-benefits {
    width:
      100%;

    max-width:
      600px;

    text-align:
      left;
  }

  .why-cta {
    align-self:
      center;
  }


  .steps {
    grid-template-columns:
      1fr;

    gap:
      38px;

    max-width:
      650px;
  }

  .step-connector {
    display:
      none;
  }

  .step {
    padding:
      0;
  }


  .cta-title {
    font-size:
      36px;
  }

}


/* ================================================================
TABLET PORTRAIT / MOBILE
================================================================ */

@media (max-width: 768px) {

  .container {
    padding-left:
      18px;

    padding-right:
      18px;
  }


  /* HERO */

  .plumbing-hero {
    padding:
      50px 0 60px;

    margin-top:
      var(--header-h, 70px);
  }

  .hero-grid {
    gap:
      38px;
  }

  .hero-content {
    gap:
      17px;
  }

  .hero-badge {
    font-size:
      11px;

    padding:
      6px 14px 6px 12px;
  }

  .hero-title {
    font-size:
      clamp(32px, 8vw, 42px);

    line-height:
      1.1;

    letter-spacing:
      -0.03em;
  }

  .hero-desc {
    font-size:
      15px;

    line-height:
      1.65;
  }


  /* BUTTONS */

  .hero-actions,
  .cta-actions {
    width:
      100%;

    flex-direction:
      column;

    align-items:
      stretch;

    gap:
      10px;
  }

  .hero-actions .btn,
  .cta-actions .btn,
  .why-cta {
    width:
      100%;

    max-width:
      380px;

    min-height:
      50px;

    margin-left:
      auto;

    margin-right:
      auto;

    padding:
      15px 22px;

    font-size:
      15px;
  }


  /* TRUST */

  .trust-indicators {
    flex-direction:
      column;

    align-items:
      center;

    gap:
      9px;
  }


  /* HERO IMAGES */

  .hero-visuals {
    height:
      410px;

    max-width:
      600px;
  }

  .visual-main {
    width:
      80%;

    height:
      76%;

    top:
      12%;

    left:
      10%;
  }

  .support-1,
  .support-2 {
    width:
      34%;

    height:
      25%;
  }

  .support-label {
    bottom:
      5px;

    padding:
      3px 9px;

    font-size:
      9px;
  }

  .floating-card {
    right:
      0;

    bottom:
      6%;

    padding:
      11px 14px 11px 12px;
  }

  .float-icon {
    width:
      32px;

    height:
      32px;
  }

  .float-title {
    font-size:
      12px;
  }

  .float-sub {
    font-size:
      10px;
  }

  .service-tags {
    bottom:
      -2px;

    gap:
      5px;

    max-width:
      92%;
  }

  .tag {
    padding:
      4px 11px;

    font-size:
      10px;
  }


  /* SECTIONS */

  .services-section,
