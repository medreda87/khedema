---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro"
import RequestForm from "../components/RequestForm.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import CallButton from "../components/CallButton.astro";
import MobileActionBar from "../components/MobileActionBar.astro";
import { getLangFromUrl, DIRS } from "../lib/i18n";
const lang = getLangFromUrl(Astro.url);
---
<!doctype html>
<html lang={lang} dir={DIRS[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>AlloMealem — Trouvez le bon technicien</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <Hero lang={lang} />
      <Services/>
      <RequestForm lang={lang} />
    </main>
    <Footer lang={lang} />

    <CallButton lang={lang} phone="+212716885441" variant="floating" />
    <WhatsAppButton lang={lang} phone="+212716885441" variant="floating" />
    <MobileActionBar lang={lang} phone="+212716885441" whatsapp="+212716885441" />
  </body>
</html>